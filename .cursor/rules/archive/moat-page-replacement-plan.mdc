## 📋 MOAT DATA STRUCTURE

### Based on Co-Pilot Structure but MOAT-Focused:

```typescript
interface MOATDetailContent {
  slug: string;
  pageTitle: string;
  heroSubtitle: string;
  vision: string;
  
  // MOAT-Specific Fields
  moatType: 'validated' | 'complete' | 'in-progress';
  validatedMetric: string;  // e.g., "17/17 patients", "469 TCGA patients"
  validatedDate?: string;
  
  // Core Content (same as co-pilots)
  valueProps: ValuePropositionSection[];
  kpis: KPI[];
  observedOutcomes: ObservedOutcome[];
  
  // Technical Details
  keyCapabilities: KeyCapability[];
  
  // Product Integration (NEW - from co-pilot-product-integration-plan.mdc)
  productIntegration?: {
    engines: {
      oracle?: { apis: string[], capabilities: string[] };
      forge?: { apis: string[], capabilities: string[] };
      boltz?: { apis: string[], capabilities: string[] };
      commandCenter?: { capabilities: string[] };
    };
    workflow: Array<{
      step: number;
      title: string;
      engine: "oracle" | "forge" | "boltz" | "commandCenter";
      api?: string;
      description: string;
    }>;
  };
  
  // Source Material
  sourceFiles: string[];  // Links to MOAT doctrine files
}
```

