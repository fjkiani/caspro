### LLM Integration

```typescript
// lib/docs/ai/llm-client.ts

interface LLMClient {
  // Generate response with context
  generate(params: GenerateParams): Promise<GenerateResponse>;
  
  // Stream response for real-time chat
  stream(params: GenerateParams): AsyncGenerator<string>;
  
  // Generate embeddings for search
  embed(texts: string[]): Promise<number[][]>;
}

interface GenerateParams {
  query: string;
  context: string[];        // Retrieved documents
  pageContext?: string;     // Current page user is on
  conversationHistory?: Message[];
  systemPrompt?: string;
  maxTokens?: number;
}

// System prompt for docs assistant
const DOCS_SYSTEM_PROMPT = `
You are CrisPRO.ai's intelligent documentation assistant. You help users understand
our AI-powered therapeutic development platform.

Key responsibilities:
1. Answer questions about Oracle (discriminative AI), Forge (generative AI), 
