## 🔧 HYGRAPH CMS SCHEMA

### Content Models

```graphql
# Hygraph Schema Definition

type DocCategory {
  id: ID!
  title: String!
  slug: String!
  description: RichText
  icon: String
  order: Int
  articles: [DocArticle!]! @relation
  parentCategory: DocCategory @relation
  childCategories: [DocCategory!]! @relation
}

type DocArticle {
  id: ID!
  title: String!
  slug: String!
  excerpt: String
  content: RichText!
  category: DocCategory! @relation
  tags: [String!]
  relatedArticles: [DocArticle!]! @relation
  apiEndpoints: [APIEndpoint!]! @relation
  codeExamples: [CodeExample!]!
  lastUpdated: DateTime!
  author: Author @relation
  seoMetadata: SEOMetadata
  difficulty: Difficulty
  estimatedReadTime: Int
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

type APIEndpoint {
  id: ID!
  name: String!
  path: String!
  method: HTTPMethod!
  description: RichText!
  category: APICategory!
  parameters: [APIParameter!]!
  requestBody: Json
  responseSchema: Json
  codeExamples: [CodeExample!]!
  relatedEndpoints: [APIEndpoint!]! @relation
  useCases: [UseCase!]! @relation
  performanceMetrics: PerformanceMetrics
}

enum HTTPMethod {
  GET
  POST
  PUT
  PATCH
  DELETE
}

enum APICategory {
  ORACLE_DISCRIMINATIVE
  FORGE_GENERATIVE
  BOLTZ_STRUCTURAL
  COMMAND_CENTER
}

type APIParameter {
  name: String!
  type: String!
  required: Boolean!
  description: String!
  defaultValue: String
  example: String
  constraints: [String!]
}

type CodeExample {
  id: ID!
  title: String!
  language: ProgrammingLanguage!
  code: String!
  description: String
  runnable: Boolean
  expectedOutput: String
}

enum ProgrammingLanguage {
  PYTHON
  JAVASCRIPT
  TYPESCRIPT
  CURL
  GO
  JAVA
  RUBY
}

type UseCase {
  id: ID!
  title: String!
  slug: String!
  description: RichText!
  industry: Industry
  difficulty: Difficulty!
  estimatedTime: String
  steps: [UseCaseStep!]!
  outcomes: [String!]!
  relatedAPIs: [APIEndpoint!]! @relation
  prerequisites: [String!]
  thumbnail: Asset
}

enum Industry {
  BIOTECH
  CLINICAL
  RESEARCH
  PHARMA
}

type UseCaseStep {
  order: Int!
  title: String!
  description: RichText!
  codeExample: CodeExample
  tips: [String!]
  apiEndpoint: APIEndpoint @relation
}

type FAQ {
  id: ID!
  question: String!
  answer: RichText!
  category: String
  relatedArticles: [DocArticle!]! @relation
  helpful: Int
  notHelpful: Int
}

type KnowledgeEntry {
  id: ID!
  concept: String!
  definition: RichText!
  relatedConcepts: [KnowledgeEntry!]! @relation
  examples: [String!]
  category: String
  embeddings: Json  # For vector search
}

type PerformanceMetrics {
  auroc: Float
  samples: Int
  benchmark: String
  source: String
}

type SEOMetadata {
  metaTitle: String
  metaDescription: String
  keywords: [String!]
  canonicalUrl: String
}

type Author {
  id: ID!
  name: String!
  avatar: Asset
  bio: String
}
```

