## 🧩 COMPONENT ARCHITECTURE

### New Component: `OncologyCapabilityDossiers.tsx`

**Purpose**: Main orchestration component for capability cards and dossier expansion

**Structure**:
```typescript
interface OncologyCapabilityDossiersProps {
  className?: string;
}

interface CapabilityCard {
  id: string;
  title: string;
  subtitle: string;
  description: string;
  icon: React.ComponentType;
  color: string; // Tailwind gradient
  badge: string;
  metrics: string;
  time: string;
  businessImpact: string;
  apis: string[];
  component: React.ComponentType<any>;
  seedData: any;
}

const ONCOLOGY_CAPABILITIES: CapabilityCard[] = [
  // 5 capabilities defined above
];

export default function OncologyCapabilityDossiers() {
  const [activeCapability, setActiveCapability] = useState<string | null>(null);
  const [demoStarted, setDemoStarted] = useState(false);

  return (
    <section>
      {/* Capability Cards Grid */}
      <div className="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-5 gap-4">
        {ONCOLOGY_CAPABILITIES.map((cap) => (
          <CapabilityCard
            key={cap.id}
            capability={cap}
            isActive={activeCapability === cap.id}
            onClick={() => setActiveCapability(cap.id)}
          />
        ))}
      </div>

      {/* Expanded Dossier (only show when capability selected) */}
      {activeCapability && (
        <CapabilityDossier
          capability={ONCOLOGY_CAPABILITIES.find(c => c.id === activeCapability)}
          onStartDemo={() => setDemoStarted(true)}
          demoStarted={demoStarted}
        />
      )}
    </section>
  );
}
```

### Component: `CapabilityCard.tsx`

**Purpose**: Individual capability card (clickable)

**Features**:
- Hover effects
- Active state styling
- Icon, title, subtitle, metrics preview
- Badge indicator

### Component: `CapabilityDossier.tsx`

**Purpose**: Expanded dossier view (matches homepage pattern)

**Features**:
- Gradient header with icon, title, subtitle, badge
- Performance metrics + API pipeline display
- Interactive demo component rendering
- SAE features visualization
- "Start Demo" button → triggers animation

