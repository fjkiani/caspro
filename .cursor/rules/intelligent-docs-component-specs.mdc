## 🤖 AI/RAG IMPLEMENTATION

### Vector Database Setup (Supabase pgvector)
```sql
-- Create extensions and tables
CREATE EXTENSION IF NOT EXISTS vector;

CREATE TABLE docs_embeddings (
  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  content_id TEXT NOT NULL,
  content_type TEXT NOT NULL, -- 'article', 'api', 'faq', 'concept'
  chunk_text TEXT NOT NULL,
  chunk_index INT NOT NULL,
  embedding vector(1536), -- OpenAI ada-002 dimension
  metadata JSONB,
  created_at TIMESTAMP DEFAULT NOW(),
  UNIQUE(content_id, chunk_index)
);

CREATE INDEX ON docs_embeddings USING ivfflat (embedding vector_cosine_ops);
```

### RAG Engine Implementation
```typescript
// src/lib/docs/ai/rag-engine.ts

import { createClient } from '@supabase/supabase-js';
import OpenAI from 'openai';

const supabase = createClient(
  process.env.SUPABASE_URL!,
  process.env.SUPABASE_KEY!
);

const openai = new OpenAI();

export class RAGEngine {
  // Generate embeddings for text
  async embed(text: string): Promise<number[]> {
    const response = await openai.embeddings.create({
      model: 'text-embedding-ada-002',
      input: text,
    });
    return response.data[0].embedding;
  }
  
  // Search for relevant documents
  async search(query: string, limit = 5): Promise<SearchResult[]> {
    const queryEmbedding = await this.embed(query);
    
    const { data, error } = await supabase.rpc('match_documents', {
      query_embedding: queryEmbedding,
      match_threshold: 0.7,
      match_count: limit,
    });
    
    if (error) throw error;
    return data;
  }
  
  // Generate answer with context
  async generateAnswer(
    query: string,
    context: SearchResult[],
    pageContext?: PageContext
  ): Promise<RAGResponse> {
    const contextText = context
      .map(r => `[${r.content_type}] ${r.chunk_text}`)
      .join('\n\n');
    
    const systemPrompt = `
      You are CrisPRO.ai's documentation assistant.
      
      Context from our docs:
      ${contextText}
      
      ${pageContext ? `User is currently viewing: ${pageContext.title}` : ''}
      
      Answer the user's question based on the context above.
      Always cite sources. If unsure, say so.
    `;
    
    const response = await openai.chat.completions.create({
      model: 'gpt-4-turbo-preview',
      messages: [
        { role: 'system', content: systemPrompt },
        { role: 'user', content: query },
      ],
      temperature: 0.7,
      max_tokens: 1000,
    });
    
    return {
      answer: response.choices[0].message.content!,
      sources: context.map(r => ({
        title: r.metadata.title,
        url: r.metadata.url,
        excerpt: r.chunk_text.slice(0, 200),
        relevance: r.similarity,
      })),
      confidence: this.calculateConfidence(context),
    };
  }
  
  private calculateConfidence(results: SearchResult[]): number {
    if (results.length === 0) return 0;
    const avgSimilarity = results.reduce((a, b) => a + b.similarity, 0) / results.length;
    return Math.round(avgSimilarity * 100);
  }
}
```

### Content Indexing Pipeline
```typescript
// src/lib/docs/ai/index-manager.ts

export class IndexManager {
  private rag: RAGEngine;
  
  constructor() {
    this.rag = new RAGEngine();
  }
  
  // Index all Hygraph content
  async indexAllContent(): Promise<void> {
    // Fetch all articles
    const articles = await hygraphClient.request(GET_ALL_ARTICLES);
    for (const article of articles.docArticles) {
      await this.indexArticle(article);
    }
    
    // Fetch all API endpoints
    const endpoints = await hygraphClient.request(GET_ALL_ENDPOINTS);
    for (const endpoint of endpoints.apiEndpoints) {
      await this.indexEndpoint(endpoint);
    }
    
    // Fetch all FAQs
    const faqs = await hygraphClient.request(GET_ALL_FAQS);
    for (const faq of faqs.faqs) {
      await this.indexFAQ(faq);
    }
  }
  
  // Index a single article (chunk and embed)
  async indexArticle(article: DocArticle): Promise<void> {
    const chunks = this.chunkContent(article.content.text, 500);
    
    for (let i = 0; i < chunks.length; i++) {
      const embedding = await this.rag.embed(chunks[i]);
      
      await supabase.from('docs_embeddings').upsert({
        content_id: article.id,
        content_type: 'article',
        chunk_text: chunks[i],
        chunk_index: i,
        embedding,
        metadata: {
          title: article.title,
          url: `/docs/${article.category.slug}/${article.slug}`,
          category: article.category.title,
        },
      });
    }
  }
  
  // Smart chunking that respects semantic boundaries
  private chunkContent(text: string, maxChunkSize: number): string[] {
    // Split by paragraphs first, then merge to max size
    const paragraphs = text.split('\n\n');
    const chunks: string[] = [];
    let currentChunk = '';
    
    for (const para of paragraphs) {
      if ((currentChunk + para).length > maxChunkSize && currentChunk) {
        chunks.push(currentChunk.trim());
        currentChunk = para;
      } else {
        currentChunk += (currentChunk ? '\n\n' : '') + para;
      }
    }
    
    if (currentChunk) {
      chunks.push(currentChunk.trim());
    }
    
    return chunks;
  }
}
```

