## 🔧 TECHNICAL DETAILS

### MDC Parser Structure
```typescript
// lib/docs/parser/MDCParser.ts

interface ParsedMDC {
  frontmatter: {
    title: string;
    type: 'endpoint' | 'use-case' | 'knowledge';
    category?: string;
    tags?: string[];
  };
  content: string;  // Markdown content
  sections: {
    [key: string]: string;  // Extracted sections
  };
}

class MDCParser {
  parse(filePath: string): ParsedMDC;
  extractFrontmatter(content: string): Record<string, any>;
  extractSections(content: string): Record<string, string>;
}
```

### Endpoint Parser
```typescript
// lib/docs/parser/EndpointParser.ts

class EndpointParser {
  parseEndpoints(mdcContent: string): APIEndpoint[] {
    // Extract from endpoints.mdc structure:
    // - Discriminative AI Endpoints section
    // - Generative AI Endpoints section
    // - Parse each endpoint's description, inputs, outputs, etc.
  }
}
```

### Component Adapter Pattern
```typescript
// components/docs/adapters/APIExplorerAdapter.tsx

interface APIExplorerAdapterProps {
  endpoint: APIEndpoint;  // From parser
}

export function APIExplorerAdapter({ endpoint }: APIExplorerAdapterProps) {
  // Transform APIEndpoint → DetailedAPIExplorer props
  const explorerProps = {
    endpoint: endpoint.path,
    method: endpoint.method,
    description: endpoint.description,
    parameters: endpoint.parameters,
    examples: endpoint.codeExamples,
  };
  
  return <DetailedAPIExplorer {...explorerProps} />;
}
```

### Dynamic Route Pattern
```typescript
// app/docs/api/[endpoint]/page.tsx

export default async function APIEndpointPage({ params }: { params: { endpoint: string } }) {
  // Load endpoints.mdc
  const endpoints = await parseEndpointsFromMDC();
  const endpoint = endpoints.find(e => e.slug === params.endpoint);
  
  if (!endpoint) return <NotFound />;
  
  return (
    <DocsLayout>
      <APIEndpointPage endpoint={endpoint} />
    </DocsLayout>
  );
}
```

