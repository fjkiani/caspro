## 📊 DATA STRUCTURE DETAILS

### Full Scenario Type Definition

```typescript
interface ComparisonScenario {
  id: string;
  title: string;
  description: string;
  useCase: 'patient' | 'biotech' | 'clinical' | 'research';
  patientProfile?: {
    name?: string;
    condition?: string;
    genotype?: string;
    mutations?: string[];
  };
  questions: ScenarioQuestion[];
  metadata: {
    difficulty: 'basic' | 'intermediate' | 'advanced';
    estimatedTime: string;
    relevantProducts: string[]; // ['oncology', 'r-d']
  };
}

interface ScenarioQuestion {
  id: string;
  category: 'toxicity' | 'synthetic-lethality' | 'immunotherapy' | 'timing' | 'target-validation' | 'vus-resolution';
  question: string;
  context?: string; // Additional context for the question
  responses: {
    gpt: ComparisonResponse;
    crispro: ComparisonResponse;
    [competitorId: string]: ComparisonResponse; // Dynamic competitor responses
  };
  moatPoint: {
    title: string;
    explanation: string;
    evidence?: string; // Link to evidence/metric
  };
}

interface ComparisonResponse {
  text: string;
  capability: 'full' | 'partial' | 'none';
  limitations: string[];
  icon: 'check' | 'warning' | 'x';
}
```

