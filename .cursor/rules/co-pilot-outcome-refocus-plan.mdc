### **Phase 1: Create Outcome-Focused Co-Pilot Template**

**File:** `src/components/co-pilot-detail/OutcomeFocusedCoPilotPage.tsx`

**Structure:**
```typescript
interface OutcomeFocusedCoPilotPageProps {
  content: CoPilotDetailContent;
}

export default function OutcomeFocusedCoPilotPage({ content }: Props) {
  const hasJourney = Object.keys(allCapabilityJourneys).includes(content.slug);
  
  return (
    <>
      {/* Hero - Outcome-focused */}
      <ProductHeroSection content={transformToHeroContent(content)} />
      
      {/* Problem - What problem does this solve? */}
      <ProblemSolutionSection content={transformToProblemContent(content)} />
      
      {/* Solution - How does this solve it? */}
      <ProblemSolutionSection content={transformToSolutionContent(content)} />
      
      {/* Outcomes - Key results (PROMINENT, not buried) */}
      <SimplifiedOutcomesSection outcomes={content.observedOutcomes} kpis={content.kpis} />
      
      {/* Interactive Demo */}
      <CoPilotDemoSection content={content} />
      
      {/* Technical Details - Collapsed (repurposed from Battle Plan + Strategic Doctrine) */}
      <CollapsibleTechnicalDetails content={content} />
      
      {/* War Stories - Optional, only if journey exists */}
      {hasJourney && (
        <section className="mb-16">
          <CapabilityJourneySection capabilityType={content.slug} />
        </section>
      )}
      
      {/* Demo Request Form - From Battle Plan tab */}
      <section className="mb-16">
        <DemoRequestForm />
      </section>
    </>
  );
}
```

**Key Transformations:**

1. **Hero Content Transformation:**
   ```typescript
   function transformToHeroContent(content: CoPilotDetailContent): ProductHeroContent {
     return {
       badge: {
         text: content.pageTitle.split(':')[0] || 'CAPABILITY',
         emoji: getCoPilotEmoji(content.slug),
       },
       mainHeadline: extractOutcomeHeadline(content), // "Prevent Toxicity Before It Happens"
       subtitle: content.vision, // "Transform toxicity prediction..."
       description: extractOutcomeDescription(content), // Focus on outcomes, not features
       ctas: [
         { label: 'Try Live Demo →', href: '#demo', variant: 'primary' },
         { label: 'Learn More', href: '#technical', variant: 'secondary' }
       ]
     };
   }
   ```

2. **Problem Content Transformation:**
   ```typescript
   function transformToProblemContent(content: CoPilotDetailContent): ProblemSolutionContent {
     return {
       type: 'problem',
       title: `The Problem: ${extractProblemTitle(content)}`,
       description: content.coreProblemIntro || "Traditional approaches fall short...",
       cards: content.coreProblemPoints.slice(0, 3).map(point => ({
         title: extractTitle(point),
         description: extractDescription(point),
         icon: getProblemIcon(point),
         highlight: extractHighlight(point)
       }))
     };
   }
   ```

3. **Solution Content Transformation:**
   ```typescript
   function transformToSolutionContent(content: CoPilotDetailContent): ProblemSolutionContent {
     return {
       type: 'solution',
       title: `The Solution: ${extractSolutionTitle(content)}`,
       description: extractSolutionDescription(content),
       cards: content.observedOutcomes.slice(0, 3).map(outcome => ({
         title: outcome.title,
         description: outcome.description,
         icon: mapOutcomeToIcon(outcome.icon),
         highlight: outcome.keyMetric
       }))
     };
   }
   ```

### **Phase 2: Create Simplified Outcomes Section**

**File:** `src/components/co-pilot-detail/sections/SimplifiedOutcomesSection.tsx`

**Structure:**
```typescript
interface SimplifiedOutcomesSectionProps {
  outcomes: ObservedOutcome[];
  kpis?: KPIMetric[];
}

export default function SimplifiedOutcomesSection({ outcomes, kpis }: Props) {
  return (
    <section className="mb-16">
      <SectionHeader
        title="Real-World Results"
        description="Measurable outcomes from using this capability"
      />
      
      {/* Key Metrics Grid */}
      <div className="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
        {outcomes.slice(0, 3).map(outcome => (
          <OutcomeCard key={outcome.title} outcome={outcome} />
        ))}
      </div>
      
      {/* KPI Strip */}
      {kpis && <KPIGrid kpis={kpis.slice(0, 6)} />}
    </section>
  );
}
```

### **Phase 3: Create Collapsible Technical Details**

**File:** `src/components/co-pilot-detail/CollapsibleTechnicalDetails.tsx`

**Structure:**
```typescript
export default function CollapsibleTechnicalDetails({ content }: Props) {
  const [expanded, setExpanded] = useState(false);
  
  return (
    <section className="mb-16">
      <button
        onClick={() => setExpanded(!expanded)}
        className="w-full text-left p-6 bg-slate-50 rounded-lg border border-slate-200 hover:bg-slate-100 transition-colors"
      >
        <div className="flex items-center justify-between">
          <h3 className="text-xl font-bold text-slate-800">
            Technical Details & Advanced Features
          </h3>
          <ChevronDown className={`w-5 h-5 text-slate-600 transition-transform ${expanded ? 'rotate-180' : ''}`} />
        </div>
        <p className="text-sm text-slate-600 mt-2">
          Deep dive into capabilities, technical approach, and advanced features
        </p>
      </button>
      
      {expanded && (
        <div className="mt-6 space-y-8">
          {/* Core Capabilities */}
          <TacticalCapabilityMatrix keyCapabilities={content.keyCapabilities.filter(c => !c.priority || c.priority === 'primary')} />
          
          {/* Advanced Features */}
          {content.keyCapabilities.filter(c => c.priority === 'advanced').length > 0 && (
            <AdvancedFeaturesSection capabilities={content.keyCapabilities.filter(c => c.priority === 'advanced')} />
          )}
          
          {/* In-Silico Workflow */}
          {content.inSilicoWorkflow && (
            <InSilicoWorkflowSection workflow={content.inSilicoWorkflow} />
          )}
          
          {/* Value Proposition */}
          {content.valuePropositionSections && (
            <ValuePropositionFlywheel valuePropositionSections={content.valuePropositionSections} />
          )}
        </div>
      )}
    </section>
  );
}
```

