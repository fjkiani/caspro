## Usage Examples

### Basic Usage
```typescript
import { OracleExplainTrack, DynamicOracleExplain, VUSResolutionDemo } from '@/components/sae';

// Oracle Explain Track
<OracleExplainTrack
  sequence="ATCGATCG..."
  variant={{ pos: 88, ref: 'C', alt: 'T' }}
  saeFeatures={[...]}
  deltaLLSeries={[...]}
/>

// Dynamic Oracle Explain
<DynamicOracleExplain
  analyzedVariant={variant}
  getTextSize={(size) => size} // Optional
/>

// VUS Resolution Demo
<VUSResolutionDemo
  onVariantAnalyzed={(variant) => console.log(variant)}
  getTextSize={(size) => size} // Optional
/>
```

### With Adapters
```typescript
import { getSAEConfigForUseCase, TLSSAEThinkingProcess } from '@/components/sae';

const config = getSAEConfigForUseCase('tls_seed_generation');

<TLSSAEThinkingProcess
  useCaseId="tls_seed_generation"
  {...config}
/>
```

