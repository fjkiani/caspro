### **Phase 4: Create Generic Capability Page Template (Week 2)**

**Goal:** Make it easy to create educational pages for other capabilities

**Template Structure:**
```typescript
// src/app/products/[productSlug]/[capabilitySlug]/page.tsx
export default async function CapabilityPage({ params }) {
  const capabilityData = getCapabilityData(params.capabilitySlug);
  const moatDoc = getMOATDocument(params.capabilitySlug);
  const educationalData = transformToEducational(capabilityData, moatDoc);
  
  return (
    <EducationalPageLayout
      sidebar={educationalData.sidebar}
      progress={educationalData.progress}
    >
      <HeroQuestionSection {...educationalData.hero} />
      <ProblemNarrativeSection {...educationalData.problem} />
      <SolutionNarrativeSection {...educationalData.solution} />
      <HowItWorksSection {...educationalData.howItWorks} />
      <ConceptExplainer {...educationalData.concepts} />
      <ProcessVisualizer {...educationalData.process} />
      <ValuePropositionSection {...educationalData.value} />
      <ExampleShowcase {...educationalData.example} />
      <IntegrationSection {...educationalData.integration} />
      <CapabilityJourneySlider journeyType={params.capabilitySlug} />
      <ProgressiveDisclosureSection title="Technical Details">
        {/* Technical details collapsed by default */}
      </ProgressiveDisclosureSection>
    </EducationalPageLayout>
  );
}
```

