## 📝 USAGE EXAMPLES

### Example 1: Oracle Page with DetailedAPIExplorer

```tsx
// /products/oracle/page.tsx
import { ProductPageLayout, ProductHero, ProductSection } from '@/components/landing/ProductPageLayout';
import DetailedAPIExplorer from '@/components/landing/DetailedAPIExplorer';

export default function OraclePage() {
  return (
    <ProductPageLayout>
      <ProductHero
        title="Oracle: Mechanistically Interpretable AI"
        subtitle="Zero-shot variant impact prediction with 32,768 SAE features"
        metrics={[
          { value: '95.7%', label: 'ClinVar AUROC', description: 'Gold standard validation' },
          { value: '73%', label: 'VUS Resolution', description: 'Uncertainty to action' },
        ]}
      />
      
      <ProductSection title="API Explorer" subtitle="Explore Oracle's capabilities">
        <DetailedAPIExplorer 
          selectedEndpoint="variantImpact"
          onEndpointChange={(key) => console.log('Selected:', key)}
        />
      </ProductSection>
    </ProductPageLayout>
  );
}
```

