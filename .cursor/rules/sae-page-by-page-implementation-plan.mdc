## 🎨 **SHARED COMPONENTS TO CREATE**

### **1. SAE Feature Badge** (`src/components/shared/SAEFeatureBadge.tsx`)

```typescript
interface SAEFeatureBadgeProps {
  featureId: string;
  featureName: string;
  activation?: number;
  biologicalMeaning: string;
  color?: 'exon' | 'tfbs' | 'structure' | 'motif';
}

export const SAEFeatureBadge: React.FC<SAEFeatureBadgeProps> = ({
  featureId,
  featureName,
  activation,
  biologicalMeaning,
  color = 'exon'
}) => {
  const colorClasses = {
    exon: 'from-blue-500 to-cyan-500',
    tfbs: 'from-purple-500 to-pink-500',
    structure: 'from-green-500 to-emerald-500',
    motif: 'from-orange-500 to-red-500'
  };

  return (
    <div className={`bg-gradient-to-r ${colorClasses[color]} rounded-lg p-4 text-white`}>
      <div className="flex items-center justify-between mb-2">
        <span className="font-mono text-xs opacity-80">{featureId}</span>
        {activation && (
          <span className="text-xs font-semibold">{Math.round(activation * 100)}%</span>
        )}
      </div>
      <h4 className="font-bold mb-1">{featureName}</h4>
      <p className="text-sm opacity-90">{biologicalMeaning}</p>
    </div>
  );
};
```

