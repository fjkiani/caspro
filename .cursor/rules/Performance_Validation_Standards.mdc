## **VALIDATION CHECKLIST**

### **1. Pre-Implementation Validation**
```typescript
interface ValidationChecklist {
  sourceVerification: {
    isFromEvo2Paper: boolean;
    hasPeerReview: boolean;
    hasExperimentalValidation: boolean;
    hasSampleSize: boolean;
    hasMethodology: boolean;
  };
  
  metricValidation: {
    isRealNumber: boolean;
    hasConfidenceInterval: boolean;
    hasContext: boolean;
    hasDisclaimer: boolean;
    hasSource: boolean;
  };
  
  contextValidation: {
    isAppropriateContext: boolean;
    hasResearchModeDisclaimer: boolean;
    hasClinicalDisclaimer: boolean;
    hasLimitationAcknowledgment: boolean;
  };
}

// Example validation checklist
const validateMetric = (metric: any): ValidationChecklist => {
  return {
    sourceVerification: {
      isFromEvo2Paper: metric.source?.includes('Evo2 paper'),
      hasPeerReview: metric.source?.includes('peer-reviewed'),
      hasExperimentalValidation: metric.validation === 'experimental',
      hasSampleSize: typeof metric.sampleSize === 'number',
      hasMethodology: typeof metric.methodology === 'string'
    },
    
    metricValidation: {
      isRealNumber: typeof metric.value === 'number',
      hasConfidenceInterval: metric.confidence !== undefined,
      hasContext: metric.context !== undefined,
      hasDisclaimer: metric.disclaimer !== undefined,
      hasSource: metric.source !== undefined
    },
    
    contextValidation: {
      isAppropriateContext: metric.context?.includes('Research Mode'),
      hasResearchModeDisclaimer: metric.disclaimer?.includes('Research Mode'),
      hasClinicalDisclaimer: metric.disclaimer?.includes('Not for clinical use'),
      hasLimitationAcknowledgment: metric.limitations !== undefined
    }
  };
};
```

### **2. Implementation Validation**
```typescript
// ✅ VALID: Proper metric implementation
const implementValidatedMetric = (metric: any) => {
  // 1. Verify source
  if (!metric.source?.includes('Evo2 paper')) {
    throw new Error('Metric must come from Evo2 paper');
  }
  
  // 2. Add disclaimer for therapeutic applications
  if (metric.context?.includes('therapeutic') || metric.context?.includes('clinical')) {
    metric.disclaimer = 'Research Mode - Not for clinical use';
  }
  
  // 3. Include validation details
  return {
    value: metric.value,
    source: metric.source,
    disclaimer: metric.disclaimer,
    context: metric.context,
    validation: {
      sampleSize: metric.sampleSize,
      methodology: metric.methodology,
      confidence: metric.confidence
    }
  };
};

// ❌ INVALID: Improper metric implementation
const implementInvalidMetric = (metric: any) => {
  // Missing source verification
  // Missing disclaimer
  // Missing validation details
  return {
    value: metric.value, // No validation
    source: 'Estimated', // Not from Evo2 paper
    disclaimer: undefined // Missing disclaimer
  };
};
```

## **PERFORMANCE MONITORING**

### **1. Real-Time Validation**
```typescript
// Monitor performance claims in real-time
class PerformanceValidator {
  private validatedMetrics: Map<string, any> = new Map();
  
  validateMetric(metric: any): boolean {
    // Check if metric is from validated source
    if (!this.isFromValidatedSource(metric)) {
      console.error('Metric not from validated source:', metric);
      return false;
    }
    
    // Check if metric has proper disclaimers
    if (!this.hasProperDisclaimers(metric)) {
      console.error('Metric missing proper disclaimers:', metric);
      return false;
    }
    
    // Check if metric has proper context
    if (!this.hasProperContext(metric)) {
      console.error('Metric missing proper context:', metric);
      return false;
    }
    
    return true;
  }
  
  private isFromValidatedSource(metric: any): boolean {
    return metric.source?.includes('Evo2 paper') || 
           metric.source?.includes('peer-reviewed') ||
           metric.source?.includes('experimental validation');
  }
  
  private hasProperDisclaimers(metric: any): boolean {
    if (metric.context?.includes('therapeutic') || metric.context?.includes('clinical')) {
      return metric.disclaimer?.includes('Research Mode') && 
             metric.disclaimer?.includes('Not for clinical use');
    }
    return true;
  }
  
  private hasProperContext(metric: any): boolean {
    return metric.context !== undefined && 
           metric.context !== null &&
           typeof metric.context === 'string';
  }
}
```

### **2. Validation Reporting**
```typescript
// Generate validation reports
interface ValidationReport {
  timestamp: string;
  totalMetrics: number;
  validatedMetrics: number;
  invalidMetrics: number;
  validationRate: number;
  issues: ValidationIssue[];
}

interface ValidationIssue {
  type: 'source' | 'disclaimer' | 'context' | 'methodology';
  severity: 'error' | 'warning' | 'info';
  message: string;
  metric: any;
}

const generateValidationReport = (metrics: any[]): ValidationReport => {
  const validator = new PerformanceValidator();
  const issues: ValidationIssue[] = [];
  
  let validatedCount = 0;
  let invalidCount = 0;
  
  metrics.forEach(metric => {
    if (validator.validateMetric(metric)) {
      validatedCount++;
    } else {
      invalidCount++;
      issues.push({
        type: 'source',
        severity: 'error',
        message: 'Metric not from validated source',
        metric
      });
    }
  });
  
  return {
    timestamp: new Date().toISOString(),
    totalMetrics: metrics.length,
    validatedMetrics: validatedCount,
    invalidMetrics: invalidCount,
    validationRate: validatedCount / metrics.length,
    issues
  };
};
```

