// NON-RESPONDER — TMB-Low proxy (io = 0.2)
{
  "ddr": 0.2,  "mapk": 0.1,  "pi3k": 0.1,
  "vegf": 0.1, "her2": 0.0,  "io": 0.2,
  "efflux": 0.1, "rss": 0.3
