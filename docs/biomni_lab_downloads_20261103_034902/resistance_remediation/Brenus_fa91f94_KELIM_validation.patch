+import numpy as np
+import pandas as pd
+import pytest
+
+import kelim_os_cox_validation as m
+
+
+def test_inverse_normal_midrank_ties_and_extremes():
+    z = m.inverse_normal_midrank([1, 1, 2, 4])
+    assert np.isfinite(z).all()
+    assert z[0] == pytest.approx(z[1])
+    assert z[0] < z[2] < z[3]
+    assert z[3] == pytest.approx(1.15034938)
+
+
+def test_v1_rate_duplicate_time_median_and_decline_gate():
+    d = pd.DataFrame({
+        "id": ["a"] * 5 + ["b"] * 3,
+        "day": [0, 7, 7, 14, 21, 0, 7, 14],
+        "psa": [100, 52, 48, 25, 12.5, 10, 11, 12],
+    })
+    r = m.fit_v1_rates(d, "id", "psa", "day")
+    a = r.set_index("patient_id").loc["a"]
+    b = r.set_index("patient_id").loc["b"]
+    assert bool(a.eligible_rate)
+    assert a.n_psa == 4
+    assert a.k == pytest.approx(np.log(2) / 7, rel=0.08)
+    assert not bool(b.eligible_rate)
+
+
+def fixture_cohort(n=120, beta=-0.5, seed=10):
+    rng = np.random.default_rng(seed)
+    frames = []
+    for trial in ["TAX327", "VENICE"]:
+        k = rng.lognormal(-4.5, 0.8, n)
+        z = m.inverse_normal_midrank(k)
+        age = rng.integers(0, 2, n)
+        ecog = rng.integers(0, 3, n)
+        rate = np.exp(beta * z + 0.2 * age + 0.25 * ecog)
+        t = 15 + rng.exponential(70 / rate)
+        censor = 15 + rng.exponential(140, n)
+        frames.append(pd.DataFrame({"trial": trial,
+                                    "patient_id": [f"{trial}-{i}" for i in range(n)],
+                                    "k": k, "os_weeks": np.minimum(t, censor),
+                                    "event": (t <= censor).astype(int),
+                                    "age_ge65": age, "ecog": ecog}))
+    return pd.concat(frames, ignore_index=True)
+
+
+def test_landmark_event_and_uniqueness_guards():
+    d = fixture_cohort(n=10)
+    bad = d.copy(); bad.loc[0, "event"] = 2
+    with pytest.raises(ValueError, match="0/1"):
+        m.prepare_landmark(bad)
+    bad = d.copy(); bad.loc[1, ["trial", "patient_id"]] = bad.loc[0, ["trial", "patient_id"]]
+    with pytest.raises(ValueError, match="unique within trial"):
+        m.prepare_landmark(bad)
+    d.loc[0, "os_weeks"] = 15
+    lm, _ = m.prepare_landmark(d)
+    assert len(lm) == len(d) - 1
+    assert (lm.duration > 0).all()
+
+
+def test_k_fast_blocked_by_default():
+    with pytest.raises(ValueError, match="deprecated"):
+        m.resolve_rate_feature("k_fast")
+    assert m.resolve_rate_feature("k_fast", True) == "k_fast"
+    assert m.resolve_rate_feature(m.RATE_NAME) == "k"
+
+
+def test_meta_and_promotion_branches():
+    def model(hr, p, epv=20, ph=0.5, influential=0):
+        return {"epv": epv, "ph_test_p": {"z_rank": ph},
+                "influence": {"n_over_threshold": influential},
+                "terms": {"z_rank": {"HR": hr, "p": p, "coef": np.log(hr), "se": 0.1}}}
+    trial = {"VENICE": model(0.75, 0.01)}
+    meta = {"I2_pct": 0.0, "Q_p": 0.8}
+    promoted = m.promotion_decision(
+        model(0.75, 0.01), model(0.80, 0.02), trial, meta, os_sanity_passed=True)
+    assert promoted["passed"]
+    assert promoted["verdict"].startswith("ALGORITHM_VALIDATED")
+    pooled_only = m.promotion_decision(
+        model(0.90, 0.2), model(0.80, 0.02), trial, meta, os_sanity_passed=True)
+    assert pooled_only["verdict"] == "MULTICOHORT_OS_SIGNAL_NOT_EXTERNALLY_REPLICATED"
+    null = m.promotion_decision(
+        model(1.02, 0.8), model(0.95, 0.5), trial, meta, os_sanity_passed=True)
+    assert null["verdict"] == "PROXY_TECHNICALLY_FUNCTIONAL_CLINICALLY_UNVALIDATED"
+
+    gate_failures = [
+        (model(0.75, 0.01, epv=9), model(0.80, 0.02), trial, meta, True, "epv_ge_10"),
+        (model(0.75, 0.01, ph=0.01), model(0.80, 0.02), trial, meta, True, "rank_ph_ok"),
+        (model(0.75, 0.01, influential=1), model(0.80, 0.02), trial, meta, True,
+         "influence_diagnostics_passed"),
+        (model(0.75, 0.01), model(0.80, 0.02), trial,
+         {"I2_pct": 70.0, "Q_p": 0.01}, True, "heterogeneity_acceptable"),
+        (model(0.75, 0.01), model(0.80, 0.02), trial, meta, False, "os_sanity_passed"),
+    ]
+    for external, all_cohort, external_trials, meta_input, sanity, failed_check in gate_failures:
+        decision = m.promotion_decision(
+            external, all_cohort, external_trials, meta_input, os_sanity_passed=sanity)
+        assert not decision["passed"]
+        assert not decision["checks"][failed_check]
+
+    missing_ph = model(0.75, 0.01)
+    missing_ph.pop("ph_test_p")
+    decision = m.promotion_decision(
+        missing_ph, model(0.80, 0.02), trial, meta, os_sanity_passed=True)
+    assert not decision["checks"]["rank_ph_ok"]
+
+
+def test_end_to_end_stratified_cox():
+    receipt, cohort = m.run_analysis(
+        fixture_cohort(), landmark_weeks=15, os_sanity_passed=True)
+    assert set(receipt["trial_specific"]) == {"TAX327", "VENICE"}
+    assert receipt["all_cohort"]["stratified_by_trial"]
+    assert receipt["external_only"]["trials"] == ["VENICE"]
+    assert receipt["all_cohort"]["terms"]["z_rank"]["HR"] < 1
+    assert len(cohort) > 150
+
+
+def test_external_cohort_is_required():
+    tax_only = fixture_cohort(n=20).query("trial == 'TAX327'")
+    with pytest.raises(ValueError, match="no qualifying external cohort"):
+        m.run_analysis(tax_only, os_sanity_passed=True)
+
+
+def test_json_hash_roundtrip(tmp_path):
+    path = tmp_path / "receipt.json"
+    digest = m.write_json_with_hash({"promotion": {"passed": False}}, path)
+    assert len(digest) == 64
+    assert path.with_suffix(".json.sha256").read_text().split()[0] == digest
