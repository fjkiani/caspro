  "capability_released": "RELATIVE_PROGNOSTIC_INDEX_ONLY",
  "deployment_claim": "NONE. Code is on a feature branch only; nothing is merged to main and no environment is declared deployed.",
  "evidence_class_separation": {
    "1_continuous_ruo_prognostic_index": {
      "content": "k_day, reference_percentile, z_rank, prognostic_log_hazard_index and relative_hazard_multiplier form a continuous ordering associated with overall survival in one external cohort.",
      "status": "RELEASED_FOR_RESEARCH_USE_ONLY",
      "what_it_is_not": "It is not an absolute survival probability and not a treatment benefit estimate."
    },
    "2_suppressed_unstable_band": {
      "content": "The categorical field is emitted as null on every code path. The B6 prespecified stability requirement was not met at the frozen quartile knots, so the categorical layer is withheld rather than reported.",
      "status": "SUPPRESSED_BY_PRESPECIFIED_GATE_FAILURE",
      "what_it_is_not": "Suppression is not a statement that the continuous index failed; the continuous index is released and the categorical layer is not."
    },
    "3_coefficient_only_uncertainty": {
      "content": "coefficient_conditional_relative_hazard_interval propagates the standard error of the single frozen coefficient at a fixed z_rank. Its width is |z_rank| * SE, so it is exactly zero at the reference point.",
      "status": "RELEASED_WITH_EXPLICIT_SCOPE_LABEL",
      "what_it_is_not": "It is not a patient-level predictive interval and contains no component for the patient's own measurement error."
    },
    "4_patient_rate_uncertainty": {
      "content": "The fit-precision receipt bootstraps the patient's own observations to give a k_day interval, a percentile interval and a decline-sign stability fraction. At exactly three distinct observation days it is not estimable and every interval is null with status INSUFFICIENT_FOR_UNCERTAINTY.",
      "status": "RELEASED_WHEN_ESTIMABLE_ELSE_NULL",
      "what_it_is_not": "It is not coefficient uncertainty and the two are never combined into a single interval."
    },
    "5_absolute_risk_transport_evidence": {
      "content": "D10 transported the TAX327-derived model to VENICE at the prespecified gate-eligible horizons. Calibration slope and observed-to-expected both failed the prespecified gate in both transport variants.",
      "status": "EVALUATED_AND_FAILED_NOTHING_ACTIVATED",
      "what_it_is_not": "A passing result would still have activated nothing. The failing result is evidence about transportability, not a released output."
    },
    "6_treatment_prediction": {
      "content": "No treatment-predictive quantity is computed anywhere in the code path. The corresponding keys are emitted as null on every payload.",
      "status": "STRUCTURALLY_UNAVAILABLE",
      "what_it_is_not": "Absence is structural, not a threshold that could be crossed by supplying more data. Every released prostate cohort is a comparator or control arm, so the comparison is not identified."
    },
    "mandate": "Item 9 of the completion directive requires every emitted artifact to keep these six evidence classes separate and to never let one stand in for another."
  },
  "landmark_discipline": "Pre-landmark deaths are excluded structurally and are never reweighted. No pre-landmark death is compared with a landmark survivor under a common time origin.",
