Subject: [PATCH 1/3] resistance_prophet: fail-closed guard on Sig7 prognosis
 branch (D2)

With ZETA_SIG7_PROGNOSIS_ACTIONS_ENABLED unset, the sig7 branch returns
UNCERTAIN / ROUTINE_SURVEILLANCE / LOW confidence with rationale citing the
collapse evidence (AUROC 0.8739 on n=40/3 events reverses to 0.3136 on
outcome-label swap; OOF AUROC 0.4108 continuous). The POOR ->
INTENSIFY_SURVEILLANCE path no longer fires by default. PrognosisResult
schema unchanged; closes the production-wired PROGNOSIS_ALERT escalation
path. Full-suite differential vs unpatched: zero node-level changes.
---
 api/services/resistance_prophet/prognosis.py | 114 ++++++++++++++++++-
 1 file changed, 113 insertions(+), 1 deletion(-)

diff --git a/api/services/resistance_prophet/prognosis.py b/api/services/resistance_prophet/prognosis.py
index c56c002a..ff02cd96 100644
--- a/api/services/resistance_prophet/prognosis.py
+++ b/api/services/resistance_prophet/prognosis.py
@@ -1,14 +1,86 @@
 
+import os
 from typing import Dict, List, Optional
 from dataclasses import dataclass
 from .schemas import PrognosisState, PrognosisResult
 from .constants import SIG7_RISK_THRESHOLD, PROGNOSIS_CONFIDENCE_CAP
 
+# ---------------------------------------------------------------------------
+# FAIL-CLOSED GUARD ON THE SIG7 PROGNOSIS RULE
+# ---------------------------------------------------------------------------
+# Why this guard exists (register rows C01 / C13; evidence paths below):
+#
+#   The rule `sig7_exposure >= SIG7_RISK_THRESHOLD (0.25) -> PrognosisState.POOR ->
+#   action_recommendation "INTENSIFY_SURVEILLANCE"` has one evidentiary basis: an AUROC
+#   of 0.8739 computed on n=40 with THREE events, using a RECIST-derived relapse label.
+#
+#   * That statistic reverses to AUROC 0.3136 on the SAME fixed 40-patient feature matrix
+#     when only the outcome label is swapped to registration platinum status
+#     (obl2_auroc_summary.csv; obl2_invariants.json).
+#   * CLAIM_LEDGER.md row 3 classifies it as an artifact of label definition.
+#   * sig7_cv_falsification.json shows the three-stage collapse:
+#       n=40  /  3 events  AUROC 0.874  (prior claim)
+#       n=96  / 13 events  AUROC 0.621
+#       n=67  / 15 events  AUROC 0.421  (adjudicated label; cross-validated 0.5250 = no
+#                                        discrimination)
+#   * Independently measured here on identical folds (n=67, 9 events): the shipped binary
+#     rule scores OOF AUROC 0.6446 with Brier 0.2090 against a prevalence-only Brier of
+#     0.1163; s7 as a continuous score scores OOF AUROC 0.4108 — BELOW chance.
+#   * Macintyre 2018 (Nat Genet 50:1262) identifies s7 as a GOOD-outcome signature. The
+#     canonical platinum-resistance axis in that framework is s1 (RAS/MAPK). The shipped
+#     rule therefore also has the direction inverted relative to the literature.
+#
+#   Consequence: this path was emitting an evidence-free deviation from routine care
+#   (POOR + INTENSIFY_SURVEILLANCE) and an equally evidence-free reassurance
+#   (FAVORABLE), and it feeds TestRouter.route_tests(), which converts POOR into an
+#   IMMEDIATE low-pass WGS order (test_router.py:171).
+#
+# What this guard does:
+#   Default (flag unset): the sig7 branch no longer emits POOR/FAVORABLE and no longer
+#   deviates from routine surveillance. State becomes UNCERTAIN, confidence LOW, and the
+#   rationale records the observed input value with NO risk interpretation plus the
+#   suppression reason. The dataclass schema is unchanged, so no serializer, router or
+#   response model needs to change — the minimum blast radius that closes the hole.
+#
+#   Flag set (ZETA_SIG7_PROGNOSIS_ACTIONS_ENABLED=1): legacy behaviour is restored
+#   verbatim, for research reproduction only.
+#
+# What this guard deliberately does NOT do (deferred; see PROPOSED_PATCH_C02_C03.md):
+#   * It does not fix the signature-namespace mismatch in _get_sig7_exposure (C02).
+#   * It does not fail-close the QC gate in _check_qc (C03).
+#   Both are documented with an applyable proposal. They are not applied here because the
+#   repository baseline is RED (226 failing/erroring nodes on main) and those changes have
+#   a materially wider blast radius than this one.
+# ---------------------------------------------------------------------------
+
+SIG7_PROGNOSIS_ACTIONS_ENV = "ZETA_SIG7_PROGNOSIS_ACTIONS_ENABLED"
+_TRUTHY = frozenset({"1", "true", "yes", "on"})
+
+SIG7_SUPPRESSION_RATIONALE = (
+    "Sig7 prognostic state and action suppressed (fail-closed). Basis: the 0.25 threshold "
+    "rests on AUROC 0.8739 at n=40 with 3 events, which reverses to 0.3136 under label swap "
+    "alone and collapses to 0.421 at n=67/15 events; CLAIM_LEDGER row 3 classifies it as a "
+    "label artifact; measured OOF AUROC of the shipped rule is 0.6446 and of continuous s7 "
+    "is 0.4108 (below chance). Set "
+    + SIG7_PROGNOSIS_ACTIONS_ENV
+    + "=1 to restore legacy behaviour for research reproduction only."
+)
+
+
+def sig7_prognosis_actions_enabled(env: Optional[Dict[str, str]] = None) -> bool:
+    """True only when the sig7 prognosis state/action is explicitly re-enabled."""
+    src = os.environ if env is None else env
+    return str(src.get(SIG7_PROGNOSIS_ACTIONS_ENV, "")).strip().lower() in _TRUTHY
+
+
 class PrognosisEngine:
     """
     The Silent Sentinel.
     Separates Risk State (Prognosis) from Recurrence Events (Alarms).
     Focused on molecular potential for recurrence, primarily BriTROC Sig7.
+
+    NOTE: the Sig7 state/action path is fail-closed by default. See the guard block at
+    the top of this module.
     """
 
     def assess_risk(self, patient_data: Dict, is_post_treatment: bool = False) -> PrognosisResult:
@@ -27,6 +99,9 @@ class PrognosisEngine:
              )
 
         # 0b. Gate: QC Check
+        # PROPOSED PATCH (DEFERRED, C03): _check_qc is fail-OPEN — it returns True when no
+        # QC metrics are present. A sample with no QC data currently passes. See
+        # PROPOSED_PATCH_C02_C03.md for the fail-closed replacement.
         if not self._check_qc(patient_data):
             return PrognosisResult(
                 state=PrognosisState.UNCERTAIN,
@@ -40,6 +115,24 @@ class PrognosisEngine:
         
         # 2. Evaluate State
         if sig7_exposure is not None:
+            if not sig7_prognosis_actions_enabled():
+                # FAIL-CLOSED: report the observed input, make no risk claim, do not
+                # deviate from routine surveillance.
+                return PrognosisResult(
+                    state=PrognosisState.UNCERTAIN,
+                    confidence="LOW",
+                    rationale=[
+                        f"Observed Sig7 input value {sig7_exposure:.3f} (input only; no risk interpretation applied).",
+                        SIG7_SUPPRESSION_RATIONALE,
+                        "Namespace caveat (C02): this value is read from "
+                        "molecular_profile.signatures.cosmic_cn_signatures.Sig7, a COSMIC-framework "
+                        "field, while the 0.25 threshold was derived from Macintyre/BriTROC s7. "
+                        "These are different frameworks.",
+                    ],
+                    action_recommendation="ROUTINE_SURVEILLANCE",
+                )
+
+            # LEGACY PATH — research reproduction only, explicitly re-enabled.
             if sig7_exposure >= SIG7_RISK_THRESHOLD:
                 state = PrognosisState.POOR
                 rationale = [f"High Sig7 Exposure ({sig7_exposure:.3f} >= {SIG7_RISK_THRESHOLD})"]
@@ -48,7 +141,13 @@ class PrognosisEngine:
                 state = PrognosisState.FAVORABLE
                 rationale = [f"Low Sig7 Exposure ({sig7_exposure:.3f} < {SIG7_RISK_THRESHOLD})"]
                 action = "ROUTINE_SURVEILLANCE"
-                
+
+            rationale = rationale + [
+                "RESEARCH REPRODUCTION MODE: "
+                + SIG7_PROGNOSIS_ACTIONS_ENV
+                + "=1. This state and action are NOT clinically validated."
+            ]
+
             confidence = PROGNOSIS_CONFIDENCE_CAP # Capped at MEDIUM until multi-biomarker validation
         else:
             state = PrognosisState.UNCERTAIN
@@ -68,6 +167,14 @@ class PrognosisEngine:
         """
         Safely extra sig7 exposure from nested patient data.
         Expected path: molecular_profile -> signatures -> cosmic_cn_signatures -> Sig7
+
+        PROPOSED PATCH (DEFERRED, C02): the threshold this value is compared against was
+        derived from the Macintyre/BriTROC 7-signature framework, but the value is read
+        from a COSMIC copy-number signature namespace. COSMIC CN7 is not Macintyre s7.
+        The correct behaviour is to raise on a framework mismatch rather than return a
+        value from the wrong namespace or silently return None. See
+        PROPOSED_PATCH_C02_C03.md, and s3_research.extract_s3_diag for a namespace-strict
+        reference implementation.
         """
         try:
             # Flexible access based on expected schemas
@@ -87,6 +194,11 @@ class PrognosisEngine:
         """
         Check if sample passes molecular QC (e.g. MAPD).
         Ref: User spec - 'requires passing CNA QC'.
+
+        PROPOSED PATCH (DEFERRED, C03): this gate is fail-OPEN. A payload with no
+        qc_metrics block passes, and a bare `except:` also returns True. For any
+        care-influencing use the gate must fail CLOSED (absent QC == not assessable).
+        See PROPOSED_PATCH_C02_C03.md.
         """
         # Placeholder for platform-specific QC logic
         # If 'qc_metrics' block exists, check it.
