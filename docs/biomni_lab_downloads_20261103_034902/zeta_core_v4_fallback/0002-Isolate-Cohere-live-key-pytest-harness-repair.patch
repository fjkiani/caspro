+def classify_cohere_key(raw: Optional[str]) -> str:
+    if raw is None:
+        return "ABSENT"
+    value = raw.strip()
+    if not value:
+        return "EMPTY"
+    if not KEY_PATTERN.fullmatch(value) or any(x in value.lower() for x in PLACEHOLDER_FRAGMENTS):
+        return "MALFORMED"
+    return "VALID_SHAPE"
 
