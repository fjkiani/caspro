+import asyncio, os, subprocess, sys
+from types import SimpleNamespace
+import pytest
+
+from tests.test_cohere_with_key import (
+    classify_cohere_key,
+    run_cohere_probe,
+    test_cohere_live_integration as live_integration_check,
+)
+
+
+@pytest.mark.parametrize("value,state", [
+    (None,"ABSENT"),("","EMPTY"),("   ","EMPTY"),("short","MALFORMED"),
+    ("your-key-here-1234567890","MALFORMED"),("A_validly_shaped_key_123456789","VALID_SHAPE")])
+def test_key_classification(value,state):
+    assert classify_cohere_key(value)==state
+
+
+class FakeProvider:
+    def is_available(self): return True
+    async def chat(self, **kwargs): return SimpleNamespace(text="OK")
+
+
+def test_valid_shape_enters_provider_path_without_network():
+    key="A_validly_shaped_key_123456789"
+    result=asyncio.run(run_cohere_probe(key, provider_factory=FakeProvider))
+    assert result.provider_available and result.response_has_text
+
+
+def test_malformed_targeted_execution_fails_not_skips(monkeypatch):
+    monkeypatch.setenv("COHERE_API_KEY","malformed")
+    monkeypatch.setenv("COHERE_LIVE_TEST","1")
+    with pytest.raises(AssertionError,match="COHERE_KEY_MALFORMED"):
+        live_integration_check()
+
+
+@pytest.mark.parametrize("mode,value", [("absent",None),("empty",""),("valid","A_validly_shaped_key_123456789"),("malformed","bad")])
+def test_collection_never_aborts_for_key_state(mode,value):
+    env=os.environ.copy(); env.pop("COHERE_API_KEY",None); env.pop("COHERE_LIVE_TEST",None)
+    if value is not None: env["COHERE_API_KEY"]=value
+    p=subprocess.run([sys.executable,"-m","pytest","--collect-only","-q","-p","no:cacheprovider",
+                      "tests/test_cohere_with_key.py"],cwd=os.getcwd(),env=env,capture_output=True,text=True)
+    assert p.returncode==0, (mode,p.stdout,p.stderr)
+    assert "test_cohere_live_integration" in p.stdout
+
+
+def test_absent_and_empty_skip_without_hiding_malformed(monkeypatch):
+    monkeypatch.delenv("COHERE_API_KEY",raising=False)
+    with pytest.raises(pytest.skip.Exception,match="COHERE_KEY_ABSENT"): live_integration_check()
+    monkeypatch.setenv("COHERE_API_KEY","   ")
+    with pytest.raises(pytest.skip.Exception,match="COHERE_KEY_EMPTY"): live_integration_check()
