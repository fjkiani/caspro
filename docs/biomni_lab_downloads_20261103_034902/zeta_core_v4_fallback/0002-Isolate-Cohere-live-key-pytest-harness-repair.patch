+def test_cohere_live_integration():
+    raw = os.getenv("COHERE_API_KEY")
+    state = classify_cohere_key(raw)
+    if state in ("ABSENT", "EMPTY"):
+        pytest.skip(f"COHERE_KEY_{state}: optional live integration credential not configured")
+    assert state == "VALID_SHAPE", "COHERE_KEY_MALFORMED"
+    if os.getenv("COHERE_LIVE_TEST") != "1":
+        pytest.skip("COHERE_LIVE_OPT_IN_REQUIRED")
+    result = asyncio.run(run_cohere_probe(raw.strip()))
+    assert result.provider_available, "COHERE_PROVIDER_UNAVAILABLE"
+    assert result.response_has_text, "COHERE_EMPTY_RESPONSE"
