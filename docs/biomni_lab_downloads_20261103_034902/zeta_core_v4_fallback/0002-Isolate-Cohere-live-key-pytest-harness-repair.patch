+async def run_cohere_probe(key: str, provider_factory: Optional[Callable] = None) -> ProbeResult:
+    """Run one minimal probe; injectable factory keeps unit tests offline."""
+    assert classify_cohere_key(key) == "VALID_SHAPE", "COHERE_KEY_MALFORMED"
+    if provider_factory is None:
+        from api.services.llm_provider.llm_abstract import LLMProvider, get_llm_provider
+        provider = get_llm_provider(provider=LLMProvider.COHERE)
+    else:
+        provider = provider_factory()
+    available = bool(provider and provider.is_available())
+    if not available:
+        return ProbeResult(False, False)
+    response = await provider.chat(message="Reply with OK.", max_tokens=8, temperature=0.0)
+    return ProbeResult(True, bool(getattr(response, "text", "").strip()))
 
