+"""Schema- and lineage-based validation of refused prognostic responses.
+
+WHAT THIS IS
+------------
+When the service declines to publish a prognostic index, this module proves --
+structurally, by walking the payload -- that no field in the *percentile lineage*
+survives anywhere in the response, at any nesting depth, under any alias, and
+under any of the transform suffixes an implementer might reach for.
+
+WHAT THIS IS NOT
+----------------
+This is **not** an information-theoretic non-leakage proof, and it must never be
+described as one. The reference CDF artifact is committed to this repository and
+``k_day`` is released under Contract A, so any consumer holding both can compute
+a percentile themselves. What a refused response guarantees is narrower and
+honest:
+
+    the API surface carries no field in the percentile lineage, and therefore
+    the service ENDORSES no percentile, interval or band value for this request.
+
+That is a schema and endorsement boundary. The previous release tested the wrong
+thing -- "no number lies within 0.01 of the withheld percentile" -- which is
+defeated by any monotone transform, tests a single hand-picked target, and cannot
+enumerate the fields nobody thought to look at. That check survives only as
+exploratory defence-in-depth in :func:`numeric_proximity_probe`, whose docstring
+says so explicitly.
+
+Prespecified in ``audit_correction_prespecification_v2_addendum.json`` under
+``refusal_schema_item1`` BEFORE implementation.
+"""
+from __future__ import annotations
+
+import re
+from typing import Any, Dict, Iterable, List, Mapping, Optional, Sequence, Tuple
+
+__all__ = [
+    "FORBIDDEN_LINEAGE_ROOTS",
+    "FORBIDDEN_LINEAGE_ALIASES",
+    "FORBIDDEN_TRANSFORM_SUFFIXES",
+    "REFUSED_BLOCK_ALLOWED_FIELDS",
+    "REFUSED_BLOCK_NULL_REQUIRED_FIELDS",
+    "REFUSED_RECEIPT_ALLOWED_FIELDS",
+    "REFUSED_RECEIPT_NULL_REQUIRED_FIELDS",
+    "STATIC_SUBTREE_FIELDS",
+    "REFUSAL_BOUNDARY_STATEMENT",
+    "LineageViolation",
+    "RefusalSchemaError",
+    "normalize_field_name",
+    "field_name_violation",
+    "lineage_violations",
+    "assert_refusal_schema",
+    "numeric_proximity_probe",
+]
+
+#: The statement that must accompany every refused response. It says what the
+#: guarantee IS, and -- more importantly -- what it is not.
+REFUSAL_BOUNDARY_STATEMENT = (
+    "This is a schema and endorsement boundary, not an information-theoretic one. "
+    "The reference CDF artifact is committed and k_day is released, so a consumer "
+    "holding both can compute a percentile independently. What this refusal "
+    "guarantees is that the response carries no field in the percentile lineage at "
+    "any depth, and therefore that the service endorses no percentile, interval or "
+    "categorical value for this request."
+)
+
+# ── the forbidden lineage ─────────────────────────────────────────────────────
+#: Canonical roots. Anything whose normalized name CONTAINS one of these is in
+#: the percentile lineage.
+FORBIDDEN_LINEAGE_ROOTS: Tuple[str, ...] = (
+    "percentile",
+    "centile",
+    "quantile",
+    "pctile",
+    "zrank",
+    "zscore",
+    "normit",
+    "probit",
+    "multiplier",
+    "hazardratio",
+    "relativehazard",
+    "loghazard",
+    "band",
+    "tier",
+    "stratum",
+    "quartile",
+    "decile",
+    "tercile",
+)
+
+#: Short or idiomatic aliases that do not contain a canonical root. These are
+#: matched on the WHOLE normalized name or on a normalized path segment, never as
+#: a substring, because two-letter tokens like ``hr`` and ``ci`` would otherwise
+#: collide with innocent names such as ``chronic`` or ``precision``.
+FORBIDDEN_LINEAGE_ALIASES: Tuple[str, ...] = (
+    "pct",
+    "pctl",
+    "p",
+    "hr",
+    "ci",
+    "cis",
+    "ll",
+    "ul",
+    "lcl",
+    "ucl",
+    "rank",
+    "z",
+    "category",
+    "categories",
+    "class",
+    "grade",
+    "group",
+    "interval",
+    "intervals",
+    "confidenceinterval",
+    "credibleinterval",
+    "crediblerange",
+    "riskband",
+    "riskcategory",
+    "riskgroup",
+    "riskstratum",
+)
+
+#: Transform suffixes. A transformed DESCENDANT of a forbidden field is still
+#: forbidden: ``percentile_logit`` and ``multiplier_log`` are not new quantities.
+FORBIDDEN_TRANSFORM_SUFFIXES: Tuple[str, ...] = (
+    "log",
+    "log10",
+    "logit",
+    "exp",
+    "z",
+    "scaled",
+    "norm",
+    "normalised",
+    "normalized",
+    "transformed",
+    "derived",
+    "rounded",
+    "binned",
+    "rank",
+    "pct",
+    "proxy",
+    "est",
+    "hat",
+    "approx",
+    "recovered",
+    "reconstructed",
+)
+
+#: Exactly the fields a refused ``relative_prognostic_index`` block may contain.
+#: This is an ALLOW-LIST: anything absent from it is a violation, which is what
+#: makes the check total rather than a game of naming whack-a-mole.
+REFUSED_BLOCK_ALLOWED_FIELDS: Tuple[str, ...] = (
+    "eligible",
+    "ineligible_reason",
+    "k_day",
+    "fit_qc",
+    "beta",
+    "beta_standard_error",
+    "reference_z_rank",
+    "evidence_status",
+    "limitations",
+    "interpretation",
+    "disclosure",
+    "band_status",
+    "band_gate_observed",
+    "band_gate_required",
+    "band_gate_pass",
+    "band_semantics",
+    "band_suppression_statement",
+    "exploratory_band_definition",
+    "interval_semantics",
+    "fit_precision_status",
+    "fit_precision_semantics",
+    "fit_precision_design",
+    "decline_sign_stability",
+    "k_day_uncertainty_interval",
+    "landmark_scope_source",
+    "landmark_scope_verified",
+    "landmark_scope_statement",
+    "reference_artifact_version",
+    "reference_artifact_sha256",
+    "validated_population_scope",
+    "refusal_boundary_statement",
+    "three_observation_disclosure",
+    "landmark_scope_annotation",
+    "release_contract",
+    # ---------------------------------------------------------------------
+    # LINEAGE FIELD NAMES PERMITTED ONLY AS LITERAL NULLS.
+    #
+    # These names ARE in the forbidden lineage. They appear on the refused
+    # path because this API deliberately emits one key set on both paths: a
+    # consumer that pinned a field receives it EMPTY rather than losing the
+    # key and falling back to a stale cached value. Dropping them would also
+    # destroy the key-set-equality invariant that catches silent drift.
+    #
+    # Their presence is therefore conditional, and the condition is checked:
+    # every name below must be a literal ``None`` in a refused response, or
+    # ``lineage_violations`` reports ``LINEAGE_FIELD_NOT_NULL`` and
+    # serialization fails. That is STRICTER than deleting the keys, because
+    # deletion cannot detect an allow-listed name that carries a value.
+    # ---------------------------------------------------------------------
+    *(_NULL_ONLY := (
+        "reference_percentile",
+        "z_rank",
+        "prognostic_log_hazard_index",
+        "relative_hazard_multiplier",
+        "coefficient_conditional_relative_hazard_interval",
+        "relative_prognostic_band",
+        "percentile_uncertainty_interval",
+        "multiplier_uncertainty_interval",
+        "boundary_crossing_probability",
+    )),
+)
+
+#: The subset of :data:`REFUSED_BLOCK_ALLOWED_FIELDS` that must be literally
+#: ``None``. Every one of these is a percentile-lineage name; the allow-list
+#: admits the KEY, this set forbids any VALUE.
+REFUSED_BLOCK_NULL_REQUIRED_FIELDS: Tuple[str, ...] = _NULL_ONLY
+
+#: Exactly the fields a refused ``fit_precision_receipt`` may contain. Rate-space
+#: fields are deliberately retained; the boundary statement says why.
+REFUSED_RECEIPT_ALLOWED_FIELDS: Tuple[str, ...] = (
+    "status",
+    "status_reason",
+    "n_distinct_days",
+    "n_observations_in_window",
+    "n_replicates",
+    "n_usable_replicates",
+    "n_positive_finite_replicates",
+    "finite_replicate_fraction",
+    "decline_sign_stability",
+    "k_day_uncertainty_interval",
+    "k_day_bootstrap_sd",
+    "point_k_day_reproduced",
+    "point_k_day_reproduced_bitwise",
+    "receipt_redacted",
+    "redacted_fields",
+    "receipt_scope_statement",
+    "refusal_boundary_statement",
+    "bootstrap_replicates",
+    "bootstrap_seed",
+    # Same rule as the block: the receipt emits one key set on both paths, and
+    # these lineage names are admitted ONLY as literal nulls. This is exactly
+    # what ``FIT_PRECISION_RECEIPT_REDACTED_ON_INELIGIBLE`` nulls out; the check
+    # below is the independent proof that the redaction actually happened.
+    *(_RECEIPT_NULL_ONLY := (
+        "percentile_uncertainty_interval",
+        "z_rank_uncertainty_interval",
+        "multiplier_uncertainty_interval",
+        "percentile_interval_width",
+        "boundary_crossing_probability",
+        "boundary_crossing_probability_unconditional",
+    )),
+    # LOO verdict fields. Named outside the lineage on purpose: they carry a
+    # boolean and a count of negative slopes, never a percentile.
+    "loo_sign_established",
+    "loo_sign_rule",
+    "loo_negative_slope_count",
+)
+
+#: Receipt fields admitted as keys but required to be literally ``None``.
+REFUSED_RECEIPT_NULL_REQUIRED_FIELDS: Tuple[str, ...] = _RECEIPT_NULL_ONLY
+
+#: Top-level fields whose SUBTREE is a static definition block -- population
+#: constants, frozen wording and design parameters that do not depend on the
+#: patient. Their nested keys legitimately name percentile cut points
+#: (``lower_percentile_cut``) and interval design, so the lineage walk would
+#: otherwise flag a constant as a leak.
+#:
+#: This exemption is not taken on trust. ``test_static_subtrees_are_patient
+#: _invariant`` serializes two DIFFERENT refused patients and asserts every
+#: exempt subtree is byte-identical between them, which is what makes "static"
+#: a verified property rather than a claim.
+STATIC_SUBTREE_FIELDS: Tuple[str, ...] = (
+    "band_semantics",
+    "band_suppression_statement",
+    "band_gate_observed",
+    "band_gate_required",
+    "band_gate_pass",
+    "band_status",
+    "exploratory_band_definition",
+    "interval_semantics",
+    "fit_precision_semantics",
+    "fit_precision_design",
+    "landmark_scope_statement",
+    "validated_population_scope",
+    "refusal_boundary_statement",
+    "receipt_scope_statement",
+    "three_observation_disclosure",
+    "limitations",
+    "interpretation",
+    "disclosure",
+    "beta",
+    "beta_standard_error",
+    "reference_z_rank",
+    "evidence_status",
+)
+
+_SEPARATORS = re.compile(r"[^a-z0-9]+")
+
+
+class RefusalSchemaError(Exception):
+    """A refused response carried a field it is not permitted to carry."""
+
+
+class LineageViolation(tuple):
+    """``(json_path, field_name, rule, detail)`` -- a single schema violation."""
+
+    __slots__ = ()
+
+    def __new__(cls, path: str, field: str, rule: str, detail: str):
+        return super().__new__(cls, (path, field, rule, detail))
+
+    @property
+    def path(self) -> str:
+        return self[0]
+
+    @property
+    def field(self) -> str:
+        return self[1]
+
+    @property
+    def rule(self) -> str:
+        return self[2]
+
+    @property
+    def detail(self) -> str:
+        return self[3]
+
+    def __repr__(self) -> str:  # pragma: no cover - diagnostics only
+        return f"LineageViolation(path={self[0]!r}, field={self[1]!r}, rule={self[2]!r})"
+
+
+def normalize_field_name(name: str) -> str:
+    """Lowercase and strip every separator, so ``z-Rank``, ``z_rank`` and
+    ``ZRank`` all normalize to ``zrank``."""
+    return _SEPARATORS.sub("", str(name).lower())
+
+
+def _segments(name: str) -> List[str]:
+    return [s for s in _SEPARATORS.split(str(name).lower()) if s]
+
+
+def field_name_violation(name: str) -> Optional[Tuple[str, str]]:
+    """Return ``(rule, detail)`` if ``name`` is in the percentile lineage.
+
+    Three independent rules, checked in order of specificity:
+
+    1. ``FORBIDDEN_ROOT`` -- the normalized name contains a canonical root.
+    2. ``FORBIDDEN_ALIAS`` -- a whole normalized segment (or the whole normalized
+       name) equals a known alias.
+    3. ``FORBIDDEN_TRANSFORMED_DESCENDANT`` -- the name ends in a transform
+       suffix AND the remainder is itself in the lineage by rule 1 or 2.
+    """
+    normalized = normalize_field_name(name)
+    if not normalized:
+        return None
+
+    for root in FORBIDDEN_LINEAGE_ROOTS:
+        if root in normalized:
+            return ("FORBIDDEN_ROOT", f"normalized name {normalized!r} contains {root!r}")
+
+    segs = _segments(name)
+    for alias in FORBIDDEN_LINEAGE_ALIASES:
+        if normalized == alias or alias in segs:
+            return ("FORBIDDEN_ALIAS", f"segment or whole name matches alias {alias!r}")
+
+    for suffix in FORBIDDEN_TRANSFORM_SUFFIXES:
+        if len(segs) >= 2 and segs[-1] == suffix:
+            stem = "_".join(segs[:-1])
+            inner = field_name_violation(stem)
+            if inner is not None:
+                return (
+                    "FORBIDDEN_TRANSFORMED_DESCENDANT",
+                    f"transform suffix {suffix!r} applied to lineage stem {stem!r} "
+                    f"({inner[0]})",
+                )
+    return None
+
+
+def lineage_violations(
+    payload: Any,
+    *,
+    allowed: Optional[Iterable[str]] = None,
+    null_required: Optional[Iterable[str]] = None,
+    path: str = "$",
+) -> List[LineageViolation]:
+    """Recursively validate ``payload``.
+
+    Two checks run at every mapping level:
+
+    * **allow-list** -- if ``allowed`` is given, any key outside it is a
+      ``NOT_ON_ALLOW_LIST`` violation. This is the total check.
+    * **lineage** -- every key, at every depth, is tested by
+      :func:`field_name_violation` regardless of the allow-list, so a nested
+      structure cannot smuggle a forbidden name inside a permitted parent.
+
+    The allow-list applies only at the TOP level of ``payload``. At that level
+    the allow-list is AUTHORITATIVE: an allow-list entry is a reviewed,
+    prespecified exception, so its *key name* is not additionally lineage-tested.
+    This is required and not a loophole -- several fields a refused response MUST
+    carry are themselves inside the forbidden lineage by name
+    (``band_status`` contains root ``band``; ``reference_z_rank`` contains root
+    ``zrank``; ``k_day_uncertainty_interval`` has segment ``interval``). Those
+    names are permitted because their *values* are audited constants or nulls,
+    never the withheld quantity. A key NOT on the allow-list gets both
+    ``NOT_ON_ALLOW_LIST`` and the lineage check.
+
+    Top-level keys named in :data:`STATIC_SUBTREE_FIELDS` are not recursed into.
+    Those subtrees are patient-invariant constants (statements, semantics,
+    frozen gate values); the exemption is proved -- not asserted -- by
+    ``test_static_subtrees_are_patient_invariant``, which serialises two
+    DIFFERENT refused patients and asserts each exempt subtree is byte-identical.
+
+    Every OTHER nesting level is lineage-checked unconditionally, so a nested
+    structure cannot smuggle a forbidden name inside a permitted parent.
+    """
+    found: List[LineageViolation] = []
+    allow = None if allowed is None else {str(a) for a in allowed}
+    must_be_null = set() if null_required is None else {str(a) for a in null_required}
+    static = set(STATIC_SUBTREE_FIELDS)
+
+    def walk_deep(node: Any, node_path: str) -> None:
+        """Lineage-check every key at every depth. No allow-list, no exemption."""
+        if isinstance(node, Mapping):
+            for key, value in node.items():
+                child = f"{node_path}.{key}"
+                hit = field_name_violation(str(key))
+                if hit is not None:
+                    found.append(LineageViolation(child, str(key), hit[0], hit[1]))
+                walk_deep(value, child)
+        elif isinstance(node, (list, tuple)):
+            for i, value in enumerate(node):
+                walk_deep(value, f"{node_path}[{i}]")
+
+    if isinstance(payload, Mapping):
+        for key, value in payload.items():
+            name = str(key)
+            child = f"{path}.{name}"
+            on_allow_list = allow is not None and name in allow
+            if allow is not None and not on_allow_list:
+                found.append(
+                    LineageViolation(
+                        child, name, "NOT_ON_ALLOW_LIST",
+                        "field is not one of the fields a refused response may carry",
+                    )
+                )
+            if not on_allow_list:
+                hit = field_name_violation(name)
+                if hit is not None:
+                    found.append(LineageViolation(child, name, hit[0], hit[1]))
+            # A lineage name admitted by the allow-list is admitted as a KEY
+            # only. Any value at all is a leak of the withheld quantity, so this
+            # is the check that makes key retention safe.
+            if name in must_be_null and value is not None:
+                found.append(
+                    LineageViolation(
+                        child, name, "LINEAGE_FIELD_NOT_NULL",
+                        f"percentile-lineage field carries a value ({type(value).__name__}) "
+                        f"in a refused response; it must be a literal null",
+                    )
+                )
+            if name in static:
+                continue
+            walk_deep(value, child)
+    else:
+        walk_deep(payload, path)
+    return found
+
+
+def assert_refusal_schema(
+    payload: Mapping[str, Any],
+    *,
+    allowed: Iterable[str],
+    what: str,
+    null_required: Optional[Iterable[str]] = None,
+) -> None:
+    """Raise :class:`RefusalSchemaError` if a refused ``payload`` violates schema."""
+    violations = lineage_violations(
+        payload, allowed=allowed, null_required=null_required
+    )
+    if violations:
+        rendered = "; ".join(f"{v.path} [{v.rule}] {v.detail}" for v in violations[:12])
+        raise RefusalSchemaError(
+            f"refused {what} carries {len(violations)} prohibited field(s): {rendered}"
+        )
+
+
+def numeric_proximity_probe(
+    payload: Any,
+    target: float,
+    *,
+    tolerance: float = 0.01,
+) -> List[Tuple[str, float]]:
+    """EXPLORATORY DEFENCE-IN-DEPTH ONLY -- NOT A NON-LEAKAGE PROOF.
+
+    Returns every ``(path, value)`` in ``payload`` whose numeric value lies within
+    ``tolerance`` of ``target``. This is a smoke probe for accidental echoes of a
+    withheld value. It is trivially defeated by any monotone transform, it tests
+    one target at one distance, and it says nothing about fields it does not
+    recognise as numeric. A clean result from this function is NOT evidence of
+    non-leakage; only :func:`assert_refusal_schema` speaks to the schema
+    guarantee.
+    """
+    hits: List[Tuple[str, float]] = []
+
+    def walk(node: Any, node_path: str) -> None:
+        if isinstance(node, Mapping):
+            for key, value in node.items():
+                walk(value, f"{node_path}.{key}")
+        elif isinstance(node, (list, tuple)):
+            for i, value in enumerate(node):
+                walk(value, f"{node_path}[{i}]")
+        elif isinstance(node, bool):
+            return
+        elif isinstance(node, (int, float)):
+            try:
+                if abs(float(node) - float(target)) <= tolerance:
+                    hits.append((node_path, float(node)))
+            except (TypeError, ValueError):
+                return
+
+    walk(payload, "$")
+    return hits
