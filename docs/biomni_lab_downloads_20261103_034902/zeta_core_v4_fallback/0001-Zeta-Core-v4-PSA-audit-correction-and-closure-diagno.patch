index 00000000..493cb4a5
--- /dev/null
+++ b/scripts/validation/survival_metrics.py
@@ -0,0 +1,350 @@
+"""Hand-implemented right-censored survival metrics for the Zeta-Core v4 B1 transport.
+
+``scikit-survival`` is absent from the service environment, so these are
+implemented from the published estimator definitions and validated against
+scikit-survival in an isolated environment before any B1 result is trusted
+(Audit Correction Directive item 9). Closed-form and no-censoring tests alone
+are explicitly insufficient.
+
+Estimators implemented
+----------------------
+* ``kaplan_meier`` -- standard product-limit estimator, right-continuous.
+* ``censoring_survival`` -- Kaplan-Meier of the CENSORING distribution
+  ``G(t) = P(C > t)``, obtained by flipping the event indicator.
+* ``brier_score`` -- inverse-probability-of-censoring-weighted (Graf) Brier
+  score at fixed horizons.
+* ``integrated_brier_score`` -- trapezoidal integral of the above over the
+  horizon grid, normalised by the grid width.
+* ``cumulative_dynamic_auc`` -- Uno's IPCW time-dependent cumulative/dynamic
+  AUC, plus the survival-weighted mean AUC summary.
+
+Conventions that matter for exact agreement
+-------------------------------------------
+1. The censoring distribution is estimated on the TRAINING sample and then
+   evaluated on the test sample. This is what makes the weights independent of
+   the predictions being scored.
+2. ``G`` is a right-continuous step function: ``G(t)`` takes the value carried
+   by the largest jump point ``<= t``.
+3. Subjects censored at or before the horizon contribute weight zero to the
+   Brier score. They are neither cases nor controls at that horizon; dropping
+   them without reweighting would be the naive (biased) Brier score.
+4. Tied risk scores contribute 0.5 to the AUC concordance numerator.
+5. ``estimate`` for the Brier score is a SURVIVAL probability ``S(t|x)``;
+   ``estimate`` for the AUC is a RISK score (higher = worse). Passing one where
+   the other is expected silently inverts the AUC, so the argument names differ.
+
+Stdlib + numpy only. No production serving code imports this module.
+"""
+from __future__ import annotations
+
+from typing import Optional, Sequence, Tuple
+
+import numpy as np
+
+__all__ = [
+    "StepFunction",
+    "kaplan_meier",
+    "censoring_survival",
+    "ipcw_weights",
+    "brier_score",
+    "integrated_brier_score",
+    "cumulative_dynamic_auc",
+]
+
+
+class StepFunction:
+    """Right-continuous step function on a sorted jump grid.
+
+    ``__call__(t)`` returns the value carried by the largest jump point ``<= t``,
+    and ``baseline`` for ``t`` strictly below the first jump point.
+    """
+
+    def __init__(self, x: np.ndarray, y: np.ndarray, baseline: float = 1.0) -> None:
+        x = np.asarray(x, dtype=float)
+        y = np.asarray(y, dtype=float)
+        if x.ndim != 1 or y.ndim != 1 or x.shape != y.shape:
+            raise ValueError("x and y must be 1-D arrays of equal length")
+        if np.any(np.diff(x) <= 0):
+            raise ValueError("x must be strictly increasing")
+        self.x = x
+        self.y = y
+        self.baseline = float(baseline)
+
+    def __call__(self, t) -> np.ndarray:
+        t_arr = np.atleast_1d(np.asarray(t, dtype=float))
+        # searchsorted 'right' then -1 gives the index of the largest x <= t.
+        idx = np.searchsorted(self.x, t_arr, side="right") - 1
+        out = np.empty(t_arr.shape, dtype=float)
+        below = idx < 0
+        out[below] = self.baseline
+        out[~below] = self.y[idx[~below]]
+        return out if np.ndim(t) else out[0]
+
+
+def _check_survival(time: Sequence[float], event: Sequence[bool]) -> Tuple[np.ndarray, np.ndarray]:
+    t = np.asarray(time, dtype=float)
+    e = np.asarray(event)
+    if e.dtype != bool:
+        # Accept 0/1 numerics but refuse anything that is not exactly 0 or 1.
+        e_num = np.asarray(event, dtype=float)
+        if not np.all(np.isin(e_num, (0.0, 1.0))):
+            raise ValueError("event must be boolean or contain only 0 and 1")
+        e = e_num.astype(bool)
+    if t.shape != e.shape or t.ndim != 1:
+        raise ValueError("time and event must be 1-D arrays of equal length")
+    if not np.all(np.isfinite(t)):
+        raise ValueError("time must be finite")
+    if np.any(t < 0):
+        raise ValueError("time must be non-negative")
+    return t, e
+
+
+def kaplan_meier(
+    time: Sequence[float], event: Sequence[bool]
+) -> Tuple[np.ndarray, np.ndarray]:
+    """Product-limit estimator. Returns ``(unique_event_times, survival)``.
+
+    Only times with at least one event produce a jump, matching the standard
+    definition; censorings reduce the risk set without creating a jump.
+    """
+    t, e = _check_survival(time, event)
+    uniq = np.unique(t)
+    n_at_risk = np.array([np.sum(t >= u) for u in uniq], dtype=float)
+    n_events = np.array([np.sum((t == u) & e) for u in uniq], dtype=float)
+    keep = n_events > 0
+    factors = 1.0 - n_events[keep] / n_at_risk[keep]
+    return uniq[keep], np.cumprod(factors)
+
+
+def censoring_survival(
+    time: Sequence[float], event: Sequence[bool]
+) -> StepFunction:
+    """Kaplan-Meier estimate of ``G(t) = P(C > t)``, the censoring survival.
+
+    TIE CONVENTION -- load-bearing, and NOT the same as flipping the event
+    indicator and calling :func:`kaplan_meier`. At a time carrying both events
+    and censorings, the events are removed from the risk set BEFORE the
+    censoring hazard is formed::
+
+        G(t) = prod_{t_i <= t} ( 1 - c_i / (n_i - d_i) )
+
+    where ``n_i`` is the number at risk at ``t_i``, ``d_i`` the events at
+    ``t_i`` and ``c_i`` the censorings at ``t_i``. This encodes the standard
+    IPCW assumption that events precede censorings at tied times.
+
+    The naive alternative -- ``kaplan_meier(time, ~event)``, which leaves the
+    events in the censoring risk set -- was the original implementation here and
+    was caught disagreeing with scikit-survival by 2.8e-02 on the Brier score
+    for a fixture with tied event times, while agreeing to 1e-16 on every
+    fixture with distinct times. Tied event times are common whenever survival
+    is derived from whole days or weeks, so this is not an edge case for this
+    programme.
+    """
+    t, e = _check_survival(time, event)
+    if e.all():
+        # No censoring anywhere: G(t) == 1 identically. Returning a degenerate
+        # single-knot step function keeps the caller's arithmetic unchanged.
+        return StepFunction(np.array([np.min(t)]), np.array([1.0]), baseline=1.0)
+    uniq = np.unique(t)
+    n_at_risk = np.array([np.sum(t >= u) for u in uniq], dtype=float)
+    n_events = np.array([np.sum((t == u) & e) for u in uniq], dtype=float)
+    n_censored = np.array([np.sum((t == u) & ~e) for u in uniq], dtype=float)
+    denominator = n_at_risk - n_events
+    ratio = np.zeros(uniq.shape[0], dtype=float)
+    np.divide(n_censored, denominator, out=ratio, where=n_censored != 0)
+    return StepFunction(uniq, np.cumprod(1.0 - ratio), baseline=1.0)
+
+
+def ipcw_weights(
+    train_time: Sequence[float],
+    train_event: Sequence[bool],
+    test_time: Sequence[float],
+    test_event: Sequence[bool],
+) -> np.ndarray:
+    """``1/G(T_i)`` for subjects with an observed event, ``0`` for censored ones.
+
+    Raises if any event time falls where the estimated censoring survival is
+    zero, because the implied weight is infinite; silently returning ``inf``
+    would propagate into a metric that then looks merely large rather than
+    undefined.
+    """
+    g = censoring_survival(train_time, train_event)
+    t, e = _check_survival(test_time, test_event)
+    weights = np.zeros(t.shape[0], dtype=float)
+    if np.any(e):
+        g_at_event = g(t[e])
+        if np.any(g_at_event <= 0.0):
+            raise ValueError(
+                "estimated censoring survival is zero at an event time; the IPCW "
+                "weight is undefined. Restrict the horizon grid to the region "
+                "where the censoring distribution is estimable."
+            )
+        weights[e] = 1.0 / g_at_event
+    return weights
+
+
+def brier_score(
+    train_time: Sequence[float],
+    train_event: Sequence[bool],
+    test_time: Sequence[float],
+    test_event: Sequence[bool],
+    survival_estimate: np.ndarray,
+    times: Sequence[float],
+) -> Tuple[np.ndarray, np.ndarray]:
+    """IPCW (Graf) Brier score at each horizon.
+
+    ``survival_estimate`` is ``(n_test, n_times)`` predicted SURVIVAL
+    probabilities ``S(t|x)``.
+
+    At horizon ``t`` each subject falls in exactly one of three groups:
+
+    * case      -- observed event at or before ``t``; residual ``(0 - S)^2``,
+                   weight ``1/G(T_i)``
+    * control   -- still at risk after ``t``; residual ``(1 - S)^2``,
+                   weight ``1/G(t)``
+    * censored  -- censored at or before ``t``; weight ``0``
+
+    The mean is taken over ALL test subjects, including the zero-weight ones.
+    That is what makes the estimator consistent for the true Brier score rather
+    than for the Brier score among the uncensored.
+    """
+    t_test, e_test = _check_survival(test_time, test_event)
+    horizons = np.asarray(times, dtype=float)
+    if horizons.ndim != 1:
+        raise ValueError("times must be 1-D")
+    estimate = np.asarray(survival_estimate, dtype=float)
+    if estimate.shape != (t_test.shape[0], horizons.shape[0]):
+        raise ValueError(
+            f"survival_estimate must have shape (n_test, n_times) = "
+            f"({t_test.shape[0]}, {horizons.shape[0]}); got {estimate.shape}"
+        )
+
+    g = censoring_survival(train_time, train_event)
+    weights_event = ipcw_weights(train_time, train_event, t_test, e_test)
+
+    scores = np.empty(horizons.shape[0], dtype=float)
+    for i, horizon in enumerate(horizons):
+        est = estimate[:, i]
+        is_case = (t_test <= horizon) & e_test
+        is_control = t_test > horizon
+        g_at_horizon = float(g(horizon))
+        if is_control.any() and g_at_horizon <= 0.0:
+            raise ValueError(
+                f"estimated censoring survival is zero at horizon {horizon}; "
+                "the control weight is undefined"
+            )
+        weights = np.zeros_like(est)
+        weights[is_case] = weights_event[is_case]
+        if is_control.any():
+            weights[is_control] = 1.0 / g_at_horizon
+        residual = is_control.astype(float) - est
+        scores[i] = float(np.mean(np.square(residual) * weights))
+    return horizons, scores
+
+
+def integrated_brier_score(
+    train_time: Sequence[float],
+    train_event: Sequence[bool],
+    test_time: Sequence[float],
+    test_event: Sequence[bool],
+    survival_estimate: np.ndarray,
+    times: Sequence[float],
+) -> float:
+    """Trapezoidal integral of the IPCW Brier score, divided by the grid width.
+
+    Requires at least two horizons; a single-point "integral" would be a
+    silently mislabelled point score.
+    """
+    horizons, scores = brier_score(
+        train_time, train_event, test_time, test_event, survival_estimate, times
+    )
+    if horizons.shape[0] < 2:
+        raise ValueError("integrated_brier_score requires at least two horizons")
+    span = horizons[-1] - horizons[0]
+    if span <= 0:
+        raise ValueError("horizon grid must be strictly increasing")
+    return float(np.trapezoid(scores, horizons) / span)
+
+
+def cumulative_dynamic_auc(
+    train_time: Sequence[float],
+    train_event: Sequence[bool],
+    test_time: Sequence[float],
+    test_event: Sequence[bool],
+    risk_estimate: np.ndarray,
+    times: Sequence[float],
+) -> Tuple[np.ndarray, float]:
+    """Uno's IPCW time-dependent cumulative/dynamic AUC.
+
+    ``risk_estimate`` is either ``(n_test,)`` (one time-invariant risk score) or
+    ``(n_test, n_times)``. HIGHER means WORSE survival.
+
+    At horizon ``t``::
+
+        cases    = {i : T_i <= t, delta_i = 1}   weighted by  1/G(T_i)
+        controls = {j : T_j >  t}                weight 1
+
+        AUC(t) = sum_i sum_j w_i * [ I(f_i > f_j) + 0.5 * I(f_i == f_j) ]
+                 / ( sum_i w_i * n_controls )
+
+    The returned summary is the survival-weighted mean
+
+        mean_auc = sum_k AUC(t_k) * (S(t_{k-1}) - S(t_k)) / (1 - S(t_max))
+
+    with ``S`` the Kaplan-Meier estimate of the EVENT-time distribution on the
+    test sample. This weights each horizon by the probability mass of events it
+    actually covers, so a horizon at which almost nothing happens cannot
+    dominate the summary.
+    """
+    t_test, e_test = _check_survival(test_time, test_event)
+    horizons = np.asarray(times, dtype=float)
+    if horizons.ndim != 1:
+        raise ValueError("times must be 1-D")
+    scores = np.asarray(risk_estimate, dtype=float)
+    if scores.ndim == 1:
+        scores = np.tile(scores[:, None], (1, horizons.shape[0]))
+    if scores.shape != (t_test.shape[0], horizons.shape[0]):
+        raise ValueError(
+            f"risk_estimate must have shape (n_test,) or (n_test, n_times) = "
+            f"({t_test.shape[0]}, {horizons.shape[0]}); got {scores.shape}"
+        )
+
+    weights_event = ipcw_weights(train_time, train_event, t_test, e_test)
+
+    aucs = np.empty(horizons.shape[0], dtype=float)
+    for i, horizon in enumerate(horizons):
+        f = scores[:, i]
+        is_case = (t_test <= horizon) & e_test
+        is_control = t_test > horizon
+        n_control = int(np.sum(is_control))
+        w_case = weights_event[is_case]
+        if n_control == 0 or w_case.size == 0 or w_case.sum() <= 0.0:
+            aucs[i] = np.nan
+            continue
+        f_case = f[is_case]
+        f_control = f[is_control]
+        # Vectorised over the case x control grid.
+        greater = (f_case[:, None] > f_control[None, :]).sum(axis=1).astype(float)
+        equal = (f_case[:, None] == f_control[None, :]).sum(axis=1).astype(float)
+        concordant = greater + 0.5 * equal
+        aucs[i] = float(np.sum(w_case * concordant) / (w_case.sum() * n_control))
+
+    # Survival-weighted summary over the horizon grid.
+    km_x, km_y = kaplan_meier(t_test, e_test)
+    surv = StepFunction(km_x, km_y, baseline=1.0)
+    s_at = surv(horizons)
+    if horizons.shape[0] == 1:
+        mean_auc = float(aucs[0])
+    else:
+        # Left neighbour of S on the horizon grid; S is 1 before the first horizon.
+        s_prev = np.empty_like(s_at)
+        s_prev[0] = 1.0
+        s_prev[1:] = s_at[:-1]
+        mass = s_prev - s_at
+        denominator = 1.0 - s_at[-1]
+        finite = np.isfinite(aucs)
+        if denominator <= 0.0 or not finite.any():
+            mean_auc = float("nan")
+        else:
+            mean_auc = float(np.sum(aucs[finite] * mass[finite]) / denominator)
+    return aucs, mean_auc
