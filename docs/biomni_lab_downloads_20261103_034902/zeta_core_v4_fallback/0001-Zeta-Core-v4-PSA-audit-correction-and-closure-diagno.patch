+        decline_sign_stability=sign_stability,
+        percentile_interval_width=width,
+        boundary_crossing_probability=crossing,
+    )
+    reasons: List[str] = []
+    if sign_stability is not None and (
+        sign_stability < FIT_PRECISION_MIN_DECLINE_SIGN_STABILITY
+    ):
+        reasons.append(
+            f"decline sign stable in {sign_stability:.4f} of usable replicates, "
+            f"below {FIT_PRECISION_MIN_DECLINE_SIGN_STABILITY}"
+        )
+    if width > FIT_PRECISION_MAX_PERCENTILE_INTERVAL_WIDTH:
+        reasons.append(
+            f"percentile interval width {width:.4f} exceeds "
+            f"{FIT_PRECISION_MAX_PERCENTILE_INTERVAL_WIDTH}"
+        )
+    if crossing > FIT_PRECISION_MAX_BOUNDARY_CROSSING_PROBABILITY:
+        reasons.append(
+            f"exploratory-cut crossing probability {crossing:.4f} exceeds "
+            f"{FIT_PRECISION_MAX_BOUNDARY_CROSSING_PROBABILITY}"
+        )
+
+    return FitPrecisionReport(
+        status=status,
+        k_day_uncertainty_interval=k_interval,
+        percentile_uncertainty_interval=percentile_interval,
+        multiplier_uncertainty_interval=multiplier_interval,
+        decline_sign_stability=sign_stability,
+        boundary_crossing_probability=crossing,
+        percentile_interval_width=width,
+        z_rank_uncertainty_interval=z_interval,
+        k_day_bootstrap_sd=_sample_sd(positive_k),
+        boundary_crossing_probability_unconditional=crossing_unconditional,
+        status_reason="; ".join(reasons) if reasons else None,
+        **base,
+    )
