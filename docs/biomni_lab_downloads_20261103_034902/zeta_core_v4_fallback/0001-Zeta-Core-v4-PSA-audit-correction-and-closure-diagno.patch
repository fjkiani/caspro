diff --git a/api/services/tumor_marker_kinetics/fit_precision.py b/api/services/tumor_marker_kinetics/fit_precision.py
new file mode 100644
index 00000000..922242c7
--- /dev/null
+++ b/api/services/tumor_marker_kinetics/fit_precision.py
@@ -0,0 +1,761 @@
+"""Individual PSA-rate fit precision by within-patient resampling.
+
+Stdlib only, consistent with the rest of this package.
+
+WHY THIS MODULE EXISTS. The Phase A release emitted a single interval,
+``exp(beta_low * z)``..``exp(beta_high * z)``, which propagates uncertainty in
+the frozen Cox coefficient and NOTHING ELSE. It is silent about the uncertainty
+that dominates for most patients: the uncertainty in the patient's own PSA-rate
+estimate, which is fitted from a handful of early observations. In the frozen
+reference cohort the individual-rate component is the widest of the three
+components for 292 of 412 patients with estimable uncertainty, and the
+coefficient-only interval collapses to essentially zero width at ``z_rank = 0``
+because its standard deviation is exactly ``|z_rank| * SE``. A patient sitting
+at the reference median therefore received the *narrowest* interval in the whole
+release at the point where the index carries the least information.
+
+WHAT THIS MODULE COMPUTES. Component C of the uncertainty decomposition: the
+sampling distribution of one patient's ``k_day`` under resampling of that
+patient's own distinct analysis days, holding the frozen reference distribution
+and the frozen coefficient fixed. It is NOT a joint interval. It excludes the
+coefficient component, the reference-CDF component, assay measurement bias and
+model misspecification.
+
+THE DESIGN IS FROZEN, NOT CHOSEN HERE. Resampling unit, replicate count, seed,
+replicate-rejection rule, interval probability, the four status names and all
+five thresholds come from the audit-correction prespecification that was hashed
+before any of these numbers were computed. This module implements that
+specification; it does not select it.
+
+ESTIMATOR MIRRORING. Each replicate refits the *same* estimator that produced
+the served point value: ordinary least squares of natural-log marker on day,
+plateau fixed at zero, duplicate days collapsed by median BEFORE resampling.
+``collapse_distinct_days`` and ``negative_ols_slope`` reproduce
+``universal_decay_fitter.fit_first_order_decay`` operation for operation, and
+``bootstrap_fit_precision`` verifies that the mirror reproduces the served
+``k_day`` before it reports any uncertainty. If it does not, the caller fails
+closed rather than describing the spread of a different estimator.
+
+RANDOM STREAM PROVENANCE. Replicate day indices come from CPython's
+``random.Random`` (Mersenne Twister) seeded with the frozen seed, so a given
+observation series always yields the same intervals. The validation receipt for
+the reference cohort was produced with NumPy's PCG64 stream under the same
+design, so per-patient quantiles are Monte-Carlo equivalent rather than bitwise
+identical between the two; ``scripts/validation/d5_runtime_equivalence.py``
+quantifies the resulting status agreement across the reference cohort.
+"""
+from __future__ import annotations
+
+import math
+import random
+from dataclasses import fields as dataclass_fields
+from typing import Any, Dict, Iterable, List, Optional, Sequence, Tuple
+
+from api.services.tumor_marker_kinetics.models import (
+    FIT_PRECISION_BOOTSTRAP_B,
+    FIT_PRECISION_BOOTSTRAP_SEED,
+    FIT_PRECISION_INTERVAL_LOWER_PERCENT,
+    FIT_PRECISION_INTERVAL_UPPER_PERCENT,
+    FIT_PRECISION_MAX_BOUNDARY_CROSSING_PROBABILITY,
+    FIT_PRECISION_MAX_PERCENTILE_INTERVAL_WIDTH,
+    FIT_PRECISION_MIN_DECLINE_SIGN_STABILITY,
+    FIT_PRECISION_MIN_DISTINCT_DAYS,
+    FIT_PRECISION_MIN_FINITE_REPLICATE_FRACTION,
+    FIT_PRECISION_MIN_DISTINCT_DAYS_PER_REPLICATE,
+    FIT_PRECISION_POINT_REPRODUCTION_RELATIVE_TOLERANCE,
+    FIT_PRECISION_RECEIPT_REDACTED_ON_INELIGIBLE,
+    FIT_PRECISION_RECEIPT_SCOPE_STATEMENT,
+    LOO_SIGN_ESTABLISHMENT_RULE_NAME,
+    THREE_OBSERVATION_TRIGGER_DISTINCT_DAYS,
+    PROGNOSTIC_EARLY_WINDOW_END_DAY,
+    PROGNOSTIC_EARLY_WINDOW_START_DAY,
+    PROGNOSTIC_POSITIVE_FLOOR,
+    PROSTATE_PSA_COX_BETA,
+    FitPrecisionReport,
+    FitPrecisionStatus,
+)
+from api.services.tumor_marker_kinetics.prognostic_index import (
+    normal_ppf,
+    exploratory_relative_prognostic_band,
+)
+from api.services.tumor_marker_kinetics.reference_cdf import (
+    ReferenceCDF,
+    ReferenceCDFError,
+    load_reference_cdf,
+)
+
+_EPS = 2.220446049250313e-16  # numpy.finfo(float).eps, as in the production fitter
+
+
+# ---------------------------------------------------------------------------
+# Estimator mirror: filter, collapse, ordinary least squares
+# ---------------------------------------------------------------------------
+def _to_float(value: Any) -> float:
+    """Identical coercion to ``universal_decay_fitter._to_float``."""
+    if value is None or isinstance(value, bool):
+        return float("nan")
+    if isinstance(value, (int, float)):
+        return float(value)
+    text = str(value).strip()
+    if not text:
+        return float("nan")
+    try:
+        return float(text)
+    except ValueError:
+        return float("nan")
+
+
+def _median(values: Sequence[float]) -> float:
+    """Identical to ``universal_decay_fitter._median`` (order independent)."""
+    ordered = sorted(values)
+    n = len(ordered)
+    mid = n // 2
+    if n % 2 == 1:
+        return float(ordered[mid])
+    return float((ordered[mid - 1] + ordered[mid]) / 2.0)
+
+
+def collapse_distinct_days(
+    time_days: Iterable[Any],
+    marker_values: Iterable[Any],
+    *,
+    early_window_start_day: float = PROGNOSTIC_EARLY_WINDOW_START_DAY,
+    early_window_end_day: float = PROGNOSTIC_EARLY_WINDOW_END_DAY,
+    positive_floor: float = PROGNOSTIC_POSITIVE_FLOOR,
+) -> List[Tuple[float, float]]:
+    """In-window observations, one row per distinct day, collapsed by median.
+
+    Mirrors the production fitter's admission rules exactly: a non-finite time,
+    a non-finite value, a value at or below the positive floor and a time
+    outside the locked early window are each dropped, then duplicate days are
+    collapsed by median. The result is sorted by day, so downstream summation
+    order is a function of the data alone and not of the caller's row order.
+    """
+    times = [_to_float(t) for t in time_days]
+    values = [_to_float(v) for v in marker_values]
+    if len(times) != len(values):
+        raise ValueError("time_days and marker_values must have equal length")
+
+    grouped: Dict[float, List[float]] = {}
+    for t, v in zip(times, values):
+        if not math.isfinite(t):
+            continue
+        if not math.isfinite(v):
+            continue
+        if not v > positive_floor:
+            continue
+        if not (t >= early_window_start_day and t <= early_window_end_day):
+            continue
+        grouped.setdefault(t, []).append(v)
+    return [(t, _median(grouped[t])) for t in sorted(grouped)]
+
+
+def negative_ols_slope(x: Sequence[float], y: Sequence[float]) -> Optional[float]:
+    """``k = -slope`` of ``y ~ a + slope * x``, or ``None`` if rank deficient.
+
+    The summation order is the production fitter's order, so calling this on the
+    full collapsed series reproduces the served ``k_day`` bit for bit.
+    """
+    n = len(x)
+    if n < 2:
+        return None
+    x_mean = sum(x) / n
+    y_mean = sum(y) / n
+    sxx = sum((xi - x_mean) ** 2 for xi in x)
+    if sxx <= 0.0:
+        return None
+    sxy = sum((xi - x_mean) * (yi - y_mean) for xi, yi in zip(x, y))
+    slope = sxy / sxx
+    k = -slope
+    return k if math.isfinite(k) else None
+
+
+# ---------------------------------------------------------------------------
+# The three-observation rule (prespecification v2 addendum, item 3)
+# ---------------------------------------------------------------------------
+def loo_sign_establishment(
+    collapsed: Sequence[Tuple[float, float]],
+    *,
+    positive_floor: float = PROGNOSTIC_POSITIVE_FLOOR,
+) -> Dict[str, Any]:
+    """Decide the decline sign at exactly three distinct days, deterministically.
+
+    The day-level bootstrap cannot arbitrate here. Prespecification v1 sets
+    ``min_distinct_days_for_uncertainty = 4``, so ``decline_sign_stability`` is
+    undefined at three days: a three-day day-level resample draws at most three
+    distinct days and its replicate slopes are not independent of the point fit
+    in any usable way. So the prespecification v2 addendum froze a deterministic
+    rule instead, BEFORE the rule was ever evaluated on VENICE.
+
+    The rule (``LOO_SIGN_ESTABLISHMENT``): log the floored, day-collapsed value,
+    form all three leave-one-out two-point OLS slopes, and require that EVERY one
+    of them be strictly negative in log space -- equivalently that every
+    leave-one-out ``k`` be strictly positive. One non-declining pair is enough to
+    fail, because with three points a single pair carries a third of the
+    evidence and the sign would then rest on the point fit alone.
+
+    Returns a mapping with ``established``, ``rule``, ``negative_slope_count``,
+    ``n_slopes`` and ``loo_k_values``. ``established`` is ``None`` when the rule
+    does not apply (any count other than three distinct days), so a caller can
+    never read "not established" as "tested and failed".
+    """
+    if len(collapsed) != THREE_OBSERVATION_TRIGGER_DISTINCT_DAYS:
+        return {
+            "established": None,
+            "rule": None,
+            "negative_slope_count": None,
+            "n_slopes": None,
+            "loo_k_values": None,
+        }
+
+    days = [float(t) for t, _ in collapsed]
+    logs = [math.log(max(float(v), positive_floor)) for _, v in collapsed]
+
+    loo_k: List[Optional[float]] = []
+    for drop in range(THREE_OBSERVATION_TRIGGER_DISTINCT_DAYS):
+        x = [days[i] for i in range(len(days)) if i != drop]
+        y = [logs[i] for i in range(len(logs)) if i != drop]
+        loo_k.append(negative_ols_slope(x, y))
+
+    # k = -slope, so "slope strictly negative" is exactly "k strictly positive".
+    # A ``None`` slope (rank deficient pair) counts as NOT negative: it is an
+    # absence of evidence, and the rule requires positive evidence from all three.
+    negative = sum(1 for k in loo_k if k is not None and k > 0.0)
+    return {
+        "established": negative == THREE_OBSERVATION_TRIGGER_DISTINCT_DAYS,
+        "rule": LOO_SIGN_ESTABLISHMENT_RULE_NAME,
+        "negative_slope_count": negative,
+        "n_slopes": THREE_OBSERVATION_TRIGGER_DISTINCT_DAYS,
+        "loo_k_values": tuple(loo_k),
+    }
+
+
+# ---------------------------------------------------------------------------
+# Quantiles and dispersion, matching the validation implementation
+# ---------------------------------------------------------------------------
+def linear_quantile(sorted_values: Sequence[float], percent: float) -> float:
+    """``numpy.percentile(..., method='linear')`` on an already sorted sequence."""
+    n = len(sorted_values)
+    if n == 0:
+        raise ValueError("linear_quantile requires at least one value")
+    if n == 1:
+        return float(sorted_values[0])
+    h = (n - 1) * (float(percent) / 100.0)
+    lo = math.floor(h)
+    hi = math.ceil(h)
+    low = float(sorted_values[int(lo)])
+    if lo == hi:
+        return low
+    high = float(sorted_values[int(hi)])
+    return low + (h - lo) * (high - low)
+
+
+def _sample_sd(values: Sequence[float]) -> Optional[float]:
+    """Sample standard deviation with one degree of freedom removed."""
+    n = len(values)
+    if n < 2:
+        return None
+    mean = sum(values) / n
+    variance = sum((v - mean) ** 2 for v in values) / (n - 1)
+    return math.sqrt(variance) if variance >= 0.0 else None
+
+
+def _interval(sorted_values: Sequence[float]) -> Tuple[float, float]:
+    return (
+        linear_quantile(sorted_values, FIT_PRECISION_INTERVAL_LOWER_PERCENT),
+        linear_quantile(sorted_values, FIT_PRECISION_INTERVAL_UPPER_PERCENT),
+    )
+
+
+# ---------------------------------------------------------------------------
+# Status assignment: exactly the frozen definitions, in the frozen order
+# ---------------------------------------------------------------------------
+def assign_fit_precision_status(
+    *,
+    n_distinct_days: int,
+    finite_replicate_fraction: Optional[float],
+    decline_sign_stability: Optional[float],
+    percentile_interval_width: Optional[float],
+    boundary_crossing_probability: Optional[float],
+) -> str:
+    """Evaluate the frozen status definitions in the frozen order.
+
+    Order is load bearing. An unusable resample is reported as insufficient
+    rather than as unstable, and an unstable sign is reported before any
+    statement about precision, because the width of an interval around a rate
+    whose sign is not settled is not a meaningful precision statement.
+    """
+    if n_distinct_days < FIT_PRECISION_MIN_DISTINCT_DAYS:
+        return FitPrecisionStatus.INSUFFICIENT_FOR_UNCERTAINTY.value
+    if finite_replicate_fraction is None or not math.isfinite(
+        finite_replicate_fraction
+    ):
+        return FitPrecisionStatus.INSUFFICIENT_FOR_UNCERTAINTY.value
+    if finite_replicate_fraction < FIT_PRECISION_MIN_FINITE_REPLICATE_FRACTION:
+        return FitPrecisionStatus.INSUFFICIENT_FOR_UNCERTAINTY.value
+    if decline_sign_stability is None or not math.isfinite(decline_sign_stability):
+        return FitPrecisionStatus.SIGN_UNSTABLE.value
+    if decline_sign_stability < FIT_PRECISION_MIN_DECLINE_SIGN_STABILITY:
+        return FitPrecisionStatus.SIGN_UNSTABLE.value
+    if percentile_interval_width is None or not math.isfinite(
+        percentile_interval_width
+    ):
+        return FitPrecisionStatus.IMPRECISE.value
+    if percentile_interval_width > FIT_PRECISION_MAX_PERCENTILE_INTERVAL_WIDTH:
+        return FitPrecisionStatus.IMPRECISE.value
+    if boundary_crossing_probability is None or not math.isfinite(
+        boundary_crossing_probability
+    ):
+        return FitPrecisionStatus.IMPRECISE.value
+    if boundary_crossing_probability > FIT_PRECISION_MAX_BOUNDARY_CROSSING_PROBABILITY:
+        return FitPrecisionStatus.IMPRECISE.value
+    return FitPrecisionStatus.RELIABLE.value
+
+
+def fit_precision_design() -> Dict[str, Any]:
+    """The frozen design, emitted so a consumer can audit the numbers."""
+    return {
+        "component": "individual_rate_estimation_only",
+        "resampling_unit": "distinct analysis day within the locked early window",
+        "with_replacement": True,
+        "replicates": FIT_PRECISION_BOOTSTRAP_B,
+        "seed": FIT_PRECISION_BOOTSTRAP_SEED,
+        "random_stream": "CPython random.Random (Mersenne Twister)",
+        "duplicate_days_collapsed_before_resampling": True,
+        "replicate_rejected_if": (
+            "non-finite k_day, or fewer than "
+            f"{FIT_PRECISION_MIN_DISTINCT_DAYS_PER_REPLICATE} distinct days drawn"
+        ),
+        "interval_percentiles": [
+            FIT_PRECISION_INTERVAL_LOWER_PERCENT,
+            FIT_PRECISION_INTERVAL_UPPER_PERCENT,
+        ],
+        "intervals_computed_over": "positive finite replicates only",
+        "thresholds": {
+            "min_distinct_days_for_uncertainty": FIT_PRECISION_MIN_DISTINCT_DAYS,
+            "min_finite_replicate_fraction": (
+                FIT_PRECISION_MIN_FINITE_REPLICATE_FRACTION
+            ),
+            "min_decline_sign_stability": FIT_PRECISION_MIN_DECLINE_SIGN_STABILITY,
+            "max_percentile_interval_width": (
+                FIT_PRECISION_MAX_PERCENTILE_INTERVAL_WIDTH
+            ),
+            "max_boundary_crossing_probability": (
+                FIT_PRECISION_MAX_BOUNDARY_CROSSING_PROBABILITY
+            ),
+        },
+        "status_order": [
+            FitPrecisionStatus.INSUFFICIENT_FOR_UNCERTAINTY.value,
+            FitPrecisionStatus.SIGN_UNSTABLE.value,
+            FitPrecisionStatus.IMPRECISE.value,
+            FitPrecisionStatus.RELIABLE.value,
+        ],
+        "excludes": [
+            "frozen Cox coefficient uncertainty",
+            "frozen reference distribution uncertainty",
+            "assay measurement bias",
+            "model misspecification",
+            "observation-schedule effects",
+        ],
+        "not_a_joint_interval": True,
+        "not_a_band_activation_gate": True,
+    }
+
+
+# ---------------------------------------------------------------------------
+# Wire form of the receipt
+#
+# The receipt is an audit surface, not a released output, and it is built from
+# the same report object the prognostic index consumed. When that index was
+# refused, the report still holds the percentile, z_rank, multiplier and
+# band-crossing spreads that the refusal withheld, and emitting them unchanged
+# would hand a consumer the midpoint of the very quantity the block nulled. So
+# the wire form redacts those fields, records which ones it redacted and states
+# the scope of the guarantee without overstating it.
+# ---------------------------------------------------------------------------
+def released_fit_precision_receipt(
+    report: FitPrecisionReport, *, index_eligible: bool
+) -> Dict[str, Any]:
+    """Wire form of one fit-precision report, redacted when the index is refused.
+
+    ``index_eligible`` is the eligibility of the relative prognostic index that
+    consumed this report, not a property of the report. A perfectly ``RELIABLE``
+    rate fit still yields a redacted receipt when the index was refused for
+    landmark scope, because the refusal is about what the response may release.
+
+    The returned key set is identical on both paths, so a consumer never has to
+    branch on presence, and a test can assert exact key equality.
+    """
+    payload = report.to_dict()
+    redacted: List[str] = []
+    if not index_eligible:
+        for key in FIT_PRECISION_RECEIPT_REDACTED_ON_INELIGIBLE:
+            if key not in payload:
+                raise KeyError(
+                    f"receipt redaction list names {key!r}, which is not a "
+                    f"field of FitPrecisionReport"
+                )
+            if payload[key] is not None:
+                redacted.append(key)
+            payload[key] = None
+    payload["receipt_redacted"] = bool(redacted)
+    payload["redacted_fields"] = redacted
+    payload["receipt_scope_statement"] = FIT_PRECISION_RECEIPT_SCOPE_STATEMENT
+    return payload
+
+
+#: Exact wire key set of the fit-precision receipt, on either path: every field
+#: of the report plus the three redaction-provenance keys.
+FIT_PRECISION_RECEIPT_KEYS = tuple(
+    sorted(
+        {field.name for field in dataclass_fields(FitPrecisionReport)}
+        | {"receipt_redacted", "redacted_fields", "receipt_scope_statement"}
+    )
+)
+
+
+# ---------------------------------------------------------------------------
+# The entry point
+# ---------------------------------------------------------------------------
+def insufficient_report(
+    reason: str, *, n_distinct_days: int = 0, n_observations_in_window: int = 0
+) -> FitPrecisionReport:
+    """A report that carries a status and no uncertainty numbers."""
+    return FitPrecisionReport(
+        status=FitPrecisionStatus.INSUFFICIENT_FOR_UNCERTAINTY.value,
+        k_day_uncertainty_interval=None,
+        percentile_uncertainty_interval=None,
+        multiplier_uncertainty_interval=None,
+        decline_sign_stability=None,
+        boundary_crossing_probability=None,
+        n_distinct_days=int(n_distinct_days),
+        n_observations_in_window=int(n_observations_in_window),
+        n_replicates=0,
+        n_usable_replicates=0,
+        n_positive_finite_replicates=0,
+        finite_replicate_fraction=None,
+        percentile_interval_width=None,
+        z_rank_uncertainty_interval=None,
+        k_day_bootstrap_sd=None,
+        boundary_crossing_probability_unconditional=None,
+        point_k_day_reproduced=None,
+        point_k_day_reproduced_bitwise=None,
+        status_reason=reason,
+    )
+
+
+def bootstrap_fit_precision(
+    *,
+    time_days: Optional[Iterable[Any]],
+    marker_values: Optional[Iterable[Any]],
+    k_day: Optional[float],
+    reference: Optional[ReferenceCDF] = None,
+    early_window_start_day: float = PROGNOSTIC_EARLY_WINDOW_START_DAY,
+    early_window_end_day: float = PROGNOSTIC_EARLY_WINDOW_END_DAY,
+    positive_floor: float = PROGNOSTIC_POSITIVE_FLOOR,
+    replicates: int = FIT_PRECISION_BOOTSTRAP_B,
+    seed: int = FIT_PRECISION_BOOTSTRAP_SEED,
+) -> FitPrecisionReport:
+    """Bootstrap precision, then attach the deterministic three-day sign verdict.
+
+    The bootstrap itself is unchanged and lives in
+    :func:`_bootstrap_fit_precision_impl`. This wrapper exists so the
+    ``LOO_SIGN_ESTABLISHMENT`` verdict is attached on EVERY return path of that
+    function, including the six early typed refusals, without patching each
+    return site and risking one being missed. ``collapse_distinct_days`` is
+    deterministic and side-effect free, so recomputing it here cannot change the
+    estimator mirror or the served value.
+    """
+    report = _bootstrap_fit_precision_impl(
+        time_days=time_days,
+        marker_values=marker_values,
+        k_day=k_day,
+        reference=reference,
+        early_window_start_day=early_window_start_day,
+        early_window_end_day=early_window_end_day,
+        positive_floor=positive_floor,
+        replicates=replicates,
+        seed=seed,
+    )
+    if time_days is None or marker_values is None:
+        return report
+    try:
+        collapsed = collapse_distinct_days(
+            time_days,
+            marker_values,
+            early_window_start_day=early_window_start_day,
+            early_window_end_day=early_window_end_day,
+            positive_floor=positive_floor,
+        )
+    except ValueError:
+        return report
+    verdict = loo_sign_establishment(collapsed, positive_floor=positive_floor)
+    if verdict["established"] is None:
+        return report
+    return FitPrecisionReport(
+        **{
+            **report.as_kwargs(),
+            "loo_sign_established": verdict["established"],
+            "loo_sign_rule": verdict["rule"],
+            "loo_negative_slope_count": verdict["negative_slope_count"],
+        }
+    )
+
+
+def _bootstrap_fit_precision_impl(
+    *,
+    time_days: Optional[Iterable[Any]],
+    marker_values: Optional[Iterable[Any]],
+    k_day: Optional[float],
+    reference: Optional[ReferenceCDF] = None,
+    early_window_start_day: float = PROGNOSTIC_EARLY_WINDOW_START_DAY,
+    early_window_end_day: float = PROGNOSTIC_EARLY_WINDOW_END_DAY,
+    positive_floor: float = PROGNOSTIC_POSITIVE_FLOOR,
+    replicates: int = FIT_PRECISION_BOOTSTRAP_B,
+    seed: int = FIT_PRECISION_BOOTSTRAP_SEED,
+) -> FitPrecisionReport:
+    """Estimate individual-rate uncertainty for one patient, or say why not.
+
+    Never raises for a data reason. Every refusal is a typed status with a
+    recorded reason, because a request that cannot support an uncertainty
+    statement must still receive an explicit answer about that fact.
+    """
+    if time_days is None or marker_values is None:
+        return insufficient_report("no observation series supplied")
+
+    collapsed = collapse_distinct_days(
+        time_days,
+        marker_values,
+        early_window_start_day=early_window_start_day,
+        early_window_end_day=early_window_end_day,
+        positive_floor=positive_floor,
+    )
+    n_distinct = len(collapsed)
+    if n_distinct < FIT_PRECISION_MIN_DISTINCT_DAYS:
+        return insufficient_report(
+            f"{n_distinct} distinct in-window days; the within-patient bootstrap "
+            f"requires at least {FIT_PRECISION_MIN_DISTINCT_DAYS}",
+            n_distinct_days=n_distinct,
+            n_observations_in_window=n_distinct,
+        )
+
+    x = [t for t, _ in collapsed]
+    y = [math.log(v) for _, v in collapsed]
+
+    # The mirror must reproduce the estimator that produced the served value.
+    k_mirror = negative_ols_slope(x, y)
+    reproduced: Optional[bool] = None
+    bitwise: Optional[bool] = None
+    if k_day is not None and k_mirror is not None:
+        try:
+            k_point = float(k_day)
+        except (TypeError, ValueError):
+            k_point = float("nan")
+        if math.isfinite(k_point) and k_point != 0.0:
+            bitwise = k_mirror == k_point
+            reproduced = bool(
+                bitwise
+                or abs(k_mirror - k_point)
+                <= FIT_PRECISION_POINT_REPRODUCTION_RELATIVE_TOLERANCE * abs(k_point)
+            )
+    if reproduced is False:
+        report = insufficient_report(
+            "the resampling estimator did not reproduce the served k_day, so the "
+            "spread reported would belong to a different estimator",
+            n_distinct_days=n_distinct,
+            n_observations_in_window=n_distinct,
+        )
+        return FitPrecisionReport(
+            **{
+                **report.as_kwargs(),
+                "point_k_day_reproduced": False,
+                "point_k_day_reproduced_bitwise": bitwise,
+            }
+        )
+
+    cdf = reference
+    if cdf is None:
+        try:
+            cdf = load_reference_cdf()
+        except ReferenceCDFError as error:
+            return insufficient_report(
+                f"reference distribution unavailable: {error.reason}",
+                n_distinct_days=n_distinct,
+                n_observations_in_window=n_distinct,
+            )
+
+    k_point_value = k_mirror if k_mirror is not None else None
+    if k_day is not None:
+        try:
+            candidate = float(k_day)
+        except (TypeError, ValueError):
+            candidate = float("nan")
+        if math.isfinite(candidate):
+            k_point_value = candidate
+    if k_point_value is None or not math.isfinite(k_point_value) or k_point_value <= 0.0:
+        return insufficient_report(
+            "the point k_day is not a positive finite rate, so it has no band or "
+            "percentile for a replicate to be compared against",
+            n_distinct_days=n_distinct,
+            n_observations_in_window=n_distinct,
+        )
+    try:
+        percentile_point = cdf.percentile(k_point_value)
+    except ReferenceCDFError as error:
+        return insufficient_report(
+            f"the point k_day has no reference percentile: {error.reason}",
+            n_distinct_days=n_distinct,
+            n_observations_in_window=n_distinct,
+        )
+    band_point = exploratory_relative_prognostic_band(percentile_point)
+
+    # ---- resample distinct days with replacement --------------------------
+    rng = random.Random(seed)
+    n_replicates = int(replicates)
+    usable = 0
+    positive_k: List[float] = []
+    for _ in range(n_replicates):
+        draw = [rng.randrange(n_distinct) for _ in range(n_distinct)]
+        if len(set(draw)) < FIT_PRECISION_MIN_DISTINCT_DAYS_PER_REPLICATE:
+            continue
+        k_rep = negative_ols_slope([x[i] for i in draw], [y[i] for i in draw])
+        if k_rep is None:
+            continue
+        usable += 1
+        if k_rep > 0.0:
+            positive_k.append(k_rep)
+
+    finite_fraction = usable / n_replicates if n_replicates > 0 else None
+    sign_stability = (len(positive_k) / usable) if usable > 0 else None
+
+    base: Dict[str, Any] = {
+        "n_distinct_days": n_distinct,
+        "n_observations_in_window": n_distinct,
+        "n_replicates": n_replicates,
+        "n_usable_replicates": usable,
+        "n_positive_finite_replicates": len(positive_k),
+        "finite_replicate_fraction": finite_fraction,
+        "point_k_day_reproduced": reproduced,
+        "point_k_day_reproduced_bitwise": bitwise,
+    }
+
+    if len(positive_k) < 2:
+        status = assign_fit_precision_status(
+            n_distinct_days=n_distinct,
+            finite_replicate_fraction=finite_fraction,
+            decline_sign_stability=sign_stability,
+            percentile_interval_width=None,
+            boundary_crossing_probability=None,
+        )
+        return FitPrecisionReport(
+            status=status,
+            k_day_uncertainty_interval=None,
+            percentile_uncertainty_interval=None,
+            multiplier_uncertainty_interval=None,
+            decline_sign_stability=sign_stability,
+            boundary_crossing_probability=None,
+            percentile_interval_width=None,
+            z_rank_uncertainty_interval=None,
+            k_day_bootstrap_sd=None,
+            boundary_crossing_probability_unconditional=None,
+            status_reason=(
+                "fewer than two positive finite replicates, so no replicate "
+                "interval is defined"
+            ),
+            **base,
+        )
+
+    percentiles: List[float] = []
+    z_values: List[float] = []
+    multipliers: List[float] = []
+    changed = 0
+    for k_rep in positive_k:
+        try:
+            p_rep = cdf.percentile(k_rep)
+        except ReferenceCDFError:
+            continue
+        z_rep = normal_ppf(p_rep)
+        percentiles.append(p_rep)
+        z_values.append(z_rep)
+        multipliers.append(math.exp(PROSTATE_PSA_COX_BETA * z_rep))
+        if exploratory_relative_prognostic_band(p_rep) != band_point:
+            changed += 1
+
+    if len(percentiles) < 2:
+        status = assign_fit_precision_status(
+            n_distinct_days=n_distinct,
+            finite_replicate_fraction=finite_fraction,
+            decline_sign_stability=sign_stability,
+            percentile_interval_width=None,
+            boundary_crossing_probability=None,
+        )
+        return FitPrecisionReport(
+            status=status,
+            k_day_uncertainty_interval=None,
+            percentile_uncertainty_interval=None,
+            multiplier_uncertainty_interval=None,
+            decline_sign_stability=sign_stability,
+            boundary_crossing_probability=None,
+            percentile_interval_width=None,
+            z_rank_uncertainty_interval=None,
+            k_day_bootstrap_sd=None,
+            boundary_crossing_probability_unconditional=None,
