+++ b/scripts/validation/verify_zeta_core_delivery.py
@@ -0,0 +1,117 @@
+#!/usr/bin/env python3
+"""Create and verify a complete Zeta-Core delivery manifest.
+
+The root manifest is the trust anchor and excludes itself. Every other regular
+file under the artifact root must appear exactly once, directly or through a
+child manifest. Child manifests are themselves covered by their parent.
+"""
+from __future__ import annotations
+import argparse, hashlib, json
+from pathlib import Path, PurePosixPath
+
+SCHEMA = "ZETA_CORE_DELIVERY_MANIFEST_V2"
+ROOT_NAME = "DELIVERY_MANIFEST.v2.json"
+
+
+def sha(path: Path):
+    h = hashlib.sha256()
+    with path.open("rb") as fh:
+        for chunk in iter(lambda: fh.read(1 << 20), b""):
+            h.update(chunk)
+    return h.hexdigest()
+
+
+def safe_rel(value: str):
+    p = PurePosixPath(value)
+    if p.is_absolute() or ".." in p.parts or value in ("", "."):
+        raise ValueError(f"unsafe manifest path: {value!r}")
+    return p
+
+
+def create(root: Path, output: Path):
+    root = root.resolve(); output = output.resolve()
+    members = []
+    for p in sorted(x for x in root.rglob("*") if x.is_file() and x.resolve() != output):
+        members.append({"path": p.relative_to(root).as_posix(), "kind": "file",
+                        "bytes": p.stat().st_size, "sha256": sha(p)})
+    payload = {"schema": SCHEMA, "root_trust_anchor": output.name,
+               "self_excluded": True, "members": members}
+    output.write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n")
+    return verify(root, output)
+
+
+def verify(root: Path, manifest: Path):
+    root = root.resolve(); manifest = manifest.resolve()
+    missing, mismatch, size_mismatch, cycles, duplicates, unsafe = [], [], [], [], [], []
+    expected = {}; visiting = set(); visited = set()
+
+    def walk(mpath: Path, base: Path):
+        mr = mpath.resolve()
+        if mr in visiting:
+            cycles.append(str(mpath.relative_to(root)))
+            return
+        if mr in visited:
+            return
+        visiting.add(mr)
+        try:
+            data = json.loads(mpath.read_text())
+            if data.get("schema") != SCHEMA:
+                mismatch.append({"path": str(mpath.relative_to(root)), "reason": "schema"})
+                return
+            seen_local = set()
+            for row in data.get("members", []):
+                try:
+                    rel = safe_rel(row["path"])
+                except Exception as exc:
+                    unsafe.append(str(exc)); continue
+                full = (base / Path(*rel.parts)).resolve()
+                try:
+                    full.relative_to(root)
+                except ValueError:
+                    unsafe.append(row["path"]); continue
+                key = full.relative_to(root).as_posix()
+                if key in seen_local or key in expected:
+                    duplicates.append(key); continue
+                seen_local.add(key); expected[key] = row
+                if not full.is_file():
+                    missing.append(key); continue
+                actual_sha, actual_size = sha(full), full.stat().st_size
+                if actual_sha != row.get("sha256"):
+                    mismatch.append({"path": key, "expected": row.get("sha256"), "actual": actual_sha})
+                if actual_size != row.get("bytes"):
+                    size_mismatch.append({"path": key, "expected": row.get("bytes"), "actual": actual_size})
+                if row.get("kind") == "manifest":
+                    walk(full, full.parent)
+                elif row.get("kind") != "file":
+                    mismatch.append({"path": key, "reason": "unknown_kind"})
+        finally:
+            visiting.remove(mr); visited.add(mr)
+
+    walk(manifest, root)
+    actual = {p.relative_to(root).as_posix() for p in root.rglob("*")
+              if p.is_file() and p.resolve() != manifest}
+    extra = sorted(actual - set(expected))
+    result = {"schema": SCHEMA, "manifest": manifest.name,
+              "manifest_sha256": sha(manifest), "covered_files": len(expected),
+              "actual_files_excluding_root_manifest": len(actual),
+              "missing": sorted(set(missing)), "extra": extra,
+              "digest_mismatches": mismatch, "size_mismatches": size_mismatch,
+              "cyclic_manifest_references": sorted(set(cycles)),
+              "duplicate_entries": sorted(set(duplicates)), "unsafe_paths": sorted(set(unsafe))}
+    result["verdict"] = "PASS" if not any(result[k] for k in (
+        "missing", "extra", "digest_mismatches", "size_mismatches",
+        "cyclic_manifest_references", "duplicate_entries", "unsafe_paths")) else "FAIL"
+    return result
+
+
+def main():
+    ap = argparse.ArgumentParser(); sp = ap.add_subparsers(dest="cmd", required=True)
+    for cmd in ("create", "verify"):
+        p = sp.add_parser(cmd); p.add_argument("root"); p.add_argument("--manifest")
+    a = ap.parse_args(); root = Path(a.root)
+    manifest = Path(a.manifest) if a.manifest else root / ROOT_NAME
+    result = create(root, manifest) if a.cmd == "create" else verify(root, manifest)
+    print(json.dumps(result, indent=2, sort_keys=True))
+    raise SystemExit(0 if result["verdict"] == "PASS" else 1)
+
+if __name__ == "__main__": main()
