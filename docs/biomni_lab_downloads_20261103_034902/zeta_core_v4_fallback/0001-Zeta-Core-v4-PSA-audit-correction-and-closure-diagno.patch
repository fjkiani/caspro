+    k_interval = _interval(sorted(positive_k))
+    percentile_interval = _interval(sorted(percentiles))
+    z_interval = _interval(sorted(z_values))
+    multiplier_interval = _interval(sorted(multipliers))
+    width = percentile_interval[1] - percentile_interval[0]
+    crossing = changed / len(percentiles)
