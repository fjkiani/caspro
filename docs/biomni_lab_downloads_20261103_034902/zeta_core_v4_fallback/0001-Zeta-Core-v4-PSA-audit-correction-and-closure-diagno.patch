@@ -0,0 +1,395 @@
+"""Zeta-Core v4 - D12 runner: eligibility model, positivity, stabilized weights,
+weighted vs unweighted Cox, nonparametric bootstrap.
+
+All patient-level data stays in /workspace. The emitted JSON contains only
+aggregate quantities.
+"""
+from __future__ import annotations
+
+import json
+import os
+import sys
+from pathlib import Path
+
+import numpy as np
+import pandas as pd
+
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+import d10_transport_core as tp        # noqa: E402
+import d12_selection_core as d12       # noqa: E402
+
+OUT = Path(os.environ.get("ZC4_D12_OUT", "/workspace/zc4_d12"))
+OUT.mkdir(parents=True, exist_ok=True)
+LOCKED_BETA_Z = -0.17278419421744848
+LOCKED_SE_Z = 0.05678256010479415
+
+
+def smd(x, sel, w=None):
+    """Standardized mean difference between selected and excluded groups."""
+    x = np.asarray(x, float)
+    s = np.asarray(sel, bool)
+    if w is None:
+        w = np.ones(len(x))
+    w = np.asarray(w, float)
+
+    def mv(mask):
+        ww = w[mask]
+        if ww.sum() <= 0:
+            return np.nan, np.nan
+        m = np.average(x[mask], weights=ww)
+        v = np.average((x[mask] - m) ** 2, weights=ww)
+        return m, v
+
+    m1, v1 = mv(s)
+    m0, v0 = mv(~s)
+    pooled = np.sqrt((v1 + v0) / 2.0)
+    return float((m1 - m0) / pooled) if pooled > 0 else 0.0
+
+
+def analyse(fr, labs_used, *, b=1000, seed=20260813):
+    ls = fr[fr.landmark_survivor == 1].reset_index(drop=True)
+    X, names, dmeta = d12.design_matrix(ls, labs_used)
+    imputed = dmeta["imputed_counts"]
+    sel = ls["final_analysis_set"].values.astype(int)
+
+    # ---------------- eligibility (propensity) model, baseline covariates only ----
+    beta_ps, conv = d12.logistic_fit(X, sel, ridge=0.0)
+    ps = d12.logistic_predict(beta_ps, X)
+
+    # diagnosed-and-rejected variant: every missingness indicator retained, which
+    # produced perfect separation (propensities numerically 0 and 1)
+    X_all_ind, names_all, dmeta_all = d12.design_matrix(ls, labs_used, min_missing_cell=2)
+    b_ml_all, conv_ml_all = d12.logistic_fit(X_all_ind, sel)
+    ps_ml_all = d12.logistic_predict(b_ml_all, X_all_ind)
+    b_firth, conv_firth = d12.firth_logistic_fit(X_all_ind, sel)
+    ps_firth = d12.logistic_predict(b_firth, X_all_ind)
+    separation_diagnostic = {
+        "rejected_unrestricted_ml": {
+            "note": "missingness indicators retained down to a cell of 2, including the "
+                    "n=3 ALP cell and the n=4 TBILI cell",
+            "n_parameters": int(X_all_ind.shape[1] + 1),
+            "max_abs_coefficient": float(np.abs(b_ml_all).max()),
+            "propensity_min": float(ps_ml_all.min()), "propensity_max": float(ps_ml_all.max()),
+            "n_propensity_below_0p01_or_above_0p99": int(((ps_ml_all < 0.01) | (ps_ml_all > 0.99)).sum()),
+            "separating_columns": [nm for j, nm in enumerate(names_all)
+                                   if nm.endswith("__missing")
+                                   and X_all_ind[:, j].sum() > 0
+                                   and sel[X_all_ind[:, j] == 1].mean() in (0.0, 1.0)],
+            "verdict": "REJECTED for structural positivity failure",
+        },
+        "firth_penalized_sensitivity": {
+            "note": "Jeffreys-prior penalty on the full indicator set; standard remedy for separation",
+            "converged": bool(conv_firth),
+            "max_abs_coefficient": float(np.abs(b_firth).max()),
+            "propensity_min": float(ps_firth.min()), "propensity_max": float(ps_firth.max()),
+            "n_propensity_below_0p01_or_above_0p99": int(((ps_firth < 0.01) | (ps_firth > 0.99)).sum()),
+        },
+        "adopted_primary": {
+            "rule": f"missingness indicator enters only if its cell has >= "
+                    f"{d12.MIN_MISSING_CELL_FOR_INDICATOR} observations "
+                    f"(pure covariate-count rule, never uses selection status or outcome)",
+            "n_parameters": int(X.shape[1] + 1),
+            "max_abs_coefficient": float(np.abs(beta_ps).max()),
+            "propensity_min": float(ps.min()), "propensity_max": float(ps.max()),
+            "n_propensity_below_0p01_or_above_0p99": int(((ps < 0.01) | (ps > 0.99)).sum()),
+        },
+    }
+
+    q = [0, 1, 5, 25, 50, 75, 95, 99, 100]
+    ps_dist = {
+        "selected": {f"p{p}": float(np.percentile(ps[sel == 1], p)) for p in q},
+        "excluded": {f"p{p}": float(np.percentile(ps[sel == 0], p)) for p in q},
+    }
+    ov_lo = max(ps[sel == 1].min(), ps[sel == 0].min())
+    ov_hi = min(ps[sel == 1].max(), ps[sel == 0].max())
+    positivity = {
+        "propensity_min_overall": float(ps.min()), "propensity_max_overall": float(ps.max()),
+        "common_support_interval": [float(ov_lo), float(ov_hi)],
+        "n_selected_outside_common_support": int(((ps < ov_lo) | (ps > ov_hi))[sel == 1].sum()),
+        "n_excluded_outside_common_support": int(((ps < ov_lo) | (ps > ov_hi))[sel == 0].sum()),
+        "n_selected_with_ps_below_0p05": int((ps[sel == 1] < 0.05).sum()),
+        "n_selected_with_ps_above_0p95": int((ps[sel == 1] > 0.95).sum()),
+        "structural_positivity_violation": bool(ov_hi <= ov_lo),
+        "logistic_converged": bool(conv),
+        "n_propensity_parameters": int(X.shape[1] + 1),
+        "events_per_parameter_excluded_group": float((sel == 0).sum() / (X.shape[1] + 1)),
+    }
+
+    # ---------------- stabilized weights, prespecified truncation ----------------
+    marg = float(sel.mean())
+    sw_all = np.where(sel == 1, marg / ps, (1 - marg) / (1 - ps))
+    sw = sw_all[sel == 1]
+    lo_pct, hi_pct = d12.WEIGHT_TRUNCATION_PERCENTILES
+    t_lo, t_hi = np.percentile(sw, lo_pct), np.percentile(sw, hi_pct)
+    sw_t = np.clip(sw, t_lo, t_hi)
+    weights = {
+        "definition": "stabilized IPSW for the selected group: sw = P(S=1) / P(S=1|X)",
+        "marginal_selection_probability": marg,
+        "prespecified_truncation_percentiles": list(d12.WEIGHT_TRUNCATION_PERCENTILES),
+        "truncation_thresholds": [float(t_lo), float(t_hi)],
+        "untruncated": {"mean": float(sw.mean()), "sd": float(sw.std(ddof=1)),
+                        "min": float(sw.min()), "max": float(sw.max()),
+                        "p99": float(np.percentile(sw, 99))},
+        "truncated": {"mean": float(sw_t.mean()), "sd": float(sw_t.std(ddof=1)),
+                      "min": float(sw_t.min()), "max": float(sw_t.max())},
+        "n_truncated_low": int((sw < t_lo).sum()), "n_truncated_high": int((sw > t_hi).sum()),
+        "effective_sample_size_truncated": float(sw_t.sum() ** 2 / np.sum(sw_t ** 2)),
+        "n_selected": int(sel.sum()),
+    }
+
+    # ---------------- covariate balance, unweighted vs weighted -----------------
+    # Stabilized IPSW reweights the SELECTED group to represent the FULL landmark-
+    # survivor population, so the balance target is the full population, not the
+    # excluded group. Reporting selected-vs-excluded after weighting would understate
+    # success by construction: matching the full population closes only the (1 - P(S=1))
+    # share of the selected-vs-excluded gap.
+    balance = []
+    for j, nm in enumerate(names):
+        x = X[:, j]
+        tgt_mean = float(x.mean())
+        tgt_var = float(x.var(ddof=1))
+        sel_x = x[sel == 1]
+        m_unw = float(sel_x.mean())
+        m_wtd = float(np.average(sel_x, weights=sw_t))
+        v_sel = float(sel_x.var(ddof=1))
+        pooled = np.sqrt((v_sel + tgt_var) / 2.0)
+        balance.append({
+            "covariate": nm,
+            "smd_selected_vs_excluded_unweighted": smd(x, sel == 1),
+            "smd_selected_vs_target_population_unweighted":
+                float((m_unw - tgt_mean) / pooled) if pooled > 0 else 0.0,
+            "smd_selected_vs_target_population_weighted":
+                float((m_wtd - tgt_mean) / pooled) if pooled > 0 else 0.0,
+            "n_imputed": imputed.get(nm, 0),
+        })
+    bal = pd.DataFrame(balance)
+
+    # ---------------- Cox: frozen z_rank, weighting is the only change ----------
+    an = ls[ls.final_analysis_set == 1].reset_index(drop=True)
+    kk = an["k"].values.astype(float)
+    z = tp.z_rank_from_cdf(tp.midrank_cdf(kk, kk))
+    Xc = np.column_stack([z, an["age_ge65"].values.astype(float), an["ecog"].values.astype(float)])
+    tt = an["os_weeks"].values.astype(float) - d12.LANDMARK_WEEKS
+    ee = an["event"].values.astype(int)
+
