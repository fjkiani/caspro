+"""D5: does the stdlib runtime estimator agree with the validation receipt?
+
+WHY THIS SCRIPT EXISTS
+----------------------
+``api.services.tumor_marker_kinetics.fit_precision`` runs inside the API process
+and is stdlib-only, so its bootstrap draws come from CPython's ``random.Random``
+(Mersenne Twister). The reference-cohort validation receipt for the same frozen
+design was produced offline with NumPy's PCG64 generator. Both implement the
+identical prespecified procedure - resample distinct analysis days with
+replacement, B replicates, the same seed, the same replicate-rejection rule, the
+same interval probability and the same five thresholds - but they consume
+different random streams. Per-patient quantiles are therefore Monte-Carlo
+equivalent, not bitwise identical.
+
+"Monte-Carlo equivalent" is a claim, and an unquantified claim is not evidence.
+This script quantifies it on the frozen reference cohort: it re-runs the shipped
+runtime estimator on every reference patient's own PSA series and compares the
+resulting status and interval endpoints against the receipt produced by the
+NumPy implementation.
+
+WHAT WOULD FALSIFY THE CLAIM
+----------------------------
+Three things, reported separately because they fail for different reasons:
+
+1. **Point disagreement.** The runtime mirror must reproduce the served
+   ``k_day`` for every patient. Any failure here is an estimator defect, not a
+   Monte-Carlo difference, and is reported as ``point_reproduction_failures``.
+2. **Systematic interval shift.** Monte-Carlo noise is centred. A signed median
+   difference in an interval endpoint that is large relative to the interval
+   width would indicate a different procedure, not a different stream.
+3. **Threshold-driven status flips.** Some flips are expected and benign: a
+   patient whose true percentile-interval width sits at 0.199 will land on
+   either side of the 0.20 bound depending on the draw. Flips are therefore
+   reported *with* their distance from the deciding threshold, so a reader can
+   see whether they are boundary cases or genuine disagreement.
+
+WHAT THIS SCRIPT DOES NOT DO
+----------------------------
+It does not change the released design, re-tune a threshold, or select a random
+stream on the basis of the answer. It does not emit or write any patient
+identifier: every output is an aggregate over the cohort. It is not a
+calibration analysis and it does not activate the suppressed categorical band.
+
+USAGE
+-----
+    python scripts/validation/d5_runtime_equivalence.py \
+        --adlb /path/to/VENICE/adlb.parquet \
+        --cohort /path/to/kelim_multicohort_standardized.parquet \
+        --receipt /path/to/b2_per_patient.csv \
+        --out /path/to/d5_runtime_equivalence.json
+
+The three inputs stay outside this repository. Only the aggregate receipt is
+written.
+"""
+from __future__ import annotations
+
+import argparse
+import json
+import math
+import os
+import statistics
+import sys
+import time
+from collections import Counter
+from typing import Any, Dict, List, Optional, Sequence, Tuple
+
+sys.path.insert(0, os.path.abspath(os.path.join(os.path.dirname(__file__), "..", "..")))
+
+from api.services.tumor_marker_kinetics.fit_precision import (  # noqa: E402
+    bootstrap_fit_precision,
+)
+from api.services.tumor_marker_kinetics.models import (  # noqa: E402
+    FIT_PRECISION_BOOTSTRAP_B,
+    FIT_PRECISION_BOOTSTRAP_SEED,
+    FIT_PRECISION_MAX_BOUNDARY_CROSSING_PROBABILITY,
+    FIT_PRECISION_MAX_PERCENTILE_INTERVAL_WIDTH,
+    FIT_PRECISION_MIN_DECLINE_SIGN_STABILITY,
+    FIT_PRECISION_MIN_DISTINCT_DAYS,
+    PROGNOSTIC_EARLY_WINDOW_END_DAY,
+    PROGNOSTIC_EARLY_WINDOW_START_DAY,
+    PROGNOSTIC_LANDMARK_WEEKS,
+    PROGNOSTIC_POSITIVE_FLOOR,
+)
+from api.services.tumor_marker_kinetics.reference_cdf import (  # noqa: E402
+    load_reference_cdf,
+)
+
+STATUSES = (
+    "RELIABLE",
+    "IMPRECISE",
+    "SIGN_UNSTABLE",
+    "INSUFFICIENT_FOR_UNCERTAINTY",
+)
+
+
+def _quantiles(values: Sequence[float]) -> Optional[Dict[str, float]]:
+    finite = sorted(v for v in values if v is not None and math.isfinite(v))
+    if not finite:
+        return None
+
+    def q(p: float) -> float:
+        if len(finite) == 1:
+            return finite[0]
+        pos = p * (len(finite) - 1)
+        lo = int(math.floor(pos))
+        hi = min(lo + 1, len(finite) - 1)
+        return finite[lo] + (finite[hi] - finite[lo]) * (pos - lo)
+
+    return {
+        "n": len(finite),
+        "min": finite[0],
+        "p25": q(0.25),
+        "median": q(0.50),
+        "p75": q(0.75),
+        "max": finite[-1],
+        "mean": statistics.fmean(finite),
+        "max_abs": max(abs(v) for v in finite),
+    }
+
+
+def _deciding_margin(row: Dict[str, Any]) -> Optional[Dict[str, float]]:
+    """How far the receipt's numbers sat from each deciding threshold."""
+    out: Dict[str, float] = {}
+    stability = row.get("decline_sign_stability")
+    width = row.get("percentile_width")
+    crossing = row.get("boundary_crossing_probability")
+    if stability is not None and math.isfinite(stability):
+        out["distance_from_sign_stability_bound"] = (
+            stability - FIT_PRECISION_MIN_DECLINE_SIGN_STABILITY
+        )
+    if width is not None and math.isfinite(width):
+        out["distance_from_width_bound"] = FIT_PRECISION_MAX_PERCENTILE_INTERVAL_WIDTH - width
+    if crossing is not None and math.isfinite(crossing):
+        out["distance_from_crossing_bound"] = (
+            FIT_PRECISION_MAX_BOUNDARY_CROSSING_PROBABILITY - crossing
+        )
+    return out or None
+
+
+def main() -> int:
+    ap = argparse.ArgumentParser(description=__doc__)
+    ap.add_argument("--adlb", required=True, help="VENICE lab table (parquet)")
+    ap.add_argument("--cohort", required=True, help="standardized landmark cohort (parquet)")
+    ap.add_argument("--receipt", required=True, help="B2 per-patient receipt (csv)")
+    ap.add_argument("--out", required=True, help="aggregate JSON receipt to write")
+    ap.add_argument(
+        "--replicates",
+        type=int,
+        default=FIT_PRECISION_BOOTSTRAP_B,
+        help="replicate count; defaults to the frozen value",
+    )
+    args = ap.parse_args()
+
+    import pandas as pd  # local: the API runtime never needs pandas
+
+    started = time.time()
+
+    receipt = pd.read_csv(args.receipt)
+    if "patient_id" not in receipt.columns:
+        raise SystemExit("receipt is missing patient_id; cannot align patients")
+    receipt = receipt.set_index("patient_id", drop=True)
+
+    cohort = pd.read_parquet(args.cohort)
+    venice = cohort[cohort["trial"] == "VENICE"].copy()
+    landmark = venice[venice["os_weeks"] > float(PROGNOSTIC_LANDMARK_WEEKS)]
+    landmark_ids = [str(p) for p in landmark["patient_id"].tolist()]
+
+    adlb = pd.read_parquet(args.adlb)
+    psa = adlb[adlb["LBTESTCD"] == "PSA"].copy()
+    psa["pid"] = psa["USUBJID"].astype(str)
+    psa = psa[psa["pid"].isin(set(landmark_ids))]
+    psa = psa[["pid", "LBDY", "LBSTRESN"]].dropna()
+
+    series: Dict[str, Tuple[List[float], List[float]]] = {}
+    for pid, grp in psa.groupby("pid", sort=True):
+        series[str(pid)] = (
+            [float(d) for d in grp["LBDY"].tolist()],
+            [float(v) for v in grp["LBSTRESN"].tolist()],
+        )
+
+    cdf = load_reference_cdf()
+
+    confusion: Counter = Counter()
+    agree = 0
+    compared = 0
+    point_failures = 0
+    missing_series = 0
+    missing_receipt = 0
+    flips: List[Dict[str, Any]] = []
+    d_k_lo: List[float] = []
+    d_k_hi: List[float] = []
+    d_pct_lo: List[float] = []
+    d_pct_hi: List[float] = []
+    d_width: List[float] = []
+    width_detail: List[Dict[str, Any]] = []
+    d_stability: List[float] = []
+    d_crossing: List[float] = []
+    rel_width: List[float] = []
+
+    for pid in landmark_ids:
+        if pid not in receipt.index:
+            missing_receipt += 1
+            continue
+        row = receipt.loc[pid]
+        if isinstance(row, pd.DataFrame):  # duplicate id: refuse rather than guess
+            raise SystemExit(f"receipt has duplicate rows for one patient")
+        rec = {k: (None if pd.isna(v) else v) for k, v in row.to_dict().items()}
+
+        if pid not in series:
+            missing_series += 1
+            continue
+        days, values = series[pid]
+
+        report = bootstrap_fit_precision(
+            time_days=days,
+            marker_values=values,
+            k_day=float(rec["k_locked"]),
+            reference=cdf,
+            early_window_start_day=PROGNOSTIC_EARLY_WINDOW_START_DAY,
+            early_window_end_day=PROGNOSTIC_EARLY_WINDOW_END_DAY,
+            positive_floor=PROGNOSTIC_POSITIVE_FLOOR,
+            replicates=args.replicates,
+            seed=FIT_PRECISION_BOOTSTRAP_SEED,
+        )
+
+        if report.point_k_day_reproduced is False:
+            point_failures += 1
+
+        want = str(rec["fit_precision_status"])
+        got = str(report.status)
+        confusion[(want, got)] += 1
+        compared += 1
+        if want == got:
+            agree += 1
+        else:
+            entry = {
+                "receipt_status": want,
+                "runtime_status": got,
+                "n_distinct_days": int(rec["n_distinct_days"]),
+            }
+            margins = _deciding_margin(rec)
+            if margins:
+                entry.update({k: float(v) for k, v in margins.items()})
+            flips.append(entry)
+
+        if report.k_day_uncertainty_interval and rec.get("k_lo") is not None:
+            d_k_lo.append(report.k_day_uncertainty_interval[0] - float(rec["k_lo"]))
+            d_k_hi.append(report.k_day_uncertainty_interval[1] - float(rec["k_hi"]))
+        if report.percentile_uncertainty_interval and rec.get("percentile_lo") is not None:
+            lo_d = report.percentile_uncertainty_interval[0] - float(rec["percentile_lo"])
+            hi_d = report.percentile_uncertainty_interval[1] - float(rec["percentile_hi"])
+            d_pct_lo.append(lo_d)
+            d_pct_hi.append(hi_d)
+            if report.percentile_interval_width is not None:
+                width_recv = float(rec["percentile_width"])
+                d_width.append(report.percentile_interval_width - width_recv)
+                width_detail.append(
+                    {
+                        "abs_diff": abs(report.percentile_interval_width - width_recv),
+                        "receipt_width": width_recv,
+                        "runtime_width": report.percentile_interval_width,
+                        "receipt_status": want,
+                        "runtime_status": got,
+                    }
+                )
+                if width_recv > 0:
+                    rel_width.append(
+                        abs(report.percentile_interval_width - width_recv) / width_recv
+                    )
+        if report.decline_sign_stability is not None and rec.get("decline_sign_stability") is not None:
+            d_stability.append(
+                report.decline_sign_stability - float(rec["decline_sign_stability"])
+            )
+        if (
+            report.boundary_crossing_probability is not None
+            and rec.get("boundary_crossing_probability") is not None
+        ):
+            d_crossing.append(
+                report.boundary_crossing_probability
+                - float(rec["boundary_crossing_probability"])
+            )
+
+    runtime_counts = Counter()
+    receipt_counts = Counter()
+    for (want, got), n in confusion.items():
+        receipt_counts[want] += n
+        runtime_counts[got] += n
+
+    boundary_flips = sum(
+        1
+        for f in flips
+        if any(
+            abs(f.get(key, 1.0)) <= 0.02
+            for key in (
+                "distance_from_sign_stability_bound",
+                "distance_from_width_bound",
+                "distance_from_crossing_bound",
+            )
+        )
+    )
+
+    # A status flip is not symmetric in consequence. SIGN_UNSTABLE is the FULL
+    # fail-closed status: the runtime refuses to serve the index at all. So a flip
+    # INTO it is conservative, while a flip OUT of it means the runtime would
+    # serve a point index for a patient the offline receipt would have refused.
+    # That direction is the one that matters for safety and is reported on its own.
+    served = {"RELIABLE", "IMPRECISE"}
+    toward_refusal = [
+        f for f in flips
+        if f["receipt_status"] in served and f["runtime_status"] == "SIGN_UNSTABLE"
+    ]
+    toward_serving = [
+        f for f in flips
+        if f["receipt_status"] == "SIGN_UNSTABLE" and f["runtime_status"] in served
+    ]
+    other_flips = [
+        f for f in flips
+        if f not in toward_refusal and f not in toward_serving
+    ]
+    serving_margins = [
+        abs(f["distance_from_sign_stability_bound"])
+        for f in toward_serving
+        if "distance_from_sign_stability_bound" in f
+    ]
+    fail_direction = {
+        "sign_unstable_is_a_full_fail_closed_status": True,
+        "n_flips_toward_refusal_conservative": len(toward_refusal),
+        "n_flips_toward_serving_permissive": len(toward_serving),
+        "n_flips_between_served_statuses_annotation_only": len(other_flips),
+        "max_sign_stability_distance_among_permissive_flips": (
+            max(serving_margins) if serving_margins else None
+        ),
+        "disclosure": (
+            "The runtime's sign-stability refusal is Monte-Carlo unstable for "
+            "patients whose resampled decline-sign stability sits within roughly "
+            f"{max(serving_margins):.4f} of the frozen "
+            f"{FIT_PRECISION_MIN_DECLINE_SIGN_STABILITY} bound. For those "
+            f"patients ({len(toward_serving)} of {compared} in the reference "
+            "cohort) the runtime stream serves a point index that the offline "
+            "receipt stream refused. Replicate count and seed are frozen in the "
+            "prespecification and were NOT raised in response to this finding; "
+            "the instability is disclosed instead of tuned away."
+        ) if serving_margins else (
+            "No permissive flips were observed: no patient refused by the "
+            "receipt stream was served by the runtime stream."
+        ),
+    }
+
+    # The headline median difference is at machine epsilon, so the tail is what a
+    # reader actually needs. Everything below is derived from the data rather than
+    # asserted, because the reassuring version of this paragraph is not true: the
+    # single largest width difference IS a status flip.
+    width_outliers = _quantiles([abs(v) for v in d_width])
+    WIDTH_OUTLIER_CUT = 0.05
+    outliers = [w for w in width_detail if w["abs_diff"] > WIDTH_OUTLIER_CUT]
+    width_tail: Dict[str, Any] = {
+        "threshold": WIDTH_OUTLIER_CUT,
+        "n_above_threshold": len(outliers),
+        "n_with_estimable_width": len(width_detail),
+    }
+    if outliers:
+        worst = max(outliers, key=lambda w: w["abs_diff"])
+        any_reliable = any(
+            w["receipt_status"] == "RELIABLE" or w["runtime_status"] == "RELIABLE"
+            for w in outliers
+        )
+        same_status = sum(
+            1 for w in outliers if w["receipt_status"] == w["runtime_status"]
+        )
+        width_tail.update(
+            {
+                "min_receipt_width_among_them": min(
+                    w["receipt_width"] for w in outliers
+                ),
+                "released_width_bound": FIT_PRECISION_MAX_PERCENTILE_INTERVAL_WIDTH,
+                "any_classified_reliable_by_either_stream": any_reliable,
+                "n_with_identical_status": same_status,
+                "n_with_flipped_status": len(outliers) - same_status,
+                "worst_case": {
+                    "abs_diff": worst["abs_diff"],
+                    "receipt_width": worst["receipt_width"],
+                    "runtime_width": worst["runtime_width"],
+                    "receipt_status": worst["receipt_status"],
+                    "runtime_status": worst["runtime_status"],
+                },
+                "status_pairs": sorted(
+                    {f"{w['receipt_status']}->{w['runtime_status']}" for w in outliers}
+                ),
+            }
+        )
+        extreme_width_note = (
+            f"{len(outliers)} of {len(width_detail)} patients with estimable width "
+            f"differ by more than {WIDTH_OUTLIER_CUT} in percentile-interval width, "
+            f"the largest by {worst['abs_diff']:.4f}. Every one of them already had "
+            f"a receipt width of at least "
+            f"{min(w['receipt_width'] for w in outliers):.4f}, i.e. above the "
+            f"{FIT_PRECISION_MAX_PERCENTILE_INTERVAL_WIDTH} released bound, so "
+            f"{'none' if not any_reliable else 'not all'} of them "
+            f"{'was' if not any_reliable else 'were'} classified RELIABLE by "
+            "either stream. Their released status is NOT always identical, "
+            f"however: {len(outliers) - same_status} of the {len(outliers)} "
+            "flipped, including the worst case "
+            f"({worst['receipt_status']} -> {worst['runtime_status']}). The wide-"
+            "interval tail is therefore where the two streams agree least, which "
+            "is also where the index is least informative under either stream."
+        )
+    else:
+        extreme_width_note = (
+            f"No patient differed by more than {WIDTH_OUTLIER_CUT} in "
+            "percentile-interval width."
+        )
+
+    payload: Dict[str, Any] = {
+        "analysis_id": "D5_RUNTIME_EQUIVALENCE",
+        "purpose": (
+            "Quantify agreement between the stdlib API runtime estimator "
+            "(random.Random / Mersenne Twister) and the NumPy PCG64 validation "
+            "receipt under the identical frozen resampling design."
+        ),
+        "not_a_calibration_analysis": True,
+        "does_not_activate_any_absolute_risk_or_treatment_field": True,
+        "does_not_define_a_band_activation_gate": True,
+        "design": {
+            "replicates": int(args.replicates),
+            "frozen_replicates": int(FIT_PRECISION_BOOTSTRAP_B),
+            "seed": int(FIT_PRECISION_BOOTSTRAP_SEED),
+            "min_distinct_days_for_uncertainty": int(FIT_PRECISION_MIN_DISTINCT_DAYS),
+            "runtime_random_stream": "CPython random.Random (Mersenne Twister)",
+            "receipt_random_stream": "NumPy default_rng (PCG64)",
+            "streams_are_bitwise_identical": False,
+        },
+        "cohort": {
+            "n_landmark_patients": len(landmark_ids),
+            "n_compared": compared,
+            "n_missing_series": missing_series,
+            "n_missing_receipt_row": missing_receipt,
+        },
+        "point_reproduction_failures": point_failures,
+        "status_agreement": {
+            "n_agree": agree,
+            "n_compared": compared,
+            "agreement_fraction": (agree / compared) if compared else None,
+            "n_disagree": compared - agree,
+            "n_disagree_within_0_02_of_a_threshold": boundary_flips,
+        },
+        "status_counts_receipt": {s: receipt_counts.get(s, 0) for s in STATUSES},
+        "status_counts_runtime": {s: runtime_counts.get(s, 0) for s in STATUSES},
+        "confusion_matrix": {
+            f"{want}->{got}": n for (want, got), n in sorted(confusion.items())
+        },
+        "signed_differences_runtime_minus_receipt": {
+            "k_day_lower": _quantiles(d_k_lo),
+            "k_day_upper": _quantiles(d_k_hi),
+            "percentile_lower": _quantiles(d_pct_lo),
+            "percentile_upper": _quantiles(d_pct_hi),
+            "percentile_interval_width": _quantiles(d_width),
+            "decline_sign_stability": _quantiles(d_stability),
+            "boundary_crossing_probability": _quantiles(d_crossing),
+        },
+        "relative_width_difference_abs": _quantiles(rel_width),
+        "absolute_width_difference": width_outliers,
+        "width_difference_tail": width_tail,
+        "extreme_width_difference_note": extreme_width_note,
+        "fail_direction_analysis": fail_direction,
+        "status_flips": flips,
+        "interpretation_constraints": [
+            "A status flip near a threshold is expected Monte-Carlo behaviour "
+            "under the frozen design and is not evidence that the two "
+            "implementations compute different quantities.",
+            "A point reproduction failure is NOT a Monte-Carlo difference. It "
+            "means the runtime mirror did not reproduce the served k_day, and "
+            "the runtime fails closed for that patient.",
+            "Agreement here does not validate the design itself. The design was "
+            "frozen in the audit-correction prespecification before any of these "
+            "numbers existed, and this script does not revise it.",
+            "No patient identifier is written by this script.",
+        ],
+        "runtime_seconds": round(time.time() - started, 3),
+    }
+
+    with open(args.out, "w") as fh:
+        json.dump(payload, fh, indent=2, sort_keys=True)
+
+    print(f"compared {compared} patients")
+    print(
+        "status agreement: "
+        f"{agree}/{compared} = "
+        f"{(agree / compared) if compared else float('nan'):.4f}"
+    )
+    print(f"point reproduction failures: {point_failures}")
+    print(f"disagreements: {compared - agree} ({boundary_flips} within 0.02 of a bound)")
+    print(
+        f"  toward refusal (conservative): {fail_direction['n_flips_toward_refusal_conservative']}"
+        f" | toward serving (permissive): {fail_direction['n_flips_toward_serving_permissive']}"
+        f" | annotation-only: {fail_direction['n_flips_between_served_statuses_annotation_only']}"
+    )
+    if extreme_width_note:
+        print(f"  NOTE: {extreme_width_note}")
+    print(f"wrote {args.out}")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
