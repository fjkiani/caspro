+"""Zeta-Core v4 - D11 fold-local functional-form validation.
+
+Frozen prespecification b4_cv_D11:
+  folds  = 10, seed = 20260813
+  fold_local_requirements: rank / inverse-normal transform, spline knot locations,
+      centering and scaling, and Cox coefficients ALL fitted on TRAINING rows only
+  held_out_rule: the frozen training transformation is APPLIED to held-out rows;
+      held-out values outside the training support are mapped by the training
+      transform's own extrapolation rule, NEVER by re-ranking
+  prohibited: computing global ranks or global knots before splitting
+
+Metric (Verweij & van Houwelingen 1993, cross-validated partial log-likelihood).
+The Cox partial log-likelihood is not a sum of independent per-subject terms, so the
+held-out contribution of fold k evaluated at the training-fold estimate is the
+DIFFERENCE
+
+    cvpl_k = pl_ALL(beta_hat_{-k}) - pl_{-k}(beta_hat_{-k})
+
+with CVPL = sum_k cvpl_k.  Higher is better.  Naively summing "held-out subject
+log-likelihood terms" is not a valid out-of-sample partial log-likelihood for a Cox
+model, so that shortcut is deliberately not used.
+
+Cohort: VENICE landmark survivors with complete covariates (n=446, 296 events) --
+the cohort the production locked model is anchored on.  The adjustment set
+age_ge65 + ECOG is held FIXED across all candidate forms so the comparison isolates
+the marker functional form and nothing else.
+"""
+from __future__ import annotations
+
+import json
+import os
+import sys
+from pathlib import Path
+
+import numpy as np
+import pandas as pd
+
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+import d10_transport_core as tp  # noqa: E402
+
+FOLDS = 10
+SEED = 20260813
+LANDMARK = tp.LANDMARK_WEEKS
+OUT = Path(os.environ.get("ZC4_D11_OUT", "/workspace/zc4_d11"))
+OUT.mkdir(parents=True, exist_ok=True)
+
+SPLINE_INTERNAL_KNOT_QUANTILES = (0.10, 0.50, 0.90)
+SPLINE_BOUNDARY_KNOT_QUANTILES = (0.05, 0.95)
+
+
+def rcs_basis(x, knots):
+    """Restricted cubic spline (Harrell parameterisation).
+
+    Linear beyond the boundary knots by construction -- that linear tail IS "the
+    training transform's own extrapolation rule" for held-out values outside the
+    training support.
+    """
+    x = np.asarray(x, dtype=float)
+    k = np.asarray(knots, dtype=float)
+    if k.size < 3:
+        raise ValueError("restricted cubic spline needs >= 3 knots")
+    denom = (k[-1] - k[0]) ** 2
+    cols = [x]
+    for j in range(k.size - 2):
+        t_j, t_k1, t_k = k[j], k[-2], k[-1]
+        term = (np.maximum(x - t_j, 0.0) ** 3
+                - np.maximum(x - t_k1, 0.0) ** 3 * (t_k - t_j) / (t_k - t_k1)
+                + np.maximum(x - t_k, 0.0) ** 3 * (t_k1 - t_j) / (t_k - t_k1))
+        cols.append(term / denom)
+    return np.column_stack(cols)
+
+
+def _standardise(train_vals, held_vals):
+    mu = float(np.mean(train_vals))
+    sd = float(np.std(train_vals, ddof=1))
+    sd = sd if sd > 0 else 1.0
+    return (train_vals - mu) / sd, (held_vals - mu) / sd, {"center": mu, "scale": sd}
+
+
+def _frozen_rank(k_tr, k_ho, extrapolation):
+    """Held-out k mapped through the FROZEN training midrank CDF (never re-ranked)."""
+    n = k_tr.size
+    p_tr = tp.midrank_cdf(k_tr, k_tr)
+    p_ho = tp.midrank_cdf(k_tr, k_ho)
+    lo, hi = 0.5 / n, (n - 0.5) / n
+    n_below, n_above = int((p_ho < lo).sum()), int((p_ho > hi).sum())
+    if extrapolation == "boundary_clamp":
+        p_ho = np.clip(p_ho, lo, hi)
+    elif extrapolation == "production_epsilon":
+        p_ho = np.clip(p_ho, 1e-12, 1.0 - 1e-12)
+    else:
+        raise ValueError(extrapolation)
+    meta = {"n_train": n, "n_heldout_below_training_support": n_below,
+            "n_heldout_above_training_support": n_above, "extrapolation": extrapolation}
+    return tp.z_rank_from_cdf(p_tr), tp.z_rank_from_cdf(p_ho), meta
+
+
+def form_linear_rank(k_tr, k_ho, extrapolation="boundary_clamp"):
+    z_tr, z_ho, meta = _frozen_rank(k_tr, k_ho, extrapolation)
+    return z_tr.reshape(-1, 1), z_ho.reshape(-1, 1), meta
+
+
+def form_raw_k(k_tr, k_ho, **_):
+    a, b, meta = _standardise(k_tr, k_ho)
+    return a.reshape(-1, 1), b.reshape(-1, 1), meta
+
+
+def form_log_k(k_tr, k_ho, **_):
+    a, b, meta = _standardise(np.log(k_tr), np.log(k_ho))
+    return a.reshape(-1, 1), b.reshape(-1, 1), meta
+
+
+def _spline_on(vals_tr, vals_ho):
+    qi = np.quantile(vals_tr, SPLINE_INTERNAL_KNOT_QUANTILES)
+    qb = np.quantile(vals_tr, SPLINE_BOUNDARY_KNOT_QUANTILES)
+    knots = np.unique(np.concatenate([[qb[0]], qi, [qb[1]]]))
+    if knots.size < 3:
+        knots = np.unique(np.quantile(vals_tr, [0.1, 0.5, 0.9]))
+    B_tr = rcs_basis(vals_tr, knots)
+    B_ho = rcs_basis(vals_ho, knots)
+    mu = B_tr.mean(axis=0)
+    sd = B_tr.std(axis=0, ddof=1)
+    sd[sd <= 0] = 1.0
+    return ((B_tr - mu) / sd, (B_ho - mu) / sd,
+            {"knots": knots.tolist(), "center": mu.tolist(), "scale": sd.tolist(),
+             "df": int(B_tr.shape[1])})
+
+
+def form_spline_rank(k_tr, k_ho, extrapolation="boundary_clamp"):
+    z_tr, z_ho, rmeta = _frozen_rank(k_tr, k_ho, extrapolation)
+    B_tr, B_ho, meta = _spline_on(z_tr, z_ho)
+    meta.update(rmeta)
+    return B_tr, B_ho, meta
+
+
+def form_spline_log_k(k_tr, k_ho, **_):
+    return _spline_on(np.log(k_tr), np.log(k_ho))
+
+
+FORMS = {
+    "linear_rank": form_linear_rank,
+    "raw_k": form_raw_k,
+    "log_k": form_log_k,
+    "spline_rank": form_spline_rank,
+    "spline_log_k": form_spline_log_k,
+}
+RANK_FORMS = ("linear_rank", "spline_rank")
+
+
+def partial_loglik(beta, X, t, e):
+    nll, _, _ = tp._cox_nll_grad_hess(np.asarray(beta, float), np.asarray(X, float),
+                                     np.asarray(t, float), np.asarray(e, int))
+    return -float(nll)
+
+
+def load_cohort():
+    df = pd.read_parquet("/workspace/kelim_multicohort_standardized.parquet")
+    keep = ["k", "os_weeks", "event", "age_ge65", "ecog"]
+    ven = (df[(df.trial == "VENICE") & (df.os_weeks > LANDMARK)]
+           .dropna(subset=keep).reset_index(drop=True))
+    return ven
+
+
+def run(extrapolation="boundary_clamp"):
+    ven = load_cohort()
+    t_all = ven["os_weeks"].values - LANDMARK
+    e_all = ven["event"].values.astype(int)
+    k_all = ven["k"].values
+    Z_all = np.column_stack([ven["age_ge65"].values, ven["ecog"].values])
+
+    rng = np.random.default_rng(SEED)
+    fold = np.empty(len(ven), dtype=int)
+    for val in (0, 1):                      # stratify on the event indicator
+        idx = rng.permutation(np.flatnonzero(e_all == val))
+        fold[idx] = np.arange(idx.size) % FOLDS
+
+    results = {}
+    for name, fn in FORMS.items():
+        per_fold = []
+        for f in range(FOLDS):
+            ho = fold == f
+            tr = ~ho
+            kwargs = {"extrapolation": extrapolation} if name in RANK_FORMS else {}
+            M_tr, M_ho, meta = fn(k_all[tr], k_all[ho], **kwargs)
+
+            X_tr = np.column_stack([M_tr, Z_all[tr]])
+            fit = tp.cox_fit(X_tr, t_all[tr], e_all[tr])
+
+            X_all = np.empty((len(ven), X_tr.shape[1]))
+            X_all[tr] = X_tr
+            X_all[ho] = np.column_stack([M_ho, Z_all[ho]])
+
+            pl_all = partial_loglik(fit.beta, X_all, t_all, e_all)
+            pl_tr = partial_loglik(fit.beta, X_tr, t_all[tr], e_all[tr])
+            per_fold.append({
+                "fold": f,
+                "n_train": int(tr.sum()), "n_heldout": int(ho.sum()),
+                "events_train": int(e_all[tr].sum()), "events_heldout": int(e_all[ho].sum()),
+                "n_params": int(X_tr.shape[1]),
+                "beta": fit.beta.tolist(),
+                "beta_se": fit.se.tolist(),
+                "converged": bool(fit.converged),
+                "pl_all_at_fold_beta": pl_all,
+                "pl_train_at_fold_beta": pl_tr,
+                "cvpl_contribution": pl_all - pl_tr,
+                "transform_meta": meta,
+            })
+        contrib = np.array([r["cvpl_contribution"] for r in per_fold])
+        ev_ho = float(sum(r["events_heldout"] for r in per_fold))
+        results[name] = {
+            "per_fold": per_fold,
+            "marker_df": int(per_fold[0]["n_params"] - Z_all.shape[1]),
+            "cvpl_total": float(contrib.sum()),
+            "cvpl_per_heldout_event": float(contrib.sum() / ev_ho),
+            "fold_contributions": contrib.tolist(),
+            "fold_mean": float(contrib.mean()),
+            "fold_sd": float(contrib.std(ddof=1)),
+            "fold_se_of_mean": float(contrib.std(ddof=1) / np.sqrt(FOLDS)),
+            "all_folds_converged": all(r["converged"] for r in per_fold),
+        }
+
+    ref = "linear_rank"
+    ref_c = np.array(results[ref]["fold_contributions"])
+    for name in results:
+        d = np.array(results[name]["fold_contributions"]) - ref_c
+        sd = float(d.std(ddof=1))
+        se = sd / np.sqrt(FOLDS)
+        results[name]["vs_linear_rank"] = {
+            "delta_cvpl_total": float(d.sum()),
+            "paired_fold_mean_delta": float(d.mean()),
+            "paired_fold_sd_delta": sd,
+            "paired_fold_se_delta": se,
+            "delta_cvpl_total_se": se * FOLDS,
+            "n_folds_favouring_this_form": int((d > 0).sum()),
+            "paired_fold_deltas": d.tolist(),
+        }
+
+    ranked = sorted(results, key=lambda n: -results[n]["cvpl_total"])
+    return {
+        "document": "Zeta-Core v4 D11 fold-local functional-form validation",
+        "prespecification": "b4_cv_D11 (frozen v1, SHA-256 "
+                            "b666481b1414e850fef419547ef830f6176c3fdfcbbcb73634b1ff4bd6673322)",
+        "cohort": "VENICE landmark survivors, complete covariates",
+        "n": int(len(ven)), "events": int(e_all.sum()),
+        "folds": FOLDS, "seed": SEED,
+        "fold_assignment": "stratified on the event indicator so every fold carries events",
+        "adjustment_set_held_fixed": ["age_ge65", "ecog"],
+        "metric": "cross-validated partial log-likelihood (Verweij & van Houwelingen 1993); "
+                  "higher is better",
+        "held_out_extrapolation_rule": extrapolation,
+        "global_preprocessing_used": False,
+        "candidate_forms": list(FORMS),
+        "results": results,
+        "ranking_best_to_worst": ranked,
+        "best_form": ranked[0],
+        "production_form": ref,
+        "production_form_is_best": ranked[0] == ref,
+    }
+
+
+if __name__ == "__main__":
+    primary = run("boundary_clamp")
+    sens = run("production_epsilon")
+    primary["sensitivity_production_epsilon_extrapolation"] = {
+        "ranking_best_to_worst": sens["ranking_best_to_worst"],
+        "cvpl_total": {n: sens["results"][n]["cvpl_total"] for n in sens["results"]},
+        "delta_vs_primary": {n: sens["results"][n]["cvpl_total"] - primary["results"][n]["cvpl_total"]
+                             for n in sens["results"]},
+        "note": "production reference-CDF epsilon clamp (1e-12) substituted for the "
+                "training-boundary plotting-position clamp; affects only rank-based forms "
+                "and only held-out rows outside the training support",
+    }
+    (OUT / "d11_functional_form.json").write_text(
+        json.dumps(primary, indent=2, sort_keys=True) + "\n")
+
+    print(f"cohort n={primary['n']} events={primary['events']} folds={FOLDS} seed={SEED}")
+    print(f"{'form':<14}{'df':>3}{'CVPL':>11}{'/event':>9}{'foldSD':>9}"
+          f"{'dCVPL vs linear_rank':>26}{'favour':>8}")
+    for name in primary["ranking_best_to_worst"]:
+        r = primary["results"][name]
+        v = r["vs_linear_rank"]
+        print(f"{name:<14}{r['marker_df']:>3}{r['cvpl_total']:>11.4f}"
+              f"{r['cvpl_per_heldout_event']:>9.4f}{r['fold_sd']:>9.4f}"
+              f"{v['delta_cvpl_total']:>+15.4f} +/-{v['delta_cvpl_total_se']:>7.4f}"
+              f"{v['n_folds_favouring_this_form']:>6d}/10")
+    print(f"\nbest form = {primary['best_form']}  |  production form is best: "
+          f"{primary['production_form_is_best']}")
+    print("out-of-support held-out rows per fold (linear_rank):",
+          [(r["transform_meta"]["n_heldout_below_training_support"],
+            r["transform_meta"]["n_heldout_above_training_support"])
+           for r in primary["results"]["linear_rank"]["per_fold"]])
+    print("sensitivity ranking (production epsilon):",
+          primary["sensitivity_production_epsilon_extrapolation"]["ranking_best_to_worst"])
