+            },
+            "against_target_population": {
+                "max_abs_smd_unweighted": float(bal.smd_selected_vs_target_population_unweighted.abs().max()),
+                "max_abs_smd_weighted": float(bal.smd_selected_vs_target_population_weighted.abs().max()),
+                "n_covariates_gt_0p10_unweighted": int(
+                    (bal.smd_selected_vs_target_population_unweighted.abs() > 0.10).sum()),
+                "n_covariates_gt_0p10_weighted": int(
+                    (bal.smd_selected_vs_target_population_weighted.abs() > 0.10).sum()),
+                "n_covariates_gt_0p05_weighted": int(
+                    (bal.smd_selected_vs_target_population_weighted.abs() > 0.05).sum()),
+            },
+            "per_covariate": bal.to_dict(orient="records"),
+        },
+        "cox": cox,
+        "bootstrap": boot,
+    }
+
+
+if __name__ == "__main__":
+    fr = d12.build_frame()
+    lab_cov = {c: float(pd.to_numeric(fr[c], errors="coerce").notna().mean())
+               for c in list(d12.LOG_TRANSFORM_LABS) + list(d12.LINEAR_LABS)}
+    labs_used = [c for c, v in lab_cov.items() if v >= d12.LAB_MIN_COVERAGE]
+    B = int(sys.argv[1]) if len(sys.argv) > 1 else 1000
+    res = analyse(fr, labs_used, b=B)
+    res["baseline_lab_coverage_among_randomized"] = lab_cov
+    res["labs_used"] = labs_used
+    (OUT / "d12_selection_bias.json").write_text(json.dumps(res, indent=2, sort_keys=True) + "\n")
+
+    f, p, w, c, b = res["flow"], res["positivity"], res["weights"], res["cox"], res["bootstrap"]
+    print(f"flow: randomized {f['randomized_with_os_followup']} -> landmark survivors "
+          f"{f['landmark_survivors']} -> analysis set {f['final_analysis_set']} "
+          f"({100*f['selection_fraction_among_landmark_survivors']:.1f}%); "
+          f"excluded {f['excluded_landmark_survivors']}")
+    print(f"propensity range [{p['propensity_min_overall']:.4f}, {p['propensity_max_overall']:.4f}]  "
+          f"common support {[round(x,4) for x in p['common_support_interval']]}  "
+          f"outside: sel={p['n_selected_outside_common_support']} exc={p['n_excluded_outside_common_support']}  "
+          f"params={p['n_propensity_parameters']}  exc/param={p['events_per_parameter_excluded_group']:.1f}")
+    print(f"stabilized weights untruncated mean={w['untruncated']['mean']:.4f} "
+          f"sd={w['untruncated']['sd']:.4f} max={w['untruncated']['max']:.4f}; "
+          f"truncated max={w['truncated']['max']:.4f}; ESS={w['effective_sample_size_truncated']:.1f}/"
+          f"{w['n_selected']}")
+    bb = res["balance"]
+    print(f"balance vs TARGET population (n=590): max|SMD| "
+          f"{bb['against_target_population']['max_abs_smd_unweighted']:.4f} -> "
+          f"{bb['against_target_population']['max_abs_smd_weighted']:.4f}; "
+          f">0.10: {bb['against_target_population']['n_covariates_gt_0p10_unweighted']} -> "
+          f"{bb['against_target_population']['n_covariates_gt_0p10_weighted']}; "
+          f">0.05 after weighting: {bb['against_target_population']['n_covariates_gt_0p05_weighted']}")
+    print(f"descriptive selected-vs-excluded max|SMD| = "
+          f"{bb['descriptive_selected_vs_excluded']['max_abs_smd']:.4f} "
+          f"({bb['descriptive_selected_vs_excluded']['n_covariates_gt_0p10']} covariates > 0.10)")
+    print(f"\nCox beta_z unweighted = {c['unweighted']['beta'][0]:.6f} "
