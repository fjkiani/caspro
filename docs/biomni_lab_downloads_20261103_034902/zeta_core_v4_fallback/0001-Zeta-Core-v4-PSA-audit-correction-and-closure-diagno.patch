+#!/usr/bin/env python3
+"""Mechanically tombstone the stale Zeta-Core main delivery report."""
+from __future__ import annotations
+import argparse, hashlib
+from pathlib import Path
+
+HEADER = "SUPERSEDED — DO NOT USE\nCurrent report: {current}\nCurrent implementation receipt SHA-256: {digest}\n\n"
+
+
+def sha(path: Path): return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def retire(stale: Path, current: Path, receipt: Path):
+    digest=sha(receipt); body=stale.read_text()
+    if body.startswith("SUPERSEDED — DO NOT USE\n"):
+        body=body.split("\n\n",1)[1]
+    stale.write_text(HEADER.format(current=current.name,digest=digest)+body)
+    (Path(str(stale)+".sha256")).write_text(f"{sha(stale)}  {stale.name}\n")
+    return validate(stale,current,receipt)
+
+
+def validate(stale: Path, current: Path, receipt: Path):
+    lines=stale.read_text().splitlines()
+    errors=[]
+    if not lines or lines[0] != "SUPERSEDED — DO NOT USE": errors.append("missing_tombstone")
+    if len(lines)<2 or lines[1] != f"Current report: {current.name}": errors.append("wrong_current_report")
+    if not current.is_file(): errors.append("current_report_missing")
+    expected=f"Current implementation receipt SHA-256: {sha(receipt)}"
+    if len(lines)<3 or lines[2] != expected: errors.append("stale_receipt_digest")
+    return {"verdict":"PASS" if not errors else "FAIL","errors":errors,
+            "current_report":current.name,"implementation_receipt_sha256":sha(receipt)}
+
+
+def main():
+    p=argparse.ArgumentParser(); p.add_argument("stale");p.add_argument("current");p.add_argument("receipt");p.add_argument("--check",action="store_true")
+    a=p.parse_args(); args=tuple(map(Path,(a.stale,a.current,a.receipt)))
+    r=validate(*args) if a.check else retire(*args); print(r); raise SystemExit(r["verdict"]!="PASS")
+if __name__=="__main__": main()
