@@ -0,0 +1,305 @@
+"""Zeta-Core v4 - D12 selection-bias analysis (VENICE).
+
+Estimand and why the landmark is structural
+-------------------------------------------
+The prognostic index is a function of PSA kinetics measured over days 0-105, i.e.
+weeks 0-15.  A subject who dies before week 15 cannot have a k and therefore cannot
+be in the analysis set.  That exclusion is STRUCTURAL, not a selection artifact:
+no inverse-probability weight can recover a quantity that is undefined for those
+subjects, and putting pre-landmark deaths and landmark survivors on a common time
+origin would create immortal-time bias.  Accordingly:
+
+  * the flow reports pre-landmark deaths explicitly and separately;
+  * the selection (eligibility) model is fitted ONLY among landmark survivors, so
+    numerator and denominator share the week-15 time origin;
+  * the target population of the weighted estimate is "randomized VENICE subjects
+    who survived beyond week 15", NOT "all randomized VENICE subjects".
+
+Selection modelled: P(k computable AND covariates complete | baseline covariates),
+among landmark survivors.  Baseline covariates ONLY -- nothing measured after
+randomization enters the eligibility model.  In particular the marker k itself and
+anything derived from post-baseline PSA are excluded by construction.
+
+Weighted Cox uses the SAME frozen z_rank as the unweighted model (computed once on
+the analysis set) so that the weighting is the only thing that changes between the
+two estimates.
+
+Model-based standard errors are NOT valid under inverse-probability weighting;
+all reported uncertainty is nonparametric bootstrap over subjects, refitting the
+propensity model, the weights, the truncation and the Cox model inside every
+replicate.
+"""
+from __future__ import annotations
+
+import json
+import os
+import sys
+from pathlib import Path
+
+import numpy as np
+import pandas as pd
+
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+import d10_transport_core as tp  # noqa: E402
+
+LANDMARK_WEEKS = 15.0
+RAW = Path(os.environ.get("ZC4_VENICE_RAW", "/workspace/cas_raw/VENICE"))
+OUT = Path(os.environ.get("ZC4_D12_OUT", "/workspace/zc4_d12"))
+OUT.mkdir(parents=True, exist_ok=True)
+
+# ---- prespecified analysis choices, fixed before any estimate was inspected ----
+BOOTSTRAP_B = 1000
+BOOTSTRAP_SEED = 20260813
+WEIGHT_TRUNCATION_PERCENTILES = (1.0, 99.0)      # prespecified, symmetric
+LOG_TRANSFORM_LABS = ("PSA", "ALP", "AST", "ALT", "CREAT", "TBILI")
+LINEAR_LABS = ("HB", "ALB", "WBC", "CA")
+LAB_MIN_COVERAGE = 0.90                          # drop a lab below this coverage (excludes LDH)
+AGE_TOP_CODE = 85.0
+PROPENSITY_RIDGE = 1e-6                          # numerical stabiliser only
+
+# A missingness indicator enters the eligibility model only if its cell is large
+# enough to be estimable. This is a pure covariate-distribution rule: it looks only
+# at how many values are missing, never at selection status or at any outcome, so it
+# cannot be a result-driven choice. Indicators with tiny homogeneous cells otherwise
+# induce perfect separation and propensities numerically equal to 0 or 1.
+MIN_MISSING_CELL_FOR_INDICATOR = 10
+
+
+# --------------------------------------------------------------------------- #
+def logistic_fit(X, y, ridge=0.0, max_iter=200, tol=1e-10):
+    """IRLS logistic regression with intercept prepended. Returns (beta, converged)."""
+    X = np.asarray(X, float)
+    y = np.asarray(y, float)
+    D = np.column_stack([np.ones(len(X)), X])
+    beta = np.zeros(D.shape[1])
+    for _ in range(max_iter):
+        eta = D @ beta
+        p = 1.0 / (1.0 + np.exp(-np.clip(eta, -500, 500)))
+        w = np.clip(p * (1.0 - p), 1e-12, None)
+        g = D.T @ (y - p) - ridge * beta
+        H = (D * w[:, None]).T @ D + ridge * np.eye(D.shape[1])
+        try:
+            step = np.linalg.solve(H, g)
+        except np.linalg.LinAlgError:
+            return beta, False
+        beta_new = beta + step
+        if np.max(np.abs(step)) < tol:
+            return beta_new, True
+        beta = beta_new
+    return beta, False
+
+
+def logistic_predict(beta, X):
+    D = np.column_stack([np.ones(len(X)), np.asarray(X, float)])
+    return 1.0 / (1.0 + np.exp(-np.clip(D @ beta, -500, 500)))
+
+
+def firth_logistic_fit(X, y, max_iter=500, tol=1e-9):
+    """Firth penalized logistic regression (Jeffreys-prior penalty).
+
+    The standard remedy for separation: the penalized score adds h_i*(0.5 - p_i),
+    where h_i is the i-th diagonal of the hat matrix, giving finite estimates and
+    propensities strictly inside (0, 1) even when a covariate cell is homogeneous.
+    """
+    X = np.asarray(X, float)
+    y = np.asarray(y, float)
+    D = np.column_stack([np.ones(len(X)), X])
+    beta = np.zeros(D.shape[1])
+    for _ in range(max_iter):
+        p = 1.0 / (1.0 + np.exp(-np.clip(D @ beta, -500, 500)))
+        w = np.clip(p * (1.0 - p), 1e-12, None)
+        Dw = D * np.sqrt(w)[:, None]
+        F = Dw.T @ Dw
+        try:
+            Finv = np.linalg.inv(F)
+        except np.linalg.LinAlgError:
+            return beta, False
+        h = np.einsum("ij,jk,ik->i", Dw, Finv, Dw)          # hat matrix diagonal
+        g = D.T @ (y - p + h * (0.5 - p))
+        try:
+            step = np.linalg.solve(F, g)
+        except np.linalg.LinAlgError:
+            return beta, False
+        nrm = np.max(np.abs(step))
+        if nrm > 5.0:                                        # damp wild early steps
+            step *= 5.0 / nrm
+        beta = beta + step
+        if np.max(np.abs(step)) < tol:
+            return beta, True
+    return beta, False
+
+
+# --------------------------------------------------------------------------- #
+def weighted_cox_fit(X, time, event, weight, max_iter=100, tol=1e-10):
+    """Weighted Cox partial likelihood, Efron ties, matching survival::coxph.
+
+    With every weight equal to 1 this reduces exactly to the unweighted Efron fit,
+    which is asserted in the self-check.
+    """
+    X = np.asarray(X, float)
+    time = np.asarray(time, float)
+    event = np.asarray(event, int)
+    w = np.asarray(weight, float)
+    n, p = X.shape
+    beta = np.zeros(p)
+
+    order = np.argsort(-time, kind="stable")      # descending time
+    Xs, ts, es, ws = X[order], time[order], event[order], w[order]
+
+    def nll_grad_hess(b):
+        eta = np.clip(Xs @ b, -500, 500)
+        r = ws * np.exp(eta)
+        ll = 0.0
+        grad = np.zeros(p)
+        hess = np.zeros((p, p))
+        S0 = 0.0
+        S1 = np.zeros(p)
+        S2 = np.zeros((p, p))
+        i = 0
+        while i < n:
+            j = i
+            while j < n and ts[j] == ts[i]:
+                j += 1
+            for m in range(i, j):                 # accumulate risk set (descending time)
+                S0 += r[m]
+                S1 += r[m] * Xs[m]
+                S2 += r[m] * np.outer(Xs[m], Xs[m])
+            d_idx = [m for m in range(i, j) if es[m] == 1]
+            d = len(d_idx)
+            if d:
+                wd = ws[d_idx].sum()
+                D0 = r[d_idx].sum()
+                D1 = (r[d_idx, None] * Xs[d_idx]).sum(axis=0)
+                D2 = np.einsum("i,ij,ik->jk", r[d_idx], Xs[d_idx], Xs[d_idx])
+                ll += float((ws[d_idx] * (Xs[d_idx] @ b)).sum())
+                grad += (ws[d_idx, None] * Xs[d_idx]).sum(axis=0)
+                for l in range(d):
+                    f = l / d
+                    a0 = S0 - f * D0
+                    a1 = S1 - f * D1
+                    a2 = S2 - f * D2
+                    cw = wd / d
+                    ll -= cw * np.log(a0)
+                    mu = a1 / a0
+                    grad -= cw * mu
+                    hess += cw * (a2 / a0 - np.outer(mu, mu))
+            i = j
+        return -ll, -grad, hess
+
+    converged = False
+    for _ in range(max_iter):
+        nll, g, H = nll_grad_hess(beta)
+        try:
+            step = np.linalg.solve(H, -g)
+        except np.linalg.LinAlgError:
+            break
+        t_step = 1.0
+        for _ in range(40):                       # step halving
+            cand = beta + t_step * step
+            if nll_grad_hess(cand)[0] <= nll + 1e-12:
+                break
+            t_step *= 0.5
+        beta_new = beta + t_step * step
+        if np.max(np.abs(beta_new - beta)) < tol:
+            beta = beta_new
+            converged = True
+            break
+        beta = beta_new
+    nll, g, H = nll_grad_hess(beta)
+    try:
+        cov = np.linalg.inv(H)
+    except np.linalg.LinAlgError:
+        cov = np.full((p, p), np.nan)
+    return {"beta": beta, "cov": cov, "loglik": -nll, "grad_norm": float(np.max(np.abs(g))),
+            "converged": converged}
+
+
+# --------------------------------------------------------------------------- #
+def build_frame():
+    """Assemble the VENICE analysis frame. Patient-level; never leaves /workspace."""
+    addm = pd.read_parquet(RAW / "addm.parquet")[["USUBJID", "AGEGRP", "ARMCD", "ECOGIVRN", "ECOGCRFN"]]
+    adtte = pd.read_parquet(RAW / "adtte.parquet")
+    adlb = pd.read_parquet(RAW / "adlb.parquet")
+    std = pd.read_parquet("/workspace/kelim_multicohort_standardized.parquet")
+    ven_std = std[std.trial == "VENICE"][["patient_id", "k", "os_weeks", "event", "age_ge65", "ecog"]]
+
+    os_rows = adtte[adtte["PARAMCD"].eq("OS")][["USUBJID", "AVAL", "ATTE"]].rename(
+        columns={"AVAL": "event", "ATTE": "os_weeks"})
+    df = os_rows.merge(addm, on="USUBJID", how="left")
+
+    age = pd.to_numeric(df["AGEGRP"].replace({">=85": str(AGE_TOP_CODE), "": np.nan}), errors="coerce")
+    df["age"] = age
+    df["ecog_raw"] = df["ECOGIVRN"].where(df["ECOGIVRN"].notna(), df["ECOGCRFN"])
+    df["arm_docetaxel_combo"] = (df["ARMCD"].astype(str).str.upper() != df["ARMCD"].astype(str).str.upper().mode()[0]).astype(float)
+
+    bl = adlb[adlb["LBBLFL"].astype(str).str.upper().eq("Y")]
+    wanted = list(LOG_TRANSFORM_LABS) + list(LINEAR_LABS)
+    piv = (bl[bl["LBTESTCD"].isin(wanted)]
+           .groupby(["USUBJID", "LBTESTCD"])["LBSTRESN"].median().unstack())
+    for c in wanted:
+        if c not in piv.columns:
+            piv[c] = np.nan
+    df = df.merge(piv[wanted].reset_index(), on="USUBJID", how="left")
+
+    df["in_analysis_set"] = df["USUBJID"].isin(set(ven_std["patient_id"].astype(str))).astype(int)
+    df = df.merge(ven_std.rename(columns={"patient_id": "USUBJID"})[["USUBJID", "k", "age_ge65", "ecog"]],
+                  on="USUBJID", how="left")
+    df["landmark_survivor"] = (df["os_weeks"] > LANDMARK_WEEKS).astype(int)
+    df["complete_locked_covariates"] = df[["age_ge65", "ecog"]].notna().all(axis=1).astype(int)
+    df["final_analysis_set"] = (df["in_analysis_set"] & df["landmark_survivor"]
+                                & df["complete_locked_covariates"]).astype(int)
+    return df
+
+
+def design_matrix(df, labs_used, min_missing_cell=MIN_MISSING_CELL_FOR_INDICATOR):
+    """Baseline-only design. Median imputation, with a missingness indicator added only
+    when the missing cell reaches ``min_missing_cell`` observations."""
+    cols, names, imputed = [], [], {}
+    def add(vals, name, log=False):
+        v = pd.to_numeric(vals, errors="coerce").astype(float).values.copy()
+        if log:
+            v = np.where(v > 0, v, np.nan)
+            v = np.log(v)
+        miss = ~np.isfinite(v)
+        med = float(np.nanmedian(v)) if np.isfinite(v).any() else 0.0
+        v[miss] = med
+        sd = float(np.std(v, ddof=1)) or 1.0
+        cols.append((v - float(np.mean(v))) / sd)
+        names.append(name)
+        imputed[name] = int(miss.sum())
+        n_miss = int(miss.sum())
+        if n_miss >= min_missing_cell and n_miss <= len(v) - min_missing_cell:
+            cols.append(miss.astype(float))
+            names.append(f"{name}__missing")
+    add(df["age"], "age")
+    add(df["ecog_raw"], "ecog")
+    cols.append(df["arm_docetaxel_combo"].fillna(0.0).values); names.append("arm")
+    for c in labs_used:
+        add(df[c], f"{'log_' if c in LOG_TRANSFORM_LABS else ''}{c}", log=c in LOG_TRANSFORM_LABS)
+
+    # Drop degenerate columns so the information matrix is not silently rank
+    # deficient. A constant column is collinear with the intercept; a binary column
+    # whose minority cell is below the minimum cell size is not estimable. Both rules
+    # look only at the covariate distribution, never at selection status or outcome.
+    M = np.column_stack(cols)
+    keep, dropped = [], []
+    for j, nm in enumerate(names):
+        v = M[:, j]
+        uniq = np.unique(v)
+        if uniq.size < 2:
+            dropped.append((nm, "constant"))
+            continue
+        if uniq.size == 2:
+            minority = int(min((v == uniq[0]).sum(), (v == uniq[1]).sum()))
+            if minority < min_missing_cell:
+                dropped.append((nm, f"binary minority cell {minority} < {min_missing_cell}"))
+                continue
+        keep.append(j)
+    M = M[:, keep]
+    kept_names = [names[j] for j in keep]
+    D = np.column_stack([np.ones(len(M)), M])
+    rank = int(np.linalg.matrix_rank(D))
+    if rank < D.shape[1]:
+        raise ValueError(f"eligibility design is rank deficient: rank {rank} < {D.shape[1]} columns")
+    return M, kept_names, {"imputed_counts": imputed, "dropped_columns": dropped,
+                           "design_rank": rank, "design_columns": D.shape[1]}
