+#!/usr/bin/env python3
+"""Build closure-grade D10/D11/D12 receipts from frozen analysis outputs.
+
+No patient-level values are emitted. D10 re-expresses the frozen B=1000 result;
+D11 adds diagnostic analyses to the frozen fold assignment; D12 adds split
+missingness and explicit measured-selection limitations.
+"""
+from __future__ import annotations
+
+import argparse
+import itertools
+import json
+import math
+import os
+import sys
+from pathlib import Path
+
+import numpy as np
+import pandas as pd
+from scipy.stats import t as student_t
+
+HERE = Path(__file__).resolve().parent
+sys.path.insert(0, str(HERE))
+import d11_functional_form_validation as d11  # noqa: E402
+import d12_selection_core as d12  # noqa: E402
+
+STATUS = {
+    "focused": "FOCUSED_ACCEPTANCE_GATES_PASS",
+    "repository": "REPOSITORY_WIDE_SUITE_RED",
+    "remote": "REMOTE_DELIVERY_BLOCKED",
+    "deployment": "PRODUCTION_DEPLOYMENT_NOT_PERFORMED",
+}
+
+
+def load(path: str | Path):
+    return json.loads(Path(path).read_text())
+
+
+def dump(path: Path, payload):
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n")
+
+
+def ci(src, key):
+    x = src["ci"][key]
+    return [x["lo"], x["hi"]]
+
+
+def interval_class(point, interval, gate):
+    lo, hi = interval
+    gl, gh = gate
+    point_inside = gl <= point <= gh
+    ci_inside = gl <= lo and hi <= gh
+    overlap = not (hi < gl or lo > gh)
+    if point_inside and ci_inside:
+        return "PASS"
+    if not overlap:
+        return "CLEAR_FAIL"
+    return "INDETERMINATE"
+
+
+def gate_margin(point, gate):
+    gl, gh = gate
+    if point < gl:
+        return {"boundary": gl, "signed_margin": point - gl, "direction": "below_lower"}
+    if point > gh:
+        return {"boundary": gh, "signed_margin": gh - point, "direction": "above_upper"}
+    return {"boundary": min((gl, gh), key=lambda x: abs(point - x)),
+            "signed_margin": min(point - gl, gh - point), "direction": "inside"}
+
+
+def build_d10(src):
+    oe_gate, slope_gate = [0.9, 1.1], [0.8, 1.2]
+    rows = []
+    comp = src["point_estimates"]["COMPARATOR"]
+    comp_ci = src["bootstrap_ci"]["COMPARATOR"]
+    comp_h = {int(x["horizon_weeks_post_landmark"]): x for x in comp["per_horizon"]}
+    for variant in ("T1", "T2"):
+        point = src["point_estimates"][variant]
+        bci = src["bootstrap_ci"][variant]
+        for hrow in point["per_horizon"]:
+            h = int(hrow["horizon_weeks_post_landmark"])
+            if h not in (26, 52):
+                continue
+            oe = hrow["observed_to_expected"]
+            slope = hrow["calibration_slope"]
+            rows.append({
+                "variant": variant,
+                "horizon_weeks_post_landmark": h,
+                "gate_eligible": True,
+                "n_at_risk": hrow["venice_at_risk"],
+                "predicted": {"expected_events_cumhaz": hrow["expected_events_cumhaz"],
+                              "mean_predicted_risk": hrow["mean_predicted_risk"]},
+                "observed": {"events": hrow["observed_events"],
+                             "km_risk": hrow["km_observed_risk"]},
+                "observed_to_expected": {"point": oe, "ci95": ci(bci, f"oe@{h}"),
+                    "gate": oe_gate, "margin": gate_margin(oe, oe_gate),
+                    "classification": interval_class(oe, ci(bci, f"oe@{h}"), oe_gate)},
+                "calibration_intercept": {"point": hrow["calibration_intercept"],
+                                           "ci95": ci(bci, f"cal_int@{h}")},
+                "calibration_slope": {"point": slope, "ci95": ci(bci, f"cal_slope@{h}"),
+                    "gate": slope_gate, "margin": gate_margin(slope, slope_gate),
+                    "classification": interval_class(slope, ci(bci, f"cal_slope@{h}"), slope_gate)},
+                "brier": {"point": hrow["brier"], "ci95": ci(bci, f"brier@{h}")},
+                "comparator_brier": {"point": comp_h[h]["brier"],
+                                      "ci95": ci(comp_ci, f"brier@{h}")},
+                "time_dependent_auc": {"point": hrow["time_dependent_auc"],
+                                        "ci95": ci(bci, f"auc@{h}")},
+                "ibs": {"point": point["integrated_brier_score"],
+                        "ci95": ci(bci, "ibs")},
+                "comparator_ibs": {"point": comp["integrated_brier_score"],
+                                   "ci95": ci(comp_ci, "ibs")},
+                "ibs_margin_vs_comparator": comp["integrated_brier_score"] - point["integrated_brier_score"],
+            })
+    labels = [r[m]["classification"] for r in rows
+              for m in ("observed_to_expected", "calibration_slope")]
+    return {
+        "document": "Zeta-Core v4 D10 complete transport table v2",
+        "status": STATUS,
+        "bootstrap": src["bootstrap"],
+        "support": src["support"],
+        "gate_interpretation": {
+            "attainment": "NOT_MET",
+            "PASS": "point and full 95% CI inside acceptance interval",
+            "CLEAR_FAIL": "95% CI has no overlap with acceptance interval",
+            "INDETERMINATE": "all other cases, including a failing point with CI overlap",
+            "nothing_activated": True,
+            "note": "Gate non-attainment is distinct from certainty. A transport gate result cannot activate an API field.",
+        },
+        "rows": rows,
+        "classification_counts": {x: labels.count(x) for x in ("PASS", "CLEAR_FAIL", "INDETERMINATE")},
+        "excluded_from_gating": {"horizon_weeks": 104,
+            "reason": "predeclared derivation support criterion not met"},
+    }
+
+
+def holm(pvalues):
+    n = len(pvalues)
+    order = np.argsort(pvalues)
+    out = np.empty(n)
+    running = 0.0
+    for rank, idx in enumerate(order):
+        running = max(running, (n - rank) * pvalues[idx])
+        out[idx] = min(1.0, running)
+    return out.tolist()
+
+
+def full_design(name, k, age, ecog):
+    fn = d11.FORMS[name]
+    kwargs = {"extrapolation": "boundary_clamp"} if name in d11.RANK_FORMS else {}
+    M, _, meta = fn(k, k, **kwargs)
+    cols = [f"marker_{i+1}" for i in range(M.shape[1])] + ["age_ge65", "ecog"]
+    return pd.DataFrame(np.column_stack([M, age, ecog]), columns=cols), meta
+
+
+def ph_and_influence(ven, name):
+    from lifelines import CoxPHFitter
+    from lifelines.statistics import proportional_hazard_test
+    k = ven["k"].to_numpy(float)
+    X, meta = full_design(name, k, ven["age_ge65"].to_numpy(float), ven["ecog"].to_numpy(float))
+    fitdf = X.copy()
+    fitdf["duration"] = ven["os_weeks"].to_numpy(float) - d11.LANDMARK
+    fitdf["event"] = ven["event"].to_numpy(int)
+    cph = CoxPHFitter().fit(fitdf, "duration", "event", show_progress=False)
+    tests = {}
+    for transform in ("km", "rank"):
+        z = proportional_hazard_test(cph, fitdf, time_transform=transform).summary.reset_index()
+        term_col = z.columns[0]
+        rows = [{"term": str(r[term_col]), "chi2": float(r["test_statistic"]),
+                 "p": float(r["p"])} for _, r in z.iterrows()]
+        adj = holm([r["p"] for r in rows])
+        for r, a in zip(rows, adj):
+            r["holm_p_within_model"] = a
+        marker_rows = [r for r in rows if r["term"].startswith("marker_")]
+        tests[transform] = {"terms": rows,
+            "marker_block_conservative_flag": any(r["holm_p_within_model"] < 0.05 for r in marker_rows),
+            "definition": "any Holm-adjusted marker-basis term p < 0.05; not an omnibus proof"}
+    delta = cph.compute_residuals(fitdf, kind="delta_beta")
+    q05, q95 = np.quantile(k, [0.05, 0.95])
+    tail = (k <= q05) | (k >= q95)
+    marker_cols = [c for c in delta.columns if c.startswith("marker_")]
+    return {"fit_converged": True, "transform_meta": meta, "tests": tests,
+            "tail_influence": {"tail_definition": "k <= q05 or k >= q95",
+                "n_tail": int(tail.sum()),
+                "max_abs_marker_delta_beta_tail": float(np.abs(delta.loc[tail, marker_cols]).to_numpy().max()),
+                "max_abs_marker_delta_beta_nontail": float(np.abs(delta.loc[~tail, marker_cols]).to_numpy().max())}}
+
+
+def build_d11(src):
+    results = src["results"]
+    pairs = []
+    for a, b in itertools.combinations(src["candidate_forms"], 2):
+        da = np.asarray(results[a]["fold_contributions"])
+        db = np.asarray(results[b]["fold_contributions"])
+        d = da - db
+        se = d.std(ddof=1) / math.sqrt(len(d))
+        crit = student_t.ppf(0.975, len(d) - 1)
+        pairs.append({"form_a": a, "form_b": b, "delta_a_minus_b_by_fold": d.tolist(),
+            "mean": float(d.mean()), "sd": float(d.std(ddof=1)), "se": float(se),
+            "descriptive_ci95": [float(d.mean() - crit * se), float(d.mean() + crit * se)],
+            "folds_favouring_a": int((d > 0).sum()), "folds_favouring_b": int((d < 0).sum()),
+            "caveat": "descriptive only; cross-validation training sets overlap"})
+    ven = d11.load_cohort()
+    k = ven["k"].to_numpy(float)
+    e = ven["event"].to_numpy(int)
+    tail = {}
+    for q in (0.05, 0.10):
+        lo, hi = np.quantile(k, [q, 1-q])
+        tail[f"q{int(q*100):02d}"] = {"lower_cut": float(lo), "upper_cut": float(hi),
+            "lower_n": int((k <= lo).sum()), "lower_events": int(e[k <= lo].sum()),
+            "upper_n": int((k >= hi).sum()), "upper_events": int(e[k >= hi].sum())}
+    fold_support = []
+    # Fold assignment exactly reproduces the frozen runner.
+    rng = np.random.default_rng(src["seed"]); fold = np.empty(len(ven), int)
+    for val in (0, 1):
+        idx = rng.permutation(np.flatnonzero(e == val)); fold[idx] = np.arange(idx.size) % src["folds"]
+    for f in range(src["folds"]):
+        tr, ho = fold != f, fold == f
+        lo, hi = k[tr].min(), k[tr].max(); sd = k[tr].std(ddof=1)
+        below, above = k[ho] < lo, k[ho] > hi
+        dist = np.maximum(np.maximum(lo-k[ho], 0), np.maximum(k[ho]-hi, 0)) / sd
+        fold_support.append({"fold": f, "n_train": int(tr.sum()), "n_heldout": int(ho.sum()),
+            "below_training_support": int(below.sum()), "above_training_support": int(above.sum()),
+            "max_standardized_extrapolation_distance": float(dist.max()),
+            "spline_log_k_knots": results["spline_log_k"]["per_fold"][f]["transform_meta"]["knots"],
+            "raw_k_center": results["raw_k"]["per_fold"][f]["transform_meta"]["center"],
+            "raw_k_scale": results["raw_k"]["per_fold"][f]["transform_meta"]["scale"]})
+    diagnostics = {}
+    for name in src["candidate_forms"]:
+        try:
+            diagnostics[name] = ph_and_influence(ven, name)
+        except Exception as exc:
+            diagnostics[name] = {"fit_converged": False, "error_type": type(exc).__name__, "error": str(exc)}
+    return {**src, "document": "Zeta-Core v4 D11 qualified functional-form receipt v2",
+        "status": STATUS, "all_pairwise_fold_differences": pairs,
+        "proportional_hazards_and_influence": diagnostics,
+        "tail_support": {"full_cohort": tail, "per_fold": fold_support},
+        "qualified_conclusion": "No tested functional form was distinguishable under the prespecified comparison; the linear rank model is retained for parsimony, not because its form was validated."}
+
+
+def build_d12(src):
+    fr = d12.build_frame()
+    ls = fr[fr["landmark_survivor"] == 1].copy()
+    sel = ls["final_analysis_set"].astype(bool)
+    raw_cov = {"age": "age", "ecog": "ecog", "log_PSA": "PSA", "log_ALP": "ALP",
+               "log_AST": "AST", "log_ALT": "ALT", "log_CREAT": "CREAT",
+               "log_TBILI": "TBILI", "HB": "HB", "ALB": "ALB", "WBC": "WBC", "CA": "CA"}
+    split_missing = {}
+    for c, source in raw_cov.items():
+        x = pd.to_numeric(ls[source], errors="coerce")
+        split_missing[c] = {"source_baseline_variable": source,
+                            "eligible_missing": int(x[sel].isna().sum()),
+                            "eligible_n": int(sel.sum()),
+                            "excluded_missing": int(x[~sel].isna().sum()),
+                            "excluded_n": int((~sel).sum())}
+    notable = []
+    for r in src["balance"]["per_covariate"]:
+        v = r["smd_selected_vs_excluded_unweighted"]
+        if abs(v) > 0.10:
+            notable.append({"covariate": r["covariate"], "smd_selected_minus_excluded": v,
+                "direction": "selected_higher" if v > 0 else "selected_lower"})
+    src = dict(src)
+    src.update({"document": "Zeta-Core v4 D12 qualified selection-bias receipt v2",
+        "status": STATUS, "missingness_by_eligibility": split_missing,
+        "notable_selected_vs_excluded_differences": notable,
+        "bootstrap_procedure": {"unit": "landmark-survivor subject", "B": src["bootstrap"]["B_requested"],
+            "seed": src["bootstrap"]["seed"],
+            "inside_each_replicate": ["eligibility model", "propensity predictions", "stabilized weights",
+                                      "1st/99th percentile truncation", "unweighted Cox", "weighted Cox"],
+            "pre_landmark_deaths": "excluded structurally and never reweighted"},
+        "selection_limitation": "Weighting addresses measured baseline selection only. Unmeasured selection bias remains possible."})
+    return src
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--d10", required=True); ap.add_argument("--d11", required=True)
+    ap.add_argument("--d12", required=True); ap.add_argument("--out", required=True)
+    a = ap.parse_args(); out = Path(a.out)
+    d10, d11p, d12p = build_d10(load(a.d10)), build_d11(load(a.d11)), build_d12(load(a.d12))
+    dump(out / "d10_transport_complete_v2.json", d10)
+    dump(out / "d11_functional_form_qualified_v2.json", d11p)
+    dump(out / "d12_selection_bias_qualified_v2.json", d12p)
+    print(json.dumps({"d10_rows": len(d10["rows"]), "d10_classes": d10["classification_counts"],
+                      "d11_pairs": len(d11p["all_pairwise_fold_differences"]),
+                      "d11_ph_models": len(d11p["proportional_hazards_and_influence"]),
+                      "d12_missingness_variables": len(d12p["missingness_by_eligibility"])}, indent=2))
+
+
+if __name__ == "__main__":
+    main()
