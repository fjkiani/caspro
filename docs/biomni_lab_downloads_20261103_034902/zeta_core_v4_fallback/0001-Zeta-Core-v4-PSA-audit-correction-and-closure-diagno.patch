+# The static-subtree exemption is PROVED by patient-invariance
+# ══════════════════════════════════════════════════════════════════════════════
+def test_static_subtrees_are_patient_invariant():
+    """Exempting a subtree from the lineage walk requires evidence, not a comment.
+
+    ``band_status``, ``exploratory_band_definition``, ``interval_semantics`` and
+    the other explanatory subtrees contain forbidden vocabulary by construction —
+    they are the fields that EXPLAIN the suppression. They are exempt only
+    because they are frozen constants. The proof is that two different refused
+    patients receive byte-identical values for every exempt field.
+    """
+    import json
+
+    first = _payload(THREE_NONMONOTONE)["relative_prognostic_index"]
+    second = _payload(NOISY_OTHER)["relative_prognostic_index"]
+    assert first["ineligible_reason"] != second["ineligible_reason"]
+    assert first["k_day"] != second["k_day"]
+
+    compared = 0
+    for field in sorted(STATIC_SUBTREE_FIELDS):
+        if field not in first:
+            continue
+        assert field in second, field
+        assert json.dumps(first[field], sort_keys=True, default=str) == json.dumps(
+            second[field], sort_keys=True, default=str
+        ), field
+        compared += 1
+    assert compared >= 10, f"only {compared} static subtrees were actually compared"
+
+
+def test_the_exempt_subtree_list_does_not_silently_cover_a_numeric_field(refused_block):
+    """An exempt name must not be a per-patient number hiding behind an exemption."""
+    for field in sorted(STATIC_SUBTREE_FIELDS):
+        value = refused_block.get(field, None)
+        if isinstance(value, (int, float)) and not isinstance(value, bool):
+            # A numeric exempt field is allowed only if it is a frozen constant.
+            other = _payload(NOISY_OTHER)["relative_prognostic_index"].get(field)
+            assert value == other, field
