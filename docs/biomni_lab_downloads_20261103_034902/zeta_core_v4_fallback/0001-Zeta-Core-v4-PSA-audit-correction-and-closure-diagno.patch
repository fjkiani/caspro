+# ══════════════════════════════════════════════════════════════════════════════
+# The boundary is declared honestly
+# ══════════════════════════════════════════════════════════════════════════════
+def test_the_boundary_statement_refuses_to_overclaim():
+    text = rs.REFUSAL_BOUNDARY_STATEMENT
+    assert "not an information-theoretic" in text
+    assert "k_day" in text
+    for overclaim in (
+        "cannot be reconstructed",
+        "information-theoretically",
+        "provably private",
+        "differentially private",
+    ):
+        assert overclaim not in text, overclaim
+
+
+def test_the_forbidden_vocabulary_is_not_empty_and_covers_the_five_families():
+    assert len(FORBIDDEN_LINEAGE_ROOTS) >= 18
+    assert len(FORBIDDEN_LINEAGE_ALIASES) >= 26
+    assert len(FORBIDDEN_TRANSFORM_SUFFIXES) >= 21
+    for family in ("percentile", "zrank", "multiplier", "interval", "band"):
+        assert family in FORBIDDEN_LINEAGE_ROOTS or family in FORBIDDEN_LINEAGE_ALIASES
+
+
+# ══════════════════════════════════════════════════════════════════════════════
+# Each prohibited ROOT is injected individually, at top level and at depth
+# ══════════════════════════════════════════════════════════════════════════════
+@pytest.mark.parametrize("root", sorted(FORBIDDEN_LINEAGE_ROOTS))
+def test_each_forbidden_root_is_rejected_individually(root, refused_block):
+    field = f"patient_{root}_value"
+    injected = dict(refused_block)
+    injected[field] = 0.5426
+    with pytest.raises(RefusalSchemaError) as excinfo:
+        assert_refusal_schema(
+            injected,
+            allowed=REFUSED_BLOCK_ALLOWED_FIELDS,
+            null_required=REFUSED_BLOCK_NULL_REQUIRED_FIELDS,
+            what="injection probe",
+        )
+    assert field in str(excinfo.value)
+
+
+@pytest.mark.parametrize("root", sorted(FORBIDDEN_LINEAGE_ROOTS))
+def test_each_forbidden_root_is_rejected_when_nested_at_depth(root, refused_block):
+    """A flat key check would pass this. The rule is recursive, so it does not."""
+    field = f"{root}_estimate"
+    injected = dict(refused_block)
+    injected["fit_precision_receipt_extra"] = {
+        "diagnostics": [{"inner": {field: 0.5426}}]
+    }
+    violations = lineage_violations(
+        injected,
+        allowed=REFUSED_BLOCK_ALLOWED_FIELDS,
+        null_required=REFUSED_BLOCK_NULL_REQUIRED_FIELDS,
+    )
+    paths = " ".join(v.path for v in violations)
+    assert field in paths, (root, violations[:4])
+    assert "diagnostics" in paths
+    # The violation names the offending key and the rule that caught it.
+    hit = [v for v in violations if v.field == field]
+    assert hit, (field, [v.field for v in violations])
+    assert hit[0].rule in {"FORBIDDEN_ROOT", "FORBIDDEN_ALIAS", "FORBIDDEN_TRANSFORM"}
+
+
+# ══════════════════════════════════════════════════════════════════════════════
+# Each prohibited ALIAS is injected individually
+# ══════════════════════════════════════════════════════════════════════════════
+@pytest.mark.parametrize("alias", sorted(FORBIDDEN_LINEAGE_ALIASES))
+def test_each_forbidden_alias_is_rejected_as_a_whole_name(alias, refused_block):
+    injected = dict(refused_block)
+    injected[alias] = 0.5426
+    with pytest.raises(RefusalSchemaError) as excinfo:
+        assert_refusal_schema(
+            injected,
+            allowed=REFUSED_BLOCK_ALLOWED_FIELDS,
+            null_required=REFUSED_BLOCK_NULL_REQUIRED_FIELDS,
+            what="alias probe",
+        )
+    assert alias in str(excinfo.value)
+
+
+@pytest.mark.parametrize("alias", sorted(FORBIDDEN_LINEAGE_ALIASES))
+def test_each_forbidden_alias_is_rejected_as_a_whole_segment(alias, refused_block):
+    """``psa_<alias>_v2`` must be caught, while ``chronic`` must not be."""
+    field = f"psa_{alias}_v2"
+    injected = dict(refused_block)
+    injected[field] = 0.5426
+    with pytest.raises(RefusalSchemaError) as excinfo:
+        assert_refusal_schema(
+            injected,
+            allowed=REFUSED_BLOCK_ALLOWED_FIELDS,
+            null_required=REFUSED_BLOCK_NULL_REQUIRED_FIELDS,
+            what="segment probe",
+        )
+    assert field in str(excinfo.value)
+
+
+@pytest.mark.parametrize(
+    "benign",
+    [
+        "chronic_condition",
+        "precision_status",
+        "fit_precision_status",
+        "k_day",
+        "prognostic_eligible",
+        "decline_sign_stability",
+        "archive_note",
+        "hrqol_note",
+        "circadian_flag",
+    ],
+)
+def test_alias_matching_does_not_fire_on_substrings(benign):
+    """``hr`` inside ``chronic`` and ``ci`` inside ``precision`` are not aliases.
+
+    A substring rule would make the allow-list unusable and would train everyone
+    to bypass the check. Matching is on whole names and whole segments only.
+    """
+    violations = lineage_violations({benign: 1.0}, allowed=frozenset({benign}))
+    assert violations == [], (benign, violations)
+
+
+# ══════════════════════════════════════════════════════════════════════════════
+# Each TRANSFORMED DESCENDANT is injected individually
+# ══════════════════════════════════════════════════════════════════════════════
+@pytest.mark.parametrize("suffix", sorted(FORBIDDEN_TRANSFORM_SUFFIXES))
+@pytest.mark.parametrize("stem", ["percentile", "z_rank", "relative_hazard_multiplier"])
+def test_each_transformed_descendant_is_rejected(suffix, stem, refused_block):
+    field = f"{stem}_{suffix}"
+    injected = dict(refused_block)
+    injected[field] = 0.5426
+    with pytest.raises(RefusalSchemaError) as excinfo:
+        assert_refusal_schema(
+            injected,
+            allowed=REFUSED_BLOCK_ALLOWED_FIELDS,
+            null_required=REFUSED_BLOCK_NULL_REQUIRED_FIELDS,
+            what="transform probe",
+        )
+    assert field in str(excinfo.value)
+
+
+# ══════════════════════════════════════════════════════════════════════════════
+# The allow-list is authoritative: an unknown BENIGN name is also refused
+# ══════════════════════════════════════════════════════════════════════════════
+@pytest.mark.parametrize(
+    "unknown", ["debug_payload", "internal_notes", "raw_series", "cohort_row_index"]
+)
+def test_an_unknown_field_is_rejected_even_with_no_forbidden_lineage(
+    unknown, refused_block
+):
+    injected = dict(refused_block)
+    injected[unknown] = "anything"
+    with pytest.raises(RefusalSchemaError, match="NOT_ON_ALLOW_LIST"):
+        assert_refusal_schema(
+            injected,
+            allowed=REFUSED_BLOCK_ALLOWED_FIELDS,
+            null_required=REFUSED_BLOCK_NULL_REQUIRED_FIELDS,
+            what="unknown-field probe",
+        )
+
+
+# ══════════════════════════════════════════════════════════════════════════════
+# Allow-listed-but-forbidden-lineage names are pinned to None
+# ══════════════════════════════════════════════════════════════════════════════
+@pytest.mark.parametrize("field", sorted(REFUSED_BLOCK_NULL_REQUIRED_FIELDS))
+def test_each_null_required_block_field_is_rejected_when_it_carries_a_value(
+    field, refused_block
+):
+    """The refused block deliberately emits the FULL key set with nulls.
+
+    Emitting the same key set on every path is what makes a stale cache or a
+    partially-populated response detectable, so the keys are NOT deleted. That
+    design choice would be a hole if the names were merely allow-listed, so each
+    one is separately pinned to ``None`` and a value in it is a violation.
+    """
+    assert refused_block[field] is None
+    injected = dict(refused_block)
+    injected[field] = 0.5426
+    with pytest.raises(RefusalSchemaError, match="LINEAGE_FIELD_NOT_NULL"):
+        assert_refusal_schema(
+            injected,
+            allowed=REFUSED_BLOCK_ALLOWED_FIELDS,
+            null_required=REFUSED_BLOCK_NULL_REQUIRED_FIELDS,
+            what="null-pin probe",
+        )
+
+
+@pytest.mark.parametrize("field", sorted(REFUSED_RECEIPT_NULL_REQUIRED_FIELDS))
+def test_each_null_required_receipt_field_is_rejected_when_it_carries_a_value(
+    field, refused_receipt
+):
+    assert refused_receipt[field] is None
+    injected = dict(refused_receipt)
+    injected[field] = (0.53, 0.55)
+    with pytest.raises(RefusalSchemaError, match="LINEAGE_FIELD_NOT_NULL"):
+        assert_refusal_schema(
+            injected,
+            allowed=REFUSED_RECEIPT_ALLOWED_FIELDS,
+            null_required=REFUSED_RECEIPT_NULL_REQUIRED_FIELDS,
+            what="receipt null-pin probe",
+        )
+
+
+# ══════════════════════════════════════════════════════════════════════════════
+# The real refused responses pass, on every refusal reason
+# ══════════════════════════════════════════════════════════════════════════════
+@pytest.mark.parametrize(
+    "series,reason",
+    [
+        (THREE_NONMONOTONE, "DECLINE_SIGN_NOT_INDEPENDENTLY_ESTABLISHED"),
+        (NOISY, "UNSTABLE_DECLINE_SIGN"),
+        (RISING, "NONPOSITIVE_DECLINE_RATE"),
+    ],
+)
+def test_every_refusal_reason_produces_a_schema_clean_response(series, reason):
+    payload = _payload(series)
+    block = payload["relative_prognostic_index"]
+    assert block["eligible"] is False
+    assert block["ineligible_reason"] == reason
+    assert (
+        lineage_violations(
+            block,
+            allowed=REFUSED_BLOCK_ALLOWED_FIELDS,
+            null_required=REFUSED_BLOCK_NULL_REQUIRED_FIELDS,
+        )
+        == []
+    )
+    assert (
+        lineage_violations(
+            payload["fit_precision_receipt"],
+            allowed=REFUSED_RECEIPT_ALLOWED_FIELDS,
+            null_required=REFUSED_RECEIPT_NULL_REQUIRED_FIELDS,
+        )
+        == []
+    )
+    # k_day is still on the wire: Contract A releases the rate on every path.
+    assert block["k_day"] is not None
+    assert payload["kinetics"]["k_day"] == block["k_day"]
+
+
+# ══════════════════════════════════════════════════════════════════════════════
+# Serialization actually fails — the guard is not merely available
+# ══════════════════════════════════════════════════════════════════════════════
+@pytest.mark.parametrize(
+    "field",
+    [
+        "reference_percentile_log",
+        "z_rank_scaled",
+        "recovered_percentile",
+        "multiplier_hat",
+        "risk_band_proxy",
+        "percentile_ci",
+        "hr",
+        "pct",
+    ],
+)
+def test_serialization_fails_when_a_prohibited_field_is_injected(field, monkeypatch):
+    """Inject into the serializer's own output and prove serialization FAILS.
+
+    This is the difference between having a validator and enforcing one: the
+    injection is applied to the block the serializer just built, so a guard has
+    to fire on the path that produces the response.
+
+    Two independent guards cover this, and the ORDER matters for interpreting the
+    result. Adding a NEW key changes the block key set, so the pre-existing
+    key-set drift guard raises ``SerializationSafetyError`` before the refusal
+    schema is reached. That guard is real enforcement, but it is NOT the refusal
+    boundary: it only detects a changed key set, so it is blind to a forbidden
+    VALUE placed in an already-present key. The test below
+    (``...a_value_in_an_existing_null_pinned_key...``) covers exactly that case,
+    which only the refusal schema can catch. Neither guard alone is sufficient.
+    """
+    from api.services.tumor_marker_kinetics import serializer as sz
+    from api.services.tumor_marker_kinetics.serializer import SerializationSafetyError
+
+    original = sz._prognostic_block
+
+    def _leaky(*args, **kwargs):
+        block = dict(original(*args, **kwargs))
+        block[field] = 0.5426
+        return block
+
+    monkeypatch.setattr(sz, "_prognostic_block", _leaky)
+    with pytest.raises((RefusalSchemaError, SerializationSafetyError)):
+        _payload(THREE_NONMONOTONE)
+
+
+@pytest.mark.parametrize("field", sorted(REFUSED_BLOCK_NULL_REQUIRED_FIELDS))
+def test_serialization_fails_on_a_value_in_an_existing_null_pinned_key(
+    field, monkeypatch
+):
+    """The case the key-set drift guard structurally cannot catch.
+
+    The refused block emits the full key set with nulls, so writing a value into
+    an existing key leaves the key set unchanged and the drift guard silent. This
+    is the leak shape that matters in practice -- a withheld field quietly
+    repopulated -- and the refusal schema is what stops it.
+    """
+    from api.services.tumor_marker_kinetics import serializer as sz
+
+    original = sz._prognostic_block
+
+    def _leaky(*args, **kwargs):
+        block = dict(original(*args, **kwargs))
+        assert field in block, field
+        block[field] = 0.5426
+        return block
+
+    from api.services.tumor_marker_kinetics.serializer import SerializationSafetyError
+
+    monkeypatch.setattr(sz, "_prognostic_block", _leaky)
+    with pytest.raises((RefusalSchemaError, SerializationSafetyError)) as excinfo:
+        _payload(THREE_NONMONOTONE)
+    assert field in str(excinfo.value)
+
+
+def test_the_new_schema_covers_fields_the_pre_existing_sweep_cannot_see():
+    """The measurable improvement over the pre-existing guard, stated as a set.
+
+    Before this change the only value-level check on a refused body was a sweep
+    over ``FIT_PRECISION_RECEIPT_REDACTED_ON_INELIGIBLE`` -- seven receipt keys.
+    That sweep is real and is retained (it fires first for the three fields it
+    shares with the block), but it has no opinion about
+    ``reference_percentile``, ``z_rank``, ``prognostic_log_hazard_index``,
+    ``relative_hazard_multiplier``, the coefficient interval or the band. Those
+    are the withheld quantities themselves. A refused response could have carried
+    a repopulated ``reference_percentile`` and no guard would have objected.
+    """
+    from api.services.tumor_marker_kinetics.models import (
+        FIT_PRECISION_RECEIPT_REDACTED_ON_INELIGIBLE as OLD_SWEEP,
+    )
+
+    old = set(OLD_SWEEP)
+    new = set(REFUSED_BLOCK_NULL_REQUIRED_FIELDS)
+    newly_covered = new - old
+    assert {
+        "reference_percentile",
+        "z_rank",
+        "prognostic_log_hazard_index",
+        "relative_hazard_multiplier",
+        "coefficient_conditional_relative_hazard_interval",
+        "relative_prognostic_band",
+    } <= newly_covered, sorted(newly_covered)
+    # And the block-level names the old sweep did cover are still covered.
+    assert {"percentile_uncertainty_interval", "multiplier_uncertainty_interval"} <= new
+
+
+def test_the_injection_probe_is_only_armed_on_a_refused_path(monkeypatch):
+    """Control for the test above: the same injection on an ELIGIBLE path.
+
+    The refusal schema governs refused responses only. If the eligible path also
+    raised, the previous test would prove nothing about refusals specifically.
+    """
+    from api.services.tumor_marker_kinetics import serializer as sz
+
+    original = sz._prognostic_block
+
+    def _leaky(*args, **kwargs):
+        block = dict(original(*args, **kwargs))
+        block["reference_percentile_log"] = 0.5426
+        return block
+
+    monkeypatch.setattr(sz, "_prognostic_block", _leaky)
+    clean = [(0.0, 100.0), (14.0, 82.0), (28.0, 66.0), (42.0, 54.0), (56.0, 44.0)]
+    # A NEW key still trips the key-set drift guard on any path, so the control
+    # is run through the refusal schema directly: on an eligible response the
+    # refusal allow-list is not applied at all.
+    from api.services.tumor_marker_kinetics import serializer as sz2
+
+    monkeypatch.setattr(sz2, "_prognostic_block", original)
+    payload = _payload(clean)
+    block = payload["relative_prognostic_index"]
+    assert block["eligible"] is True
+    assert block["reference_percentile"] is not None
+    # Proof the refusal rules were genuinely not applied here: an eligible block
+    # carries live values in fields that a refused block must pin to None.
+    live = [f for f in REFUSED_BLOCK_NULL_REQUIRED_FIELDS if block.get(f) is not None]
+    assert live, "an eligible response released nothing the refusal rules withhold"
+    with pytest.raises(RefusalSchemaError):
+        assert_refusal_schema(
