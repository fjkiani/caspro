+"""Directive item 1 — the refused-response boundary is SCHEMA-based, not numeric.
+
+WHAT WAS DELETED
+────────────────
+The previous release asserted this as a security/privacy invariant:
+
+    no number in a refused response lies within 0.01 of the withheld percentile
+
+That is not a leak test. It fails on all three axes a leak test is judged on:
+
+* **transform-blindness** — a field carrying ``logit(percentile)`` or
+  ``100 * percentile`` passes the proximity check while leaking exactly the same
+  information;
+* **single-target** — it compares against one hand-picked value, so it says
+  nothing about a percentile belonging to any other patient, nor about a
+  quantity that happens to be numerically far from this patient's value;
+* **enumeration** — it cannot make any statement about a field nobody thought to
+  look at, which is the failure mode that actually ships.
+
+WHAT REPLACES IT
+────────────────
+An explicit allow-list plus a recursive lineage rule, validated before the
+response is serialized:
+
+* the refused block and the refused receipt each have a closed allow-list;
+* a forbidden-root set covers percentile / z-rank / multiplier / interval / band
+  vocabulary;
+* a forbidden-alias set covers the short spellings (``pct``, ``hr``, ``ci``, ...)
+  matched on whole names and whole underscore segments, never on substrings;
+* a forbidden-transform-suffix set covers *descendants* of those quantities
+  (``percentile_log``, ``z_rank_scaled``, ``multiplier_hat``, ...);
+* the walk is recursive through dicts and lists, so a nested receipt section
+  cannot smuggle a value past a flat key check;
+* names that are on the allow-list only because they contain forbidden lineage
+  (``band_status``, ``reference_z_rank``, ``interval_semantics``) are pinned to
+  ``None`` by a separate rule, so an allow-listed name carrying a VALUE is a
+  violation. This is strictly stronger than deleting the key, because deletion
+  cannot detect that case at all.
+
+Every prohibited name and alias below is injected INDIVIDUALLY, at top level and
+at depth, and serialization is proved to fail.
+
+WHAT IS NOT CLAIMED
+───────────────────
+This is a release boundary, not an information-theoretic one. ``k_day`` and the
+committed reference CDF are both released under Contract A, so a consumer can
+compute a percentile themselves. The guarantee is that THIS SERVICE does not
+endorse one on a refused path, and the response says so in words.
+"""
+from __future__ import annotations
+
+import asyncio
+
+import pytest
+
+from api.services.tumor_marker_kinetics import refusal_schema as rs
+from api.services.tumor_marker_kinetics.refusal_schema import (
+    FORBIDDEN_LINEAGE_ALIASES,
+    FORBIDDEN_LINEAGE_ROOTS,
+    FORBIDDEN_TRANSFORM_SUFFIXES,
+    REFUSED_BLOCK_ALLOWED_FIELDS,
+    REFUSED_BLOCK_NULL_REQUIRED_FIELDS,
+    REFUSED_RECEIPT_ALLOWED_FIELDS,
+    REFUSED_RECEIPT_NULL_REQUIRED_FIELDS,
+    STATIC_SUBTREE_FIELDS,
+    RefusalSchemaError,
+    assert_refusal_schema,
+    lineage_violations,
+)
+
+from api.routers.ayesha_therapy_fit import (
+    MarkerKineticsFitRequest,
+    MarkerObservationIn,
+    tumor_marker_kinetics_fit,
+)
+
+# ── Fixtures: the shapes an actually-refused response takes ───────────────────
+#: A non-monotone three-day series. The bootstrap sign statistic is undefined at
+#: n = 3, so the deterministic LOO rule arbitrates and cannot establish the sign.
+THREE_NONMONOTONE = [(0.0, 100.0), (28.0, 130.0), (56.0, 44.0)]
+#: A noisy five-day series whose resampled decline sign is unstable.
+NOISY = [(0.0, 100.0), (14.0, 140.0), (28.0, 62.0), (42.0, 150.0), (56.0, 48.0)]
+#: A rising series: the point rate is non-positive, so the index is undefined.
+RISING = [(0.0, 40.0), (14.0, 55.0), (28.0, 70.0), (42.0, 88.0), (56.0, 110.0)]
+#: A DIFFERENT refused patient, used to prove the static-subtree exemption by
+#: patient-invariance rather than by assertion.
+NOISY_OTHER = [(0.0, 61.0), (14.0, 96.0), (28.0, 33.0), (42.0, 104.0), (56.0, 29.0)]
+
+
+def _request(series, **overrides):
+    kwargs = dict(
+        axis_id="PROSTATE_PSA_KINETICS",
+        marker_id="PSA",
+        canonical_unit="NG/ML",
+        unit_factors_to_canonical={"NG/ML": 1.0, "UG/L": 1.0},
+        early_window_start_day=0.0,
+        early_window_end_day=105.0,
+        positive_floor=0.01,
+        time_kind="day",
+        observations=[
+            MarkerObservationIn(time=t, value=v, unit="ng/mL", analyte="PSA")
+            for t, v in series
+        ],
+    )
+    kwargs.update(overrides)
+    return MarkerKineticsFitRequest(**kwargs)
+
+
+def _payload(series, **overrides):
+    """Drive the REAL route handler, so this is the shape that reaches the wire."""
+    return asyncio.run(tumor_marker_kinetics_fit(_request(series, **overrides)))
+
+
+@pytest.fixture(scope="module")
+def refused_block():
+    payload = _payload(THREE_NONMONOTONE)
+    block = payload["relative_prognostic_index"]
+    assert block["eligible"] is False
+    assert block["ineligible_reason"] == "DECLINE_SIGN_NOT_INDEPENDENTLY_ESTABLISHED"
+    return block
+
+
+@pytest.fixture(scope="module")
+def refused_receipt():
+    payload = _payload(THREE_NONMONOTONE)
+    receipt = payload["fit_precision_receipt"]
+    assert receipt["receipt_redacted"] is True
