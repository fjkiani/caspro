@@ -0,0 +1,430 @@
+"""D13 — tests that hold the audit-correction directive in place.
+
+The 2026 audit found a release that had *evaluated* a prespecified band-stability
+gate, *failed* it (quartile-knot concordance 0.6662 against a required 0.90) and
+then shipped the band anyway. It also found a Cox-coefficient-only interval
+labelled as if it were a patient-level confidence interval, and no patient-level
+rate-reliability output at all.
+
+This module tests the corrections directly, independently of the older contract
+and router suites:
+
+* **D2** the categorical band is null on every code path, the failed gate is
+  published as data, and no emitted continuous field permits a consumer to
+  reconstruct a category from the serialized payload alone.
+* **D3** the interval carries its corrected name and its coefficient-only scope
+  statement, and the retired name is absent from the wire.
+* **D5** individual fit precision is emitted, is *fail-closed* when the sign of
+  the decline is not stable, and its receipt is redacted on a refused path so the
+  refused percentile cannot be recovered from an interval midpoint.
+* **D8** a landmark scope that the API could not verify from dates is VISIBLY
+  unverified.
+* **D9** the hand-written Uno tAUC / IPCW-Graf Brier / IBS implementations agree
+  with scikit-survival on frozen deterministic censored fixtures inside the
+  frozen 1e-8 tolerance.
+
+None of these tests may be satisfied by weakening a production guard.
+"""
+from __future__ import annotations
+
+import json
+import math
+import pathlib
+import sys
+
+import pytest
+
+from api.services.tumor_marker_kinetics import fit_precision as fp
+from api.services.tumor_marker_kinetics import prognostic_index as pi
+from api.services.tumor_marker_kinetics import refusal_schema as rs
+from api.services.tumor_marker_kinetics.models import (
+    BAND_STABILITY_GATE_OBSERVED,
+    BAND_STABILITY_GATE_PASS,
+    BAND_STABILITY_GATE_REQUIRED,
+    BAND_STATUS_UNSTABLE,
+    BAND_SUPPRESSION_STATEMENT,
+    COEFFICIENT_INTERVAL_STATEMENT,
+    EXPLORATORY_BAND_DEFINITION_STATUS,
+    FIT_PRECISION_RECEIPT_REDACTED_ON_INELIGIBLE,
+    LANDMARK_SCOPE_SOURCE_CALLER_ATTESTED,
+    LANDMARK_SCOPE_SOURCE_DERIVED_FROM_DATES,
+    LANDMARK_SCOPE_SOURCE_NOT_ESTABLISHED,
+    PROSTATE_PROGNOSTIC_RELEASED_OUTPUTS,
+    FitPrecisionStatus,
+    RelativePrognosticIndex,
+    exploratory_band_definition,
+)
+
+# ── shared fixtures ───────────────────────────────────────────────────────────
+#: A clean 5-point declining PSA series (days, ng/mL). Reliable by construction.
+CLEAN = [(0.0, 100.0), (14.0, 82.0), (28.0, 66.0), (42.0, 54.0), (56.0, 44.0)]
+
+#: The same nominal decline with enough scatter that the SIGN of the fitted rate
+#: is not stable across day-level bootstrap resamples.
+NOISY = [(0.0, 100.0), (14.0, 140.0), (28.0, 62.0), (42.0, 150.0), (56.0, 48.0)]
+
+BOOTSTRAP_B = 1000
+BOOTSTRAP_SEED = 20260813
+
+
+def _k_day(series):
+    """The locked V1 recipe: median-collapse per day, OLS on log(value), k = -slope."""
+    collapsed = fp.collapse_distinct_days([t for t, _ in series], [v for _, v in series])
+    return fp.negative_ols_slope(
+        [t for t, _ in collapsed], [math.log(max(v, 0.01)) for _, v in collapsed]
+    )
+
+
+def _precision(series):
+    return fp.bootstrap_fit_precision(
+        time_days=[t for t, _ in series],
+        marker_values=[v for _, v in series],
+        k_day=_k_day(series),
+        replicates=BOOTSTRAP_B,
+        seed=BOOTSTRAP_SEED,
+    )
+
+
+def _index(series=CLEAN, **overrides):
+    precision = _precision(series)
+    kwargs = dict(
+        k_day=_k_day(series),
+        landmark_confirmed=True,
+        fit_precision=precision,
+        landmark_scope_source=LANDMARK_SCOPE_SOURCE_DERIVED_FROM_DATES,
+        landmark_scope_verified=True,
+    )
+    kwargs.update(overrides)
+    return pi.compute_relative_prognostic_index(**kwargs)
+
+
+# ══════════════════════════════════════════════════════════════════════════════
+# D2 — the failed gate must change runtime behaviour
+# ══════════════════════════════════════════════════════════════════════════════
+def test_the_band_gate_is_recorded_as_failed_and_is_not_a_tunable():
+    assert BAND_STABILITY_GATE_OBSERVED == 0.6662
+    assert BAND_STABILITY_GATE_REQUIRED == 0.90
+    assert BAND_STABILITY_GATE_PASS is False
+    assert BAND_STABILITY_GATE_OBSERVED < BAND_STABILITY_GATE_REQUIRED
+
+
+def test_an_eligible_index_still_emits_a_null_band():
+    index = _index()
+    assert index.eligible is True
+    assert index.relative_prognostic_band is None
+    assert index.band_status == BAND_STATUS_UNSTABLE == "UNSTABLE_NOT_FOR_RENDERING"
+    assert index.band_gate_pass is False
+
+
+def test_the_dataclass_refuses_to_be_constructed_with_a_populated_band():
+    """The suppression is a type-level invariant, not a serializer convention."""
+    index = _index()
+    payload = {f: getattr(index, f) for f in index.__dataclass_fields__}
+    payload["relative_prognostic_band"] = "LOWER_RELATIVE_HAZARD"
+    with pytest.raises(ValueError):
+        RelativePrognosticIndex(**payload)
+
+
+def test_the_quartile_mapping_survives_only_as_an_exploratory_definition():
+    definition = exploratory_band_definition()
+    assert definition["status"] == EXPLORATORY_BAND_DEFINITION_STATUS
+    assert definition["lower_percentile_cut"] == 0.25
+    assert definition["upper_percentile_cut"] == 0.75
+    assert definition["gate"]["passed"] is False
+    # The helper still evaluates the retired mapping so the audit can reproduce
+    # the failed gate, and its answers still respect the frozen direction.
+    assert pi.exploratory_relative_prognostic_band(0.90) == "LOWER_RELATIVE_HAZARD"
+    assert pi.exploratory_relative_prognostic_band(0.10) == "HIGHER_RELATIVE_HAZARD"
+
+
+def test_no_released_output_reconstructs_a_category_for_the_consumer():
+    """A UI holding only the payload has no categorical field to render."""
+    index = _index()
+    released = pi.released_prognostic_payload(index, k_day=_k_day(CLEAN))
+    assert set(released) == set(PROSTATE_PROGNOSTIC_RELEASED_OUTPUTS)
+    assert released["relative_prognostic_band"] is None
+    assert released["band_status"] == BAND_STATUS_UNSTABLE
+    assert released["band_gate_pass"] is False
+    # Nothing on the wire is a category string other than the typed status and
+    # the explicitly-labelled exploratory definition block.
+    categorical = {"LOWER_RELATIVE_HAZARD", "MIDDLE_RELATIVE_HAZARD", "HIGHER_RELATIVE_HAZARD"}
+    flat = json.dumps(
+        {k: v for k, v in released.items() if k != "exploratory_band_definition"},
+        default=str,
+    )
+    for label in categorical:
+        assert label not in flat, label
+
+
+def test_the_suppression_statement_names_the_gate_and_forbids_inference():
+    for phrase in (
+        "suppressed because its prespecified stability gate failed",
+        "must not be inferred from reference_percentile",
+    ):
+        assert phrase in BAND_SUPPRESSION_STATEMENT, phrase
+
+
+# ══════════════════════════════════════════════════════════════════════════════
+# D3 — the interval is coefficient-conditional, never a patient-level CI
+# ══════════════════════════════════════════════════════════════════════════════
+def test_the_interval_is_renamed_and_the_retired_name_is_gone():
+    released = pi.released_prognostic_payload(_index(), k_day=_k_day(CLEAN))
+    assert "coefficient_conditional_relative_hazard_interval" in released
+    assert "relative_hazard_multiplier_ci" not in released
+    assert not hasattr(_index(), "relative_hazard_multiplier_ci")
+
+
+def test_the_interval_statement_is_the_mandated_wording():
+    assert COEFFICIENT_INTERVAL_STATEMENT == (
+        "This interval propagates Cox coefficient uncertainty only. It does not "
+        "include uncertainty in the patient's PSA-rate fit, reference CDF or "
+        "assay measurements."
+    )
+
+
+def test_the_coefficient_only_interval_collapses_at_the_reference_patient():
+    """D6's structural finding, asserted: sd[log multiplier] = |z_rank| * SE, so
+    the coefficient-only interval has ZERO width at z_rank = 0. That is exactly
+    why it cannot be presented as a patient-level confidence interval."""
+    lo, hi = pi.coefficient_conditional_interval_from_z(0.0)
+    assert lo == hi == pytest.approx(1.0, abs=1e-15)
+    wide_lo, wide_hi = pi.coefficient_conditional_interval_from_z(2.0)
+    assert wide_hi - wide_lo > 0.1
+
+
+# ══════════════════════════════════════════════════════════════════════════════
+# D5 — individual fit precision, and fail-closed on an unstable decline sign
+# ══════════════════════════════════════════════════════════════════════════════
+def test_a_clean_series_is_reliable_and_reproduces_its_point_estimate():
+    report = _precision(CLEAN)
+    assert report.status == FitPrecisionStatus.RELIABLE
+    assert report.point_k_day_reproduced is True
+    assert report.decline_sign_stability == 1.0
+    assert report.n_distinct_days == 5
+
+
+def test_an_unstable_decline_sign_fails_closed_completely():
+    report = _precision(NOISY)
+    assert report.status == FitPrecisionStatus.SIGN_UNSTABLE
+    assert report.decline_sign_stability < 0.95
+    index = _index(NOISY)
+    assert index.eligible is False
+    assert index.ineligible_reason == "UNSTABLE_DECLINE_SIGN"
+    for withheld in (
+        "reference_percentile",
+        "z_rank",
+        "prognostic_log_hazard_index",
+        "relative_hazard_multiplier",
+        "coefficient_conditional_relative_hazard_interval",
+    ):
+        assert getattr(index, withheld) is None, withheld
+
+
+def test_three_distinct_days_serve_the_point_but_no_uncertainty():
+    """A 3-day patient IS a member of the validated n=446 population, so the
+    point estimate is served; only the uncertainty outputs are withheld."""
+    index = _index(CLEAN[:3])
+    assert index.eligible is True
+    assert index.fit_precision_status == FitPrecisionStatus.INSUFFICIENT_FOR_UNCERTAINTY
+    assert index.reference_percentile is not None
+    for spread in (
+        "k_day_uncertainty_interval",
+        "percentile_uncertainty_interval",
+        "multiplier_uncertainty_interval",
+    ):
+        assert getattr(index, spread) is None, spread
+
+
+def test_the_bootstrap_reports_a_boundary_crossing_probability():
+    report = _precision(CLEAN)
+    assert 0.0 <= report.boundary_crossing_probability <= 1.0
+    assert 0.0 <= report.boundary_crossing_probability_unconditional <= 1.0
+    # The unconditional figure can only be >= the conditional one, because the
+    # conditioning set (positive-finite replicates) is a subset.
+    assert (
+        report.boundary_crossing_probability_unconditional
+        >= report.boundary_crossing_probability - 1e-12
+    )
+
+
+def test_the_bootstrap_is_deterministic_under_the_frozen_seed():
+    a = _precision(CLEAN)
+    b = _precision(CLEAN)
+    assert a.percentile_uncertainty_interval == b.percentile_uncertainty_interval
+    assert a.decline_sign_stability == b.decline_sign_stability
+
+
+def test_the_receipt_is_redacted_on_a_refused_path():
+    """The percentile-space sections of the receipt are withheld on a refusal.
+
+    The invariant enforced here is SCHEMA-based, not numeric: the prespecified
+    redaction set is emptied, and every remaining name is on the receipt
+    allow-list with no percentile/z-rank/multiplier/interval/band lineage. See
+    ``tests/unit/test_refusal_schema_lineage.py`` for the per-field injection
+    proof, which is what actually establishes the boundary.
+
+    CONTRACT A note: ``landmark_confirmed=False`` no longer refuses anything, so
+    the refused construction is now a genuine fail-closed path (an unstable
+    resampled decline sign).
+    """
+    refused = _index(NOISY)
+    assert refused.eligible is False
+    assert refused.ineligible_reason == "UNSTABLE_DECLINE_SIGN"
+    receipt = fp.released_fit_precision_receipt(_precision(CLEAN), index_eligible=False)
+    assert receipt["receipt_redacted"] is True
+    for key in FIT_PRECISION_RECEIPT_REDACTED_ON_INELIGIBLE:
+        assert receipt[key] is None, key
+    # The rate-space interval IS deliberately retained; the receipt says so.
+    assert receipt["k_day_uncertainty_interval"] is not None
+    assert "release boundary" in receipt["receipt_scope_statement"]
+    # And the receipt must not claim a stronger boundary than it has.
+    assert "not an information-theoretic one" in receipt["receipt_scope_statement"]
+
+
+def test_numeric_proximity_is_an_exploratory_probe_and_not_a_leak_proof():
+    """RETIRED AS AN INVARIANT (directive item 1).
+
+    The rule "no number in a refused response lies within 0.01 of the withheld
+    percentile" was previously asserted as a security/privacy invariant. It is
+    not one, for three independent reasons:
+
+    1. it is defeated by any monotone transform, so a field carrying
+       ``logit(percentile)`` passes while leaking the same information;
+    2. it tests a single hand-picked target value rather than a field set, so it
+       says nothing about a percentile belonging to a different patient;
+    3. it cannot speak about fields nobody thought to examine, which is exactly
+       the failure mode a leak test has to cover.
+
+    The probe is retained ONLY as exploratory defence-in-depth. This test asserts
+    the probe RUNS and is REPORTED; it deliberately does not assert the probe is
+    clean, because a clean probe is not evidence of non-leakage and a dirty probe
+    is not by itself a leak.
+    """
+    served = _index()
+    receipt = fp.released_fit_precision_receipt(_precision(CLEAN), index_eligible=False)
+    hits = rs.numeric_proximity_probe(receipt, served.reference_percentile)
+    assert isinstance(hits, list)
+    for path, value in hits:
+        assert isinstance(path, str) and isinstance(value, float)
+    # The probe's own docstring must disclaim proof status, so that a reader of
+    # the source cannot mistake a clean run for a guarantee.
+    assert "NOT A NON-LEAKAGE PROOF" in rs.numeric_proximity_probe.__doc__
+
+
+def test_an_eligible_receipt_is_not_redacted():
+    receipt = fp.released_fit_precision_receipt(_precision(CLEAN), index_eligible=True)
+    assert receipt["receipt_redacted"] is False
+    assert receipt["redacted_fields"] == []
+    assert receipt["percentile_uncertainty_interval"] is not None
+
+
+# ══════════════════════════════════════════════════════════════════════════════
+# D8 — an unverifiable landmark scope is visibly unverified
+# ══════════════════════════════════════════════════════════════════════════════
+def test_dates_produce_a_derived_and_verified_landmark_scope():
+    attestation = pi.landmark_attestation(
+        landmark_confirmed=True,
+        treatment_start_date="2024-01-01",
+        last_known_alive_or_event_date="2024-09-30",
+    )
+    assert attestation["landmark_scope_source"] == LANDMARK_SCOPE_SOURCE_DERIVED_FROM_DATES
+    assert attestation["landmark_scope_verified"] is True
+    assert attestation["derived_landmark_interval_days"] > 105.0
+
+
+def test_a_bare_assertion_is_caller_attested_and_never_verified():
+    attestation = pi.landmark_attestation(
+        landmark_confirmed=True, survived_through_landmark_day=140.0
+    )
+    assert attestation["landmark_scope_source"] == LANDMARK_SCOPE_SOURCE_CALLER_ATTESTED
+    assert attestation["landmark_scope_verified"] is False
+    assert attestation["attested"] is True
+
+
+def test_no_assertion_and_no_dates_leaves_the_scope_not_established():
+    attestation = pi.landmark_attestation(landmark_confirmed=None)
+    assert attestation["landmark_scope_source"] == LANDMARK_SCOPE_SOURCE_NOT_ESTABLISHED
+    assert attestation["landmark_scope_verified"] is False
+    assert attestation["attested"] is False
+
+
+def test_dates_contradicting_the_caller_assertion_are_surfaced():
+    attestation = pi.landmark_attestation(
+        landmark_confirmed=True,
+        treatment_start_date="2024-01-01",
+        last_known_alive_or_event_date="2024-02-01",
+    )
+    assert attestation["derived_landmark_interval_days"] < 105.0
+    assert attestation["caller_assertion_contradicted_dates"] is True
+    assert attestation["attested"] is False
+
+
+# ══════════════════════════════════════════════════════════════════════════════
+# D9 — the hand-written survival metrics agree with a trusted library
+# ══════════════════════════════════════════════════════════════════════════════
+_FIXTURE = pathlib.Path(__file__).resolve().parents[1] / "fixtures" / "d9_survival_metric_equivalence.json"
+_TOLERANCE = 1e-8
+
+
+def _survival_metrics_module():
+    root = pathlib.Path(__file__).resolve().parents[2]
+    path = str(root / "scripts" / "validation")
+    if path not in sys.path:
+        sys.path.insert(0, path)
+    import survival_metrics  # noqa: PLC0415
+
+    return survival_metrics
+
+
+def _fixture_doc():
+    return json.loads(_FIXTURE.read_text())
+
+
+def test_the_frozen_fixture_and_its_tolerance_are_present():
+    doc = _fixture_doc()
+    assert doc["provenance"]["frozen_absolute_tolerance"] == _TOLERANCE
+    assert "scikit-survival" in doc["provenance"]["reference_library"]
+    assert len(doc["fixtures"]) == 7
+    assert set(doc["fixtures"]) == set(doc["reference_values"]["results"])
+
+
+@pytest.mark.parametrize(
+    "name",
+    [
+        "F1_generic",
+        "F2_tied_event_times",
+        "F3_tied_risk_scores",
+        "F4_censor_before_first_event",
+        "F5_no_censoring",
+        "F6_heavy_censoring",
+        "F7_train_test",
+    ],
+)
+def test_our_metrics_match_scikit_survival_on_the_frozen_fixtures(name):
+    import numpy as np
+
+    sm = _survival_metrics_module()
+    doc = _fixture_doc()
+    fx = doc["fixtures"][name]
+    ref = doc["reference_values"]["results"][name]
+
+    train_time = np.asarray(fx["train_time"], dtype=float)
+    train_event = np.asarray(fx["train_event"], dtype=bool)
+    test_time = np.asarray(fx["test_time"], dtype=float)
+    test_event = np.asarray(fx["test_event"], dtype=bool)
+    times = np.asarray(fx["times"], dtype=float)
+    surv = np.asarray(fx["surv"], dtype=float)
+    risk = np.asarray(fx["risk"], dtype=float)
+
+    _, brier = sm.brier_score(train_time, train_event, test_time, test_event, surv, times)
+    ibs = sm.integrated_brier_score(
+        train_time, train_event, test_time, test_event, surv, times
+    )
+    auc, mean_auc = sm.cumulative_dynamic_auc(
+        train_time, train_event, test_time, test_event, risk, times
+    )
+
+    assert np.max(np.abs(np.asarray(brier) - np.asarray(ref["brier"]))) <= _TOLERANCE
+    assert abs(ibs - ref["ibs"]) <= _TOLERANCE
+    assert np.max(np.abs(np.asarray(auc) - np.asarray(ref["auc"]))) <= _TOLERANCE
+    assert abs(mean_auc - ref["mean_auc"]) <= _TOLERANCE
