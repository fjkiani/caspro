--- /dev/null
+++ b/scripts/validation/d10_transport_core.py
@@ -0,0 +1,244 @@
+"""Zeta-Core v4 - D10 absolute-risk transport: TAX327 -> VENICE.
+
+Frozen prespecification b1_support_rule_D10 (SHA-256 b666481b...):
+  horizons_weeks_post_landmark = [26, 52, 78, 104]
+  gate_eligible_horizon_requires = >= 20 at risk in the TAX327 DERIVATION set
+                                   AND >= 10 cumulative events in TAX327 by the horizon
+  horizons failing support        = WEAK_SUPPORT, reported but EXCLUDED from gating
+  activation_gate                = calibration slope in [0.8, 1.2] AND O:E in [0.9, 1.1]
+                                   at EVERY gate-eligible horizon
+                                   AND IBS beats the frozen age+ECOG-only reference
+  indeterminate_rule             = a bootstrap CI spanning a gate boundary -> INDETERMINATE
+  bootstrap                      = B 1000, seed 20260813, unit subject
+  T1                             = VENICE k through the FROZEN TAX327 empirical CDF
+  T2                             = VENICE within-cohort midranks
+  consequence_of_passing         = NOTHING is activated
+
+Nothing in this module touches serving code. It imports no API module.
+Higher risk score = worse survival everywhere.
+"""
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Dict, List, Optional, Sequence, Tuple
+
+import numpy as np
+from scipy.special import ndtri  # inverse standard normal CDF
+
+# --------------------------------------------------------------------------- #
+# Frozen constants
+# --------------------------------------------------------------------------- #
+LANDMARK_WEEKS = 15.0
+HORIZONS_WEEKS_POST_LANDMARK: Tuple[float, ...] = (26.0, 52.0, 78.0, 104.0)
+MIN_AT_RISK_DERIVATION = 20
+MIN_CUM_EVENTS_DERIVATION = 10
+CAL_SLOPE_GATE = (0.8, 1.2)
+OE_GATE = (0.9, 1.1)
+BOOTSTRAP_B = 1000
+BOOTSTRAP_SEED = 20260813
+
+# --------------------------------------------------------------------------- #
+# Midrank empirical CDF -- IDENTICAL convention to the production frozen artifact
+#   F(k) = (#{k_i < k} + #{k_i == k} / 2) / n
+# reduces to (rank - 0.5)/n for untied values, never returns 0 or 1.
+# --------------------------------------------------------------------------- #
+def midrank_cdf(reference: Sequence[float], queries: Sequence[float]) -> np.ndarray:
+    ref = np.sort(np.asarray(reference, dtype=float))
+    q = np.asarray(queries, dtype=float)
+    n = ref.size
+    if n == 0:
+        raise ValueError("empty reference")
+    lower = np.searchsorted(ref, q, side="left").astype(float)
+    equal = (np.searchsorted(ref, q, side="right") - np.searchsorted(ref, q, side="left")).astype(float)
+    return (lower + equal / 2.0) / float(n)
+
+
+def z_rank_from_cdf(p: np.ndarray, eps: float = 1e-12) -> np.ndarray:
+    return ndtri(np.clip(np.asarray(p, dtype=float), eps, 1.0 - eps))
+
+
+# --------------------------------------------------------------------------- #
+# Cox proportional hazards, Efron handling of ties, Newton-Raphson
+# --------------------------------------------------------------------------- #
+@dataclass
+class CoxFit:
+    beta: np.ndarray
+    cov: np.ndarray
+    loglik: float
+    n: int
+    n_events: int
+    iterations: int
+    converged: bool
+
+    @property
+    def se(self) -> np.ndarray:
+        return np.sqrt(np.diag(self.cov))
+
+
+def _cox_nll_grad_hess(beta, X, time, event):
+    """Negative Efron partial log-likelihood with gradient and Hessian."""
+    order = np.lexsort((-event, time))          # ascending time; events before censors at ties
+    X, time, event = X[order], time[order], event[order]
+    n, p = X.shape
+    eta = X @ beta
+    eta = eta - eta.max()                       # numerical stabilisation (cancels in ratios)
+    w = np.exp(eta)
+
+    ll = 0.0
+    grad = np.zeros(p)
+    hess = np.zeros((p, p))
+
+    # reverse cumulative sums over the risk set
+    i = 0
+    # running risk-set aggregates, built from the largest time downwards
+    rs_w = 0.0
+    rs_wx = np.zeros(p)
+    rs_wxx = np.zeros((p, p))
+    # process unique times descending so the risk set accumulates
+    uniq = np.unique(time)[::-1]
+    idx_by_time = {t: np.flatnonzero(time == t) for t in uniq}
+    for t in uniq:
+        idx = idx_by_time[t]
+        Xi, wi = X[idx], w[idx]
+        rs_w += wi.sum()
+        rs_wx += wi @ Xi
+        rs_wxx += (Xi * wi[:, None]).T @ Xi
+
+        ev = idx[event[idx] == 1]
+        d = ev.size
+        if d == 0:
+            continue
+        Xe, we = X[ev], w[ev]
+        tie_w = we.sum()
+        tie_wx = we @ Xe
+        tie_wxx = (Xe * we[:, None]).T @ Xe
+
+        ll += float(eta[ev].sum())
+        grad += Xe.sum(axis=0)
+        for l in range(d):
+            f = l / d
+            s0 = rs_w - f * tie_w
+            s1 = rs_wx - f * tie_wx
+            s2 = rs_wxx - f * tie_wxx
+            ll -= np.log(s0)
+            mu = s1 / s0
+            grad -= mu
+            hess += s2 / s0 - np.outer(mu, mu)
+    return -ll, -grad, hess
+
+
+def cox_fit(X, time, event, max_iter: int = 100, tol: float = 1e-10) -> CoxFit:
+    X = np.atleast_2d(np.asarray(X, dtype=float))
+    if X.shape[0] != len(time):
+        X = X.T
+    time = np.asarray(time, dtype=float)
+    event = np.asarray(event, dtype=int)
+    p = X.shape[1]
+    beta = np.zeros(p)
+    converged = False
+    it = 0
+    nll = np.inf
+    for it in range(1, max_iter + 1):
+        nll, g, H = _cox_nll_grad_hess(beta, X, time, event)
+        try:
+            step = np.linalg.solve(H, -g)
+        except np.linalg.LinAlgError:
+            step = np.linalg.lstsq(H, -g, rcond=None)[0]
+        # step halving on the negative log-likelihood
+        for _ in range(30):
+            cand = beta + step
+            nll_c, _, _ = _cox_nll_grad_hess(cand, X, time, event)
+            if np.isfinite(nll_c) and nll_c <= nll + 1e-12:
+                break
+            step = step / 2.0
+        beta = beta + step
+        if np.max(np.abs(step)) < tol:
+            converged = True
+            break
+    nll, g, H = _cox_nll_grad_hess(beta, X, time, event)
+    try:
+        cov = np.linalg.inv(H)
+    except np.linalg.LinAlgError:
+        cov = np.full((p, p), np.nan)
+    return CoxFit(beta=beta, cov=cov, loglik=-nll, n=X.shape[0],
+                  n_events=int(event.sum()), iterations=it, converged=converged)
+
+
+# --------------------------------------------------------------------------- #
+# Breslow baseline cumulative hazard, evaluated at the DERIVATION-set mean of X
+# --------------------------------------------------------------------------- #
+@dataclass
+class BaselineHazard:
+    times: np.ndarray            # unique event times, ascending
+    cumhaz: np.ndarray           # H0 at those times, centred on x_ref
+    x_ref: np.ndarray
+
+    def __call__(self, t) -> np.ndarray:
+        t = np.atleast_1d(np.asarray(t, dtype=float))
+        idx = np.searchsorted(self.times, t, side="right") - 1
+        out = np.where(idx >= 0, self.cumhaz[np.clip(idx, 0, None)], 0.0)
+        return out
+
+
+def breslow_baseline(X, time, event, beta, x_ref=None) -> BaselineHazard:
+    X = np.atleast_2d(np.asarray(X, dtype=float))
+    if X.shape[0] != len(time):
+        X = X.T
+    time = np.asarray(time, dtype=float)
+    event = np.asarray(event, dtype=int)
+    if x_ref is None:
+        x_ref = X.mean(axis=0)
+    x_ref = np.asarray(x_ref, dtype=float)
+    w = np.exp((X - x_ref) @ beta)
+    ev_times = np.unique(time[event == 1])
+    inc = np.empty(ev_times.size)
+    for j, t in enumerate(ev_times):
+        d = int(((time == t) & (event == 1)).sum())
+        denom = w[time >= t].sum()
+        inc[j] = d / denom
+    return BaselineHazard(times=ev_times, cumhaz=np.cumsum(inc), x_ref=x_ref)
+
+
+# --------------------------------------------------------------------------- #
+# Calibration at a fixed horizon (Crowson-style Poisson formulation)
+#   O_i ~ Poisson(mu_i),  log mu_i = a + b * lp_i + log H0(min(t_i, h))
+#   perfect calibration  <=>  a = 0 and b = 1
+# --------------------------------------------------------------------------- #
+def poisson_calibration(O, lp, logH, max_iter: int = 200, tol: float = 1e-10):
+    O = np.asarray(O, dtype=float)
+    lp = np.asarray(lp, dtype=float)
+    logH = np.asarray(logH, dtype=float)
+    keep = np.isfinite(logH)
+    O, lp, logH = O[keep], lp[keep], logH[keep]
+    if O.sum() == 0 or O.size == 0:
+        return float("nan"), float("nan")
+    Z = np.column_stack([np.ones_like(lp), lp])
+    theta = np.zeros(2)
+    for _ in range(max_iter):
+        mu = np.exp(Z @ theta + logH)
+        g = Z.T @ (O - mu)
+        H = Z.T @ (Z * mu[:, None])
+        try:
+            step = np.linalg.solve(H, g)
+        except np.linalg.LinAlgError:
+            return float("nan"), float("nan")
+        theta = theta + step
+        if np.max(np.abs(step)) < tol:
+            break
+    return float(theta[0]), float(theta[1])
+
+
+def km_survival(time, event, t):
+    """Kaplan-Meier survival evaluated at t (right-continuous)."""
+    time = np.asarray(time, dtype=float)
+    event = np.asarray(event, dtype=int)
+    uniq = np.unique(time[event == 1])
+    s = 1.0
+    for u in uniq:
+        if u > t:
+            break
+        d = int(((time == u) & (event == 1)).sum())
+        n_risk = int((time >= u).sum())
+        if n_risk > 0:
+            s *= (1.0 - d / n_risk)
+    return float(s)
