+            "pre_landmark_deaths_that_were_deaths": int(((fr.landmark_survivor == 0) & (fr.event == 1)).sum()),
+            "rule": ("pre-landmark deaths cannot have a marker value, are NOT placed on a common "
+                     "time origin with landmark survivors, and are NOT reweighted; the selection "
+                     "model denominator is landmark survivors only"),
+            "common_time_origin": "week 15",
+        },
+        "flow": {
+            "enrolled": 936,
+            "randomized_with_os_followup": int(len(fr)),
+            "pre_landmark_deaths_or_censoring": int((fr.landmark_survivor == 0).sum()),
+            "landmark_survivors": int(fr.landmark_survivor.sum()),
+            "landmark_survivors_with_computable_k": int(
+                fr[(fr.landmark_survivor == 1)].in_analysis_set.sum()),
+            "final_analysis_set": int(fr.final_analysis_set.sum()),
+            "excluded_landmark_survivors": int(
+                (fr[(fr.landmark_survivor == 1)].final_analysis_set == 0).sum()),
+            "selection_fraction_among_landmark_survivors": float(
+                fr.final_analysis_set.sum() / fr.landmark_survivor.sum()),
+        },
+        "eligibility_model": {
+            "form": "logistic regression, main effects only, baseline covariates only",
+            "covariates": names,
+            "post_baseline_variables_used": [],
+            "marker_k_used_as_predictor": False,
+            "imputation": "median imputation with an added missingness indicator per covariate",
+            "labs_dropped_for_coverage": ["LDH (2/612 subjects, 0.33%)"],
+            "coefficients_intercept_first": beta_ps.tolist(),
+        },
+        "covariate_missingness_among_landmark_survivors": imputed,
+        "design_diagnostics": {
+            "primary": {k: v for k, v in dmeta.items() if k != "imputed_counts"},
+            "full_indicator_variant": {k: v for k, v in dmeta_all.items() if k != "imputed_counts"},
+            "treatment_arm_note": ("all 612 randomized VENICE subjects carry ARMCD=PLACEBO, i.e. the "
+                                   "docetaxel+prednisone control arm of the aflibercept trial; the arm "
+                                   "column is therefore constant and is dropped as non-estimable"),
+        },
+        "propensity_distribution": ps_dist,
+        "positivity": positivity,
+        "separation_diagnostic": separation_diagnostic,
+        "weights": weights,
+        "balance": {
+            "target_of_stabilized_ipsw": "the full landmark-survivor population (n=590)",
+            "descriptive_selected_vs_excluded": {
