+    wtd = d12.weighted_cox_fit(Xc, tt, ee, sw_t)
+    wtd_untrunc = d12.weighted_cox_fit(Xc, tt, ee, sw)
+
+    # Firth-propensity sensitivity: identical pipeline, weights from the penalized model
+    sw_f = (marg / ps_firth)[sel == 1]
+    f_lo, f_hi = np.percentile(sw_f, d12.WEIGHT_TRUNCATION_PERCENTILES)
+    wtd_firth = d12.weighted_cox_fit(Xc, tt, ee, np.clip(sw_f, f_lo, f_hi))
+
+    cox = {
+        "terms": ["z_rank", "age_ge65", "ecog"],
+        "n": int(len(an)), "events": int(ee.sum()),
+        "unweighted": {"beta": unw["beta"].tolist(),
+                       "model_se": np.sqrt(np.diag(unw["cov"])).tolist(),
+                       "loglik": unw["loglik"], "converged": unw["converged"]},
+        "weighted_truncated": {"beta": wtd["beta"].tolist(),
+                               "loglik": wtd["loglik"], "converged": wtd["converged"],
+                               "model_se_not_valid_under_weighting": True},
+        "weighted_untruncated": {"beta": wtd_untrunc["beta"].tolist(),
+                                 "converged": wtd_untrunc["converged"]},
+        "weighted_firth_propensity_sensitivity": {"beta": wtd_firth["beta"].tolist(),
+                                                  "converged": wtd_firth["converged"]},
+        "delta_beta_z_weighted_minus_unweighted": float(wtd["beta"][0] - unw["beta"][0]),
+        "locked_beta_z": LOCKED_BETA_Z,
+        "unweighted_reproduces_locked_beta_abs_diff": float(abs(unw["beta"][0] - LOCKED_BETA_Z)),
+    }
+
+    # ---------------- bootstrap: refit everything inside each replicate ---------
+    rng = np.random.default_rng(seed)
+    n_ls = len(ls)
+    keep = {"beta_z_unw": [], "beta_z_wtd": [], "delta": [],
+            "beta_age_wtd": [], "beta_ecog_wtd": [], "max_sw": []}
+    failed = 0
+    for _ in range(b):
+        idx = rng.integers(0, n_ls, n_ls)
+        bs = ls.iloc[idx].reset_index(drop=True)
+        if bs["final_analysis_set"].sum() < 40 or (bs["final_analysis_set"] == 0).sum() < 20:
+            failed += 1
+            continue
+        try:
+            Xb, _, _ = d12.design_matrix(bs, labs_used)
+            sb = bs["final_analysis_set"].values.astype(int)
+            bb, _ = d12.logistic_fit(Xb, sb)
+            pb = np.clip(d12.logistic_predict(bb, Xb), 1e-6, 1 - 1e-6)
+            mb = float(sb.mean())
+            swb = (mb / pb)[sb == 1]
+            lo, hi = np.percentile(swb, d12.WEIGHT_TRUNCATION_PERCENTILES)
+            swb_t = np.clip(swb, lo, hi)
+
+            ab = bs[bs.final_analysis_set == 1].reset_index(drop=True)
+            kb = ab["k"].values.astype(float)
+            if ab["event"].sum() < 20 or len(np.unique(kb)) < 5:
+                failed += 1
+                continue
+            zb = tp.z_rank_from_cdf(tp.midrank_cdf(kb, kb))
+            Xcb = np.column_stack([zb, ab["age_ge65"].values.astype(float),
+                                   ab["ecog"].values.astype(float)])
+            tb = ab["os_weeks"].values.astype(float) - d12.LANDMARK_WEEKS
+            eb = ab["event"].values.astype(int)
+            u = d12.weighted_cox_fit(Xcb, tb, eb, np.ones(len(ab)))
+            v = d12.weighted_cox_fit(Xcb, tb, eb, swb_t)
+            if not (u["converged"] and v["converged"]):
+                failed += 1
+                continue
+            keep["beta_z_unw"].append(u["beta"][0])
+            keep["beta_z_wtd"].append(v["beta"][0])
+            keep["delta"].append(v["beta"][0] - u["beta"][0])
+            keep["beta_age_wtd"].append(v["beta"][1])
+            keep["beta_ecog_wtd"].append(v["beta"][2])
+            keep["max_sw"].append(float(swb_t.max()))
+        except Exception:
+            failed += 1
+
+    def ci(vals):
+        a = np.asarray(vals, float)
+        if a.size < 20:
+            return {"n": int(a.size), "lo": None, "hi": None, "sd": None}
+        return {"n": int(a.size), "lo": float(np.percentile(a, 2.5)),
+                "hi": float(np.percentile(a, 97.5)), "sd": float(a.std(ddof=1)),
+                "median": float(np.median(a))}
+
+    boot = {"B_requested": b, "seed": seed, "n_failed": failed,
+            **{k: ci(v) for k, v in keep.items()}}
+    d = np.asarray(keep["delta"], float)
+    boot["delta_ci_excludes_zero"] = bool(d.size >= 50 and (np.percentile(d, 2.5) > 0 or np.percentile(d, 97.5) < 0))
+
+    return {
+        "document": "Zeta-Core v4 D12 selection-bias analysis (VENICE)",
+        "estimand": ("association of the continuous PSA prognostic index with OS among "
+                     "randomized VENICE subjects who SURVIVED BEYOND week 15, reweighted to "
+                     "the full landmark-survivor population"),
+        "landmark_handling": {
+            "landmark_weeks": d12.LANDMARK_WEEKS,
