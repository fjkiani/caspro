+import hashlib, json
+from pathlib import Path
+import pytest
+
+from scripts.validation.verify_zeta_core_delivery import SCHEMA, create, verify
+
+
+def w(p: Path, text="x"):
+    p.parent.mkdir(parents=True, exist_ok=True); p.write_text(text); return p
+
+
+def row(base, rel, kind="file"):
+    p=base/rel; b=p.read_bytes()
+    return {"path": rel, "kind": kind, "bytes": len(b), "sha256": hashlib.sha256(b).hexdigest()}
+
+
+def test_create_and_verify_complete_tree(tmp_path):
+    w(tmp_path/"a.txt"); w(tmp_path/"sub/b.json", "{}")
+    r=create(tmp_path,tmp_path/"DELIVERY_MANIFEST.v2.json")
+    assert r["verdict"]=="PASS" and r["covered_files"]==2
+
+@pytest.mark.parametrize("mutation,field", [
+    ("missing","missing"),("extra","extra"),("mismatch","digest_mismatches")])
+def test_fails_closed_on_tree_drift(tmp_path, mutation, field):
+    w(tmp_path/"a.txt"); m=tmp_path/"DELIVERY_MANIFEST.v2.json"; create(tmp_path,m)
+    if mutation=="missing": (tmp_path/"a.txt").unlink()
+    elif mutation=="extra": w(tmp_path/"extra.txt")
+    else: w(tmp_path/"a.txt","changed")
+    r=verify(tmp_path,m); assert r["verdict"]=="FAIL" and r[field]
+
+
+def test_rejects_path_traversal_and_duplicate(tmp_path):
+    w(tmp_path/"a.txt"); m=tmp_path/"DELIVERY_MANIFEST.v2.json"
+    x=row(tmp_path,"a.txt")
+    m.write_text(json.dumps({"schema":SCHEMA,"members":[x,x,{"path":"../escape","kind":"file","bytes":0,"sha256":"0"*64}]}))
+    r=verify(tmp_path,m)
+    assert r["verdict"]=="FAIL" and r["duplicate_entries"] and r["unsafe_paths"]
+
+
+def test_detects_recursive_manifest_cycle(tmp_path):
+    a=tmp_path/"a.json"; b=tmp_path/"b.json"
+    # Fixed digests cannot be mutually self-consistent; cycle detection is independent of digest mismatch.
+    a.write_text(json.dumps({"schema":SCHEMA,"members":[{"path":"b.json","kind":"manifest","bytes":0,"sha256":"0"*64}]}))
+    b.write_text(json.dumps({"schema":SCHEMA,"members":[{"path":"a.json","kind":"manifest","bytes":a.stat().st_size,"sha256":hashlib.sha256(a.read_bytes()).hexdigest()}]}))
+    d=json.loads(a.read_text()); d["members"][0].update(bytes=b.stat().st_size,sha256=hashlib.sha256(b.read_bytes()).hexdigest()); a.write_text(json.dumps(d))
+    r=verify(tmp_path,a)
+    assert r["verdict"]=="FAIL" and r["cyclic_manifest_references"]
