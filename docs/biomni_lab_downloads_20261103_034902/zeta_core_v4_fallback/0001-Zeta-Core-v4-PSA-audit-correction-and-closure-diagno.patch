+++ b/tests/unit/test_contract_a_release.py
@@ -0,0 +1,331 @@
+"""Directive items 2 and 3 — the release contract, and the n = 3 rule.
+
+ITEM 2: THE k_day / CDF CONTRADICTION
+────────────────────────────────────
+The previous release refused ``reference_percentile`` while releasing ``k_day``,
+and shipped the reference CDF as a committed, checksummed artifact whose SHA-256
+is published in the response. Those three facts cannot all be true of a
+meaningful withholding: percentile = CDF(k_day), the consumer holds the CDF, and
+the consumer holds k_day. The "withheld" percentile was one function evaluation
+away.
+
+CONTRACT A is adopted (prespecification v2 addendum, SHA-256 a24fb4e4...):
+
+* ``k_day`` is released on every path where it is computable;
+* ``reference_percentile`` is released when the decline sign is stable;
+* ``percentile_uncertainty_interval`` is released when it is estimable;
+* the categorical band stays NULL — its prespecified stability gate failed;
+* absolute survival probability and treatment fields stay NULL — neither
+  capability exists in this release.
+
+CONTRACT B (withhold k_day so the percentile is genuinely unreconstructable) was
+rejected: it would suppress the one quantity that is directly measured from the
+patient's own series in order to protect a quantity that is a deterministic
+function of it, and the measured rate is the thing a researcher actually needs.
+
+The reclassification of the week-15 landmark from refusal to annotation is a
+REVERSAL of part of the preceding D8 work, and is asserted as such here rather
+than quietly re-baselined.
+
+ITEM 3: EXACTLY THREE DISTINCT OBSERVATIONS
+───────────────────────────────────────────
+The prespecified resampling estimator needs four distinct analysis days, so at
+three the bootstrap sign-stability statistic is undefined — it cannot be computed
+at all, let alone pass. Refusing every such patient was rejected as a post-hoc
+filter: three-day patients ARE members of the frozen n = 446 reference
+population, which was never filtered that way.
+
+What is prespecified instead:
+
+* ``fit_precision_status = "INSUFFICIENT_FOR_UNCERTAINTY"``, never ``RELIABLE``;
+* the RUO point estimate IS released, and carries four mandatory disclosures;
+* no categorical band, no patient-level interval;
+* if the decline sign cannot be established INDEPENDENTLY of the point fit by the
+  deterministic ``LOO_SIGN_ESTABLISHMENT`` rule, the request fails closed with
+  ``DECLINE_SIGN_NOT_INDEPENDENTLY_ESTABLISHED``.
+
+The rule was frozen before it was evaluated on VENICE.
+"""
+from __future__ import annotations
+
+import asyncio
+
+import pytest
+
+from api.routers.ayesha_therapy_fit import (
+    MarkerKineticsFitRequest,
+    MarkerObservationIn,
+    tumor_marker_kinetics_fit,
+)
+from api.services.tumor_marker_kinetics.models import (
+    FAIL_CLOSED_KEYS,
+    LANDMARK_SCOPE_RECLASSIFICATION_IS_A_REVERSAL,
+    LOO_SIGN_ESTABLISHMENT_RULE_NAME,
+    RELEASE_CONTRACT_DECISION,
+    RELEASE_CONTRACT_REJECTED_ALTERNATIVE,
+    THREE_OBSERVATION_DISCLOSURES,
+    THREE_OBSERVATION_TRIGGER_DISTINCT_DAYS,
+    FitPrecisionStatus,
+)
+
+# ── Series ────────────────────────────────────────────────────────────────────
+CLEAN5 = [(0.0, 100.0), (14.0, 82.0), (28.0, 66.0), (42.0, 54.0), (56.0, 44.0)]
+#: Three distinct days, monotone decline. Every leave-one-out pair declines.
+THREE_OK = [(0.0, 100.0), (28.0, 66.0), (56.0, 44.0)]
+#: Three distinct days, non-monotone, middle day exactly at the mean of x.
+THREE_BAD_CENTRED = [(0.0, 100.0), (28.0, 130.0), (56.0, 44.0)]
+#: Three distinct days, non-monotone, middle day NOT at the mean of x.
+THREE_BAD_OFFCENTRE = [(0.0, 100.0), (14.0, 130.0), (56.0, 44.0)]
+
+# ── Values re-derived through the real route handler ──────────────────────────
+CLEAN5_K_DAY = 0.014712116463140289
+CLEAN5_PERCENTILE = 0.542625166369364
+CLEAN5_PERCENTILE_INTERVAL = [0.5300479860199122, 0.5472952557233455]
+THREE_OK_K_DAY = 0.014660367001246979
+THREE_OK_PERCENTILE = 0.5420939099919843
+THREE_BAD_CENTRED_K_DAY = 0.014660367001246977
+
+
+def _request(series, **overrides):
+    kwargs = dict(
+        axis_id="PROSTATE_PSA_KINETICS",
+        marker_id="PSA",
+        canonical_unit="NG/ML",
+        unit_factors_to_canonical={"NG/ML": 1.0, "UG/L": 1.0},
+        early_window_start_day=0.0,
+        early_window_end_day=105.0,
+        positive_floor=0.01,
+        time_kind="day",
+        observations=[
+            MarkerObservationIn(time=t, value=v, unit="ng/mL", analyte="PSA")
+            for t, v in series
+        ],
+    )
+    kwargs.update(overrides)
+    return MarkerKineticsFitRequest(**kwargs)
+
+
+def _payload(series, **overrides):
+    return asyncio.run(tumor_marker_kinetics_fit(_request(series, **overrides)))
+
+
+# ══════════════════════════════════════════════════════════════════════════════
+# ITEM 2 — the contract is named on the wire and is internally coherent
+# ══════════════════════════════════════════════════════════════════════════════
+def test_the_chosen_contract_is_named_and_the_alternative_is_recorded():
+    assert RELEASE_CONTRACT_DECISION == "CONTRACT_A_RUO_SCIENTIFIC_WITHHOLDING"
+    assert RELEASE_CONTRACT_REJECTED_ALTERNATIVE == "CONTRACT_B_STRICT_INDEX_WITHHOLDING"
+    assert RELEASE_CONTRACT_DECISION != RELEASE_CONTRACT_REJECTED_ALTERNATIVE
+    block = _payload(CLEAN5)["relative_prognostic_index"]
+    assert block["release_contract"] == RELEASE_CONTRACT_DECISION
+
+
+def test_the_landmark_reclassification_is_recorded_as_a_reversal():
+    """A reversal must be declared, not re-baselined.
+
+    Part of the preceding D8 work is being undone here. The flag exists so the
+    delivery receipt can state that, rather than presenting Contract A as if it
+    had always been the design.
+    """
+    assert LANDMARK_SCOPE_RECLASSIFICATION_IS_A_REVERSAL is True
+
+
+@pytest.mark.parametrize(
+    "landmark",
+    [
+        {},
+        {"landmark_confirmed": True, "survived_through_landmark_day": 140.0},
+        {"landmark_confirmed": False, "survived_through_landmark_day": 140.0},
+    ],
+)
+def test_the_continuous_index_is_released_regardless_of_landmark_scope(landmark):
+    """The percentile no longer depends on an attestation the service cannot check."""
+    block = _payload(CLEAN5, **landmark)["relative_prognostic_index"]
+    assert block["eligible"] is True
+    assert block["k_day"] == pytest.approx(CLEAN5_K_DAY, rel=1e-12)
+    assert block["reference_percentile"] == pytest.approx(CLEAN5_PERCENTILE, rel=1e-12)
+    assert block["percentile_uncertainty_interval"] == pytest.approx(
+        CLEAN5_PERCENTILE_INTERVAL, rel=1e-12
+    )
+    assert block["fit_precision_status"] == FitPrecisionStatus.RELIABLE.value
+
+
+def test_the_released_percentile_is_exactly_the_committed_cdf_of_the_released_rate():
+    """The coherence check that motivated the whole contract change.
+
+    If this identity holds — and it must, because it is the definition — then
+    withholding the percentile while releasing the rate and the CDF withholds
+    nothing. The test exists so nobody can reintroduce the redaction and describe
+    it as protective.
+    """
+    from api.services.tumor_marker_kinetics import reference_cdf as rc
+
+    block = _payload(CLEAN5)["relative_prognostic_index"]
+    cdf = rc.load_reference_cdf()
+    recomputed = cdf.percentile(block["k_day"])
+    assert recomputed == pytest.approx(block["reference_percentile"], rel=1e-12)
+    # And the artifact a consumer would need is itself published in the response.
+    assert block["reference_artifact_sha256"]
+    assert block["reference_artifact_version"]
+
+
+def test_the_band_and_the_unavailable_capabilities_are_not_reactivated():
+    """Contract A releases MORE of the continuous index and nothing else.
+
+    The band is suppressed for a different reason than the percentile ever was —
+    its cohort-wide stability gate failed at 0.6662 against a required 0.90 — so
+    relaxing the percentile rule must not touch it.
+    """
+    payload = _payload(CLEAN5)
+    block = payload["relative_prognostic_index"]
+    assert block["relative_prognostic_band"] is None
+    assert block["band_gate_pass"] is False
+    assert block["band_gate_observed"] == 0.6662
+    assert block["band_gate_required"] == 0.90
+    for key in FAIL_CLOSED_KEYS:
+        assert payload[key] is None, key
+    assert payload["ruo"] is True
+
+
+def test_the_percentile_is_withheld_when_the_sign_is_not_stable():
+    """The release gate is the fit SIGN, not the landmark.
+
+    Contract A is a narrowing of the refusal, not an abolition of it: when the
+    resampled decline sign is unstable the patient may not be a decliner at all,
+    so the index is undefined for them and nothing derived from the CDF is served.
+    """
+    noisy = [(0.0, 100.0), (14.0, 140.0), (28.0, 62.0), (42.0, 150.0), (56.0, 48.0)]
+    block = _payload(noisy)["relative_prognostic_index"]
+    assert block["eligible"] is False
+    assert block["ineligible_reason"] == "UNSTABLE_DECLINE_SIGN"
+    assert block["reference_percentile"] is None
+    assert block["percentile_uncertainty_interval"] is None
+    # k_day is still released: Contract A withholds the index, never the rate.
+    assert block["k_day"] is not None
+
+
+# ══════════════════════════════════════════════════════════════════════════════
+# ITEM 3 — exactly three distinct observations
+# ══════════════════════════════════════════════════════════════════════════════
+def test_the_three_observation_trigger_is_exactly_three_distinct_days():
+    assert THREE_OBSERVATION_TRIGGER_DISTINCT_DAYS == 3
+
+
+def test_three_observations_are_insufficient_for_uncertainty_and_never_reliable():
+    payload = _payload(THREE_OK)
+    block = payload["relative_prognostic_index"]
+    receipt = payload["fit_precision_receipt"]
+    assert receipt["n_distinct_days"] == 3
+    assert (
+        block["fit_precision_status"]
+        == FitPrecisionStatus.INSUFFICIENT_FOR_UNCERTAINTY.value
+    )
+    assert block["fit_precision_status"] != FitPrecisionStatus.RELIABLE.value
+    # The bootstrap statistic is UNDEFINED at n = 3, not merely unimpressive.
+    # A number here would imply it had been computed.
+    assert receipt["decline_sign_stability"] is None
+
+
+def test_the_three_observation_point_estimate_is_released_with_all_four_disclosures():
+    block = _payload(THREE_OK)["relative_prognostic_index"]
+    assert block["eligible"] is True
+    assert block["k_day"] == pytest.approx(THREE_OK_K_DAY, rel=1e-12)
+    assert block["reference_percentile"] == pytest.approx(THREE_OK_PERCENTILE, rel=1e-12)
+
+    disclosures = block["three_observation_disclosure"]
+    assert disclosures is not None
+    assert len(disclosures) == 4
+    assert tuple(disclosures) == THREE_OBSERVATION_DISCLOSURES
+    joined = " ".join(disclosures).lower()
+    assert "uncertainty is unavailable" in joined
+    assert "no categorical band" in joined
+    assert "no patient-level interval" in joined
+    assert "not suitable for individual decision-making" in joined
+
+
+def test_no_interval_and_no_band_accompany_a_three_observation_estimate():
+    block = _payload(THREE_OK)["relative_prognostic_index"]
+    for interval in (
+        "k_day_uncertainty_interval",
+        "percentile_uncertainty_interval",
+        "multiplier_uncertainty_interval",
+    ):
+        assert block[interval] is None, interval
+    assert block["relative_prognostic_band"] is None
+    # The coefficient-only interval IS still served: it propagates Cox coefficient
+    # uncertainty, which does not depend on this patient's number of visits.
+    assert block["coefficient_conditional_relative_hazard_interval"] is not None
+
+
+def test_the_disclosures_are_absent_when_the_series_has_more_than_three_days():
+    """The n = 3 caveats must not become boilerplate on every response."""
+    block = _payload(CLEAN5)["relative_prognostic_index"]
+    assert block["three_observation_disclosure"] is None
+
+
+@pytest.mark.parametrize(
+    "series,note",
+    [(THREE_BAD_CENTRED, "middle day at the mean of x"), (THREE_BAD_OFFCENTRE, "off-centre")],
+)
+def test_three_observations_fail_closed_when_the_sign_is_not_independently_established(
+    series, note
+):
+    payload = _payload(series)
+    block = payload["relative_prognostic_index"]
+    receipt = payload["fit_precision_receipt"]
+    assert block["eligible"] is False, note
+    assert block["ineligible_reason"] == "DECLINE_SIGN_NOT_INDEPENDENTLY_ESTABLISHED", note
+    assert receipt["loo_sign_established"] is False, note
+    assert receipt["loo_sign_rule"] == LOO_SIGN_ESTABLISHMENT_RULE_NAME, note
+    assert receipt["loo_negative_slope_count"] == 2, note
+    assert receipt["n_distinct_days"] == 3, note
+    assert block["reference_percentile"] is None, note
+    assert block["three_observation_disclosure"] is None, note
+    # The rate is still on the wire; only the index is withheld.
+    assert block["k_day"] is not None, note
+
+
+def test_the_loo_rule_requires_all_three_leave_one_out_slopes_to_decline():
+    payload = _payload(THREE_OK)
+    receipt = payload["fit_precision_receipt"]
+    assert receipt["loo_sign_established"] is True
+    assert receipt["loo_negative_slope_count"] == 3
+    assert receipt["loo_sign_rule"] == LOO_SIGN_ESTABLISHMENT_RULE_NAME
+
+
+def test_the_loo_verdict_is_none_rather_than_false_when_the_rule_does_not_apply():
+    """"Not established" must never be readable as "tested and failed".
+
+    At five distinct days the bootstrap arbitrates and the LOO rule is not
+    evaluated. Reporting ``False`` there would assert a negative result that was
+    never computed.
+    """
+    receipt = _payload(CLEAN5)["fit_precision_receipt"]
+    assert receipt["n_distinct_days"] == 5
+    assert receipt["loo_sign_established"] is None
+    assert receipt["loo_negative_slope_count"] is None
+
+
+def test_the_point_fit_alone_cannot_detect_the_centred_non_monotone_series():
+    """WHY the deterministic LOO rule is necessary, stated as a number.
+
+    ``THREE_BAD_CENTRED`` rises from 100 to 130 before falling to 44. Its middle
+    observation sits exactly at the mean of the time axis, so it has zero leverage
+    on an ordinary least-squares slope: the point fit returns essentially the same
+    ``k_day`` as the cleanly monotone series, agreeing to ~1e-18.
+
+    A point estimate therefore cannot distinguish these two patients at all, and
+    the bootstrap cannot arbitrate at three days. Without an independent sign
+    check, a non-declining patient would have received a released percentile
+    indistinguishable from a declining one.
+    """
+    ok = _payload(THREE_OK)["relative_prognostic_index"]["k_day"]
+    bad = _payload(THREE_BAD_CENTRED)["relative_prognostic_index"]["k_day"]
+    assert ok == pytest.approx(THREE_OK_K_DAY, rel=1e-12)
+    assert bad == pytest.approx(THREE_BAD_CENTRED_K_DAY, rel=1e-12)
+    assert abs(ok - bad) < 1e-15
+    # Both rates are positive and look like a decline. Only one series is one.
+    assert ok > 0 and bad > 0
+    # The LOO rule separates them; the point estimate does not.
+    assert _payload(THREE_OK)["relative_prognostic_index"]["eligible"] is True
+    assert _payload(THREE_BAD_CENTRED)["relative_prognostic_index"]["eligible"] is False
